{%- comment -%} Featured plugin — Muybridge film-strip feature. 1:1 port of homepage-build .rng. {%- endcomment -%}
{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign title = section.settings.title | default: '24 clicks in Photoshop.'
  assign title_accent = section.settings.title_accent | default: 'Made into one.'
  assign cta_text = section.settings.cta_text | default: 'Get Pixel Perfect — $25'
  assign strip = section.settings.strip_image
-%}
<section class="rng color-{{ cs }}">
  <div class="rng__in">
    <h2 class="rng__title">{{ title }}{% if title_accent != blank %}<br><em>{{ title_accent }}</em>{% endif %}</h2>
    <div class="rng__frame">
      {%- if strip != blank -%}
        <img class="rng__strip" src="{{ strip | image_url: width: 2400 }}" alt="{{ title | escape }}" loading="lazy">
      {%- else -%}
        <img class="rng__strip" src="{{ 'ds-muybridge-strip.webp' | asset_url }}" alt="{{ title | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    {%- if cta_text != blank -%}
      <a class="rng__cta" href="{{ section.settings.cta_link }}">{{ cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% style %}
  .rng { position:relative;overflow:hidden;background:linear-gradient(180deg,#0C0708,#160a0d 55%,#0C0708);border-top:1px solid var(--color-border);padding:42px clamp(16px,4vw,30px) 44px;text-align:center; }
  .rng::before { content:"";position:absolute;inset:0;background:radial-gradient(120% 72% at 50% 0,rgba(193,18,31,.14),transparent 62%);pointer-events:none; }
  .rng__in { position:relative;max-width:900px;margin:0 auto; }
  .rng__title { font-family:var(--font-sans);font-weight:800;letter-spacing:-.02em;line-height:1.02;color:var(--color-fg);font-size:29px;margin:0; }
  .rng__title em { font-style:normal;color:var(--color-accent); }
  .rng__frame { margin:22px 0 0;border:1px solid var(--color-border);border-radius:5px;overflow:hidden;background:#0e090b;display:flex;justify-content:center;line-height:0;box-shadow:0 14px 34px rgba(0,0,0,.35); }
  .rng__strip { height:84px;width:auto;max-width:none;display:block; }
  .rng__cta { display:inline-flex;align-items:center;margin-top:22px;background:var(--color-accent);color:var(--color-accent-fg);font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:11px 15px;cursor:pointer;transition:filter .18s;text-decoration:none; }
  .rng__cta::before { content:"[";font-size:1.5em;line-height:0;margin-right:8px;font-weight:400; }
  .rng__cta::after { content:"]";font-size:1.5em;line-height:0;margin-left:8px;font-weight:400; }
  .rng__cta:hover { filter:brightness(1.13); }
  @media (min-width:720px){
    .rng { padding:60px 30px 62px; }
    .rng__title { font-size:50px; }
    .rng__strip { height:118px; }
    .rng__cta { font-size:12px;padding:13px 18px;margin-top:26px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Film-strip feature",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title line 1", "default": "24 clicks in Photoshop." },
    { "type": "text", "id": "title_accent", "label": "Title line 2 (accent)", "default": "Made into one." },
    { "type": "image_picker", "id": "strip_image", "label": "Film strip image", "info": "Wide strip image. Defaults to the built-in Muybridge pixel reel." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Get Pixel Perfect — $25" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Film-strip feature" }]
}
{% endschema %}
