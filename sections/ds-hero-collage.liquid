{%- comment -%} Disrupted Studio — collage hero (sliding product wall). 1:1 port of homepage-build .hero, prefixed .dsh to avoid colliding with stock sections/hero.liquid. {%- endcomment -%}
{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign heading = section.settings.heading | default: 'Designed to darken your work.'
  assign cta_text = section.settings.cta_text | default: '+ Shop everything'
  assign cta_link = section.settings.cta_link
  if cta_link == blank
    assign cta_link = routes.all_products_collection_url
  endif
  assign wall = section.settings.collection
  if wall == blank
    assign wall = collections.all
  endif
-%}

{%- capture tiles_fwd -%}
  {%- for product in wall.products limit: 14 -%}
    {%- if product.featured_image -%}
      <span class="dsh__tile" style="background-image:url({{ product.featured_image | image_url: width: 400 }})"></span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign wall_rev = wall.products | reverse -%}
{%- capture tiles_rev -%}
  {%- for product in wall_rev limit: 14 -%}
    {%- if product.featured_image -%}
      <span class="dsh__tile" style="background-image:url({{ product.featured_image | image_url: width: 400 }})"></span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="dsh color-{{ cs }}">
  <div class="dsh__wall" aria-hidden="true">
    <div class="dsh__row dsh__row--l"><div class="dsh__track" style="--d:42s">{{ tiles_fwd }}{{ tiles_fwd }}</div></div>
    <div class="dsh__row dsh__row--r"><div class="dsh__track" style="--d:56s">{{ tiles_rev }}{{ tiles_rev }}</div></div>
    <div class="dsh__row dsh__row--l"><div class="dsh__track" style="--d:48s;animation-delay:-24s">{{ tiles_fwd }}{{ tiles_fwd }}</div></div>
  </div>
  <div class="dsh__scrim"></div>
  <div class="dsh__content">
    <h1 class="dsh__h">{{ heading }}</h1>
    {%- if cta_text != blank -%}
      <a class="dsh__cta" href="{{ cta_link }}">{{ cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} { --t:132px; }
  .dsh { position:relative;overflow:hidden;background:var(--color-bg); }
  .dsh__wall { display:flex;flex-direction:column;gap:2px; }
  .dsh__row { overflow:hidden; }
  .dsh__track { display:flex;gap:2px;width:max-content;will-change:transform; }
  .dsh__row--l .dsh__track { animation:dshSlideL var(--d,44s) linear infinite; }
  .dsh__row--r .dsh__track { animation:dshSlideR var(--d,44s) linear infinite; }
  .dsh__tile { width:var(--t);height:var(--t);flex:none;background-size:cover;background-position:center;background-repeat:no-repeat;background-color:var(--color-bg-elev); }
  .dsh__scrim { position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.5) 0%,rgba(0,0,0,.62) 45%,rgba(0,0,0,.78) 100%); }
  .dsh__content { position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px 22px;gap:14px; }
  .dsh__h { font-weight:800;font-size:clamp(40px,11.5vw,82px);line-height:.95;letter-spacing:-.03em;color:var(--color-fg);max-width:15ch;margin:0;text-wrap:balance; }
  .dsh__cta { display:inline-flex;align-items:center;align-self:center;width:auto;background:var(--color-accent);color:var(--color-accent-fg);border-radius:0;font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:9px;cursor:pointer;transition:filter .18s;text-decoration:none; }
  .dsh__cta::before { content:"[";font-size:1.8em;line-height:0;margin-right:9px;font-weight:400; }
  .dsh__cta::after { content:"]";font-size:1.8em;line-height:0;margin-left:9px;font-weight:400; }
  .dsh__cta:hover { filter:brightness(1.09); }
  @keyframes dshSlideL { from{transform:translateX(0);} to{transform:translateX(-50%);} }
  @keyframes dshSlideR { from{transform:translateX(-50%);} to{transform:translateX(0);} }
  @media (min-width:720px){
    #shopify-section-{{ section.id }} { --t:200px; }
    .dsh__content { gap:48px; }
    .dsh__cta { font-size:15px;padding:13px; }
  }
  @media (prefers-reduced-motion:reduce){
    .dsh__track { animation:none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collage hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to darken your work." },
    { "type": "collection", "id": "collection", "label": "Product wall collection", "info": "Products whose images fill the sliding wall. Defaults to all products." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "+ Shop everything" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Collage hero" }]
}
{% endschema %}
