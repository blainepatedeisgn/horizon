{%- comment -%}
  sections/ds-newsletter-popup.liquid — Two-step Yes/No popup (v3)

  Why two-step:
    Single-step popups (email field immediately) convert ~3-5% on
    average; two-step Yes/No popups convert 8-12%+ (Mott & Bow case
    study: 100K subs in 6 months at 10%+). The mechanism: clicking
    "YES, SEND IT" creates a tiny commitment ("foot in the door").
    When the email field then appears, abandoning feels like
    reversing your own choice. Compound that with first-person CTA
    copy ("Send me the font" beats "Subscribe" by ~90% CTR in
    Unbounce tests) and a dollar-value anchor (Obscura Gothic is
    framed as "normally $39") and the popup punches well above
    a generic newsletter signup.

  Three steps inside the dialog:
    1. ask     — Yes/No question with value anchor (no email field yet)
    2. form    — email capture, revealed only after Yes
    3. success — download button + confirmation copy

  Submission paths (parallel, both fire on form submit):
    - Shopify customer form via hidden iframe → creates the customer
      record with tags (popup-signup) for segmentation
    - Klaviyo client subscription API → instant welcome-email trigger
      (skips the 5-15 min Shopify→Klaviyo sync delay). Optional —
      only fires when klaviyo_company_id + klaviyo_list_id are set.

  Localstorage gate:
    ds_newsletter_signedup   — set on success; never show again
    ds_newsletter_dismissed  — set on close / No-thanks; cooldown_days

  Append ?ds-popup=1 to any URL to force-open for testing.
{%- endcomment -%}

{%- liquid
  unless section.settings.enabled
    echo ''
    break
  endunless

  assign freebie_url = section.settings.freebie_url
  assign cooldown_days = section.settings.cooldown_days | default: 30
  assign mobile_delay = section.settings.mobile_delay_seconds | default: 20
  assign desktop_fallback = section.settings.desktop_fallback_seconds | default: 45
  assign signup_tags = section.settings.signup_tags | default: 'newsletter, popup-signup'
  assign klaviyo_company_id = section.settings.klaviyo_company_id
  assign klaviyo_list_id = section.settings.klaviyo_list_id
-%}

<dialog
  class="ds-newsletter-popup"
  id="ds-newsletter-popup"
  aria-labelledby="ds-newsletter-popup-title"
  data-cooldown-days="{{ cooldown_days }}"
  data-mobile-delay="{{ mobile_delay }}"
  data-desktop-fallback="{{ desktop_fallback }}"
  data-klaviyo-company-id="{{ klaviyo_company_id | escape }}"
  data-klaviyo-list-id="{{ klaviyo_list_id | escape }}"
>
  <div class="ds-newsletter-popup__panel">
    <button
      type="button"
      class="ds-newsletter-popup__close"
      data-action="close"
      aria-label="Close"
    >×</button>

    {%- comment -%} ============= STEP 1: ASK (Yes/No, no email field) ============= {%- endcomment -%}
    <div class="ds-newsletter-popup__step" data-step="ask">
      {%- if section.settings.ask_eyebrow != blank -%}
        <p class="ds-newsletter-popup__eyebrow">{{ section.settings.ask_eyebrow }}</p>
      {%- endif -%}

      <h2 class="ds-newsletter-popup__title" id="ds-newsletter-popup-title">
        {{- section.settings.ask_title | default: 'Want Obscura Gothic, free?' -}}
      </h2>

      {%- if section.settings.ask_subhead != blank -%}
        <p class="ds-newsletter-popup__subhead">{{ section.settings.ask_subhead }}</p>
      {%- endif -%}

      <button
        type="button"
        class="ds-newsletter-popup__yes"
        data-action="advance"
      >
        {{- section.settings.ask_yes_label | default: 'Yes, send it' -}}
        <span aria-hidden="true">&rarr;</span>
      </button>

      <button
        type="button"
        class="ds-newsletter-popup__no"
        data-action="close"
      >
        {{- section.settings.ask_no_label | default: 'No thanks, I have enough fonts' -}}
      </button>
    </div>

    {%- comment -%} ============= STEP 2: FORM (email capture) ============= {%- endcomment -%}
    <div class="ds-newsletter-popup__step" data-step="form" hidden>
      {%- if section.settings.form_eyebrow != blank -%}
        <p class="ds-newsletter-popup__eyebrow ds-newsletter-popup__eyebrow--accent">
          {{ section.settings.form_eyebrow }}
        </p>
      {%- endif -%}

      <h2 class="ds-newsletter-popup__title">
        {{- section.settings.form_title | default: 'Where should we send it?' -}}
      </h2>

      {%- if section.settings.form_subhead != blank -%}
        <p class="ds-newsletter-popup__subhead">{{ section.settings.form_subhead }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'ds-newsletter-popup__form-tag', target: 'ds-newsletter-popup-target' -%}
        <input type="hidden" name="contact[tags]" value="{{ signup_tags }}">

        <div class="ds-newsletter-popup__form">
          <input
            type="email"
            name="contact[email]"
            class="ds-newsletter-popup__input"
            placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
            aria-label="Email address"
            autocomplete="email"
            required
          >
          <button type="submit" class="ds-newsletter-popup__submit">
            {{- section.settings.button_label | default: 'Send me the font' -}}
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>

        <p class="ds-newsletter-popup__error" data-error hidden></p>
        <p class="ds-newsletter-popup__fineprint">
          {{- section.settings.fineprint | default: 'One font + one process note per month. Unsubscribe anytime.' -}}
        </p>
      {%- endform -%}

      {%- comment -%}
        Hidden iframe acts as the form's POST target so the main page
        doesn't reload on submit. JS listens for its load event to
        treat that as "Shopify response received → show success."
      {%- endcomment -%}
      <iframe
        name="ds-newsletter-popup-target"
        class="ds-newsletter-popup__iframe"
        aria-hidden="true"
        tabindex="-1"
        title="newsletter submission"
      ></iframe>
    </div>

    {%- comment -%} ============= STEP 3: SUCCESS (download) ============= {%- endcomment -%}
    <div class="ds-newsletter-popup__step" data-step="success" hidden>
      {%- if section.settings.success_eyebrow != blank -%}
        <p class="ds-newsletter-popup__eyebrow ds-newsletter-popup__eyebrow--accent">
          {{ section.settings.success_eyebrow }}
        </p>
      {%- endif -%}

      <h2 class="ds-newsletter-popup__title">
        {{- section.settings.success_title | default: 'Obscura Gothic is yours.' -}}
      </h2>

      {%- if section.settings.freebie_label != blank -%}
        <p class="ds-newsletter-popup__filename">{{ section.settings.freebie_label }}</p>
      {%- endif -%}

      {%- if freebie_url != blank -%}
        <a
          href="{{ freebie_url }}"
          class="ds-newsletter-popup__download"
          download
          target="_blank"
          rel="noopener"
        >
          {{- section.settings.download_label | default: 'Download Obscura Gothic' -}}
          <span aria-hidden="true">&darr;</span>
        </a>
      {%- else -%}
        <p class="ds-newsletter-popup__error">
          The freebie file hasn't been set up yet. Add it in Theme editor → Newsletter popup → Freebie file URL.
        </p>
      {%- endif -%}

      {%- if section.settings.success_subhead != blank -%}
        <p class="ds-newsletter-popup__fineprint">{{ section.settings.success_subhead }}</p>
      {%- endif -%}
    </div>
  </div>
</dialog>

{% style %}
  .ds-newsletter-popup {
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-fg);
    max-width: none;
    max-height: none;
  }
  .ds-newsletter-popup::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  /* Flex on [open] so the panel centers both axes — native dialog
     defaults to display:block which only centers horizontally. */
  .ds-newsletter-popup[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-newsletter-popup:not([open]) { display: none; }

  .ds-newsletter-popup__panel {
    position: relative;
    width: min(92vw, 460px);
    max-height: 90vh;
    overflow: auto;
    background: #0b0708;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 40px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
  }

  /* Entrance animation — opacity + slight scale, gated by @starting-style. */
  @starting-style {
    .ds-newsletter-popup[open] .ds-newsletter-popup__panel {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    .ds-newsletter-popup[open]::backdrop {
      opacity: 0;
    }
  }
  .ds-newsletter-popup[open] .ds-newsletter-popup__panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 220ms var(--ease, ease-out),
      transform 220ms var(--ease, ease-out);
  }
  .ds-newsletter-popup[open]::backdrop {
    opacity: 1;
    transition: opacity 220ms var(--ease, ease-out);
  }

  .ds-newsletter-popup__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: color var(--t-fast, 150ms) var(--ease, ease-out);
  }
  @media (hover: hover) {
    .ds-newsletter-popup__close:hover { color: var(--color-accent); }
  }
  .ds-newsletter-popup__close:focus { outline: 0; }
  .ds-newsletter-popup__close:focus-visible {
    outline: 1px solid var(--color-fg);
    outline-offset: 2px;
  }

  .ds-newsletter-popup__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
  }
  .ds-newsletter-popup__eyebrow--accent { color: var(--color-accent); }

  .ds-newsletter-popup__title {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.02;
    margin: 0 0 var(--space-3);
  }
  .ds-newsletter-popup__subhead {
    font-size: var(--fs-small, 14px);
    color: var(--color-fg-muted);
    line-height: 1.5;
    margin: 0 0 var(--space-5);
    max-width: 38ch;
  }

  /* ----- STEP 1: Yes button (primary, dashed-border coupon) ----- */
  .ds-newsletter-popup__yes {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: 18px 20px;
    color: var(--color-fg);
    border: 0;
    background-color: transparent;
    background-image:
      repeating-linear-gradient(90deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(90deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(0deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(0deg, var(--color-fg) 0 11px, transparent 11px 18px);
    background-position: 0 0, 0 100%, 0 0, 100% 0;
    background-size: 100% 2px, 100% 2px, 2px 100%, 2px 100%;
    background-repeat: no-repeat;
    font-family: var(--font-sans);
    font-size: var(--fs-caps, 13px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--t-fast, 150ms) var(--ease, ease-out),
      color var(--t-fast, 150ms) var(--ease, ease-out),
      border-color var(--t-fast, 150ms) var(--ease, ease-out),
      transform var(--t-fast, 150ms) var(--ease, ease-out);
  }
  @media (hover: hover) {
    .ds-newsletter-popup__yes:hover {
      background: var(--color-accent);
      color: var(--color-accent-fg);
      border-color: var(--color-accent);
    }
  }
  .ds-newsletter-popup__yes:active { transform: translateY(1px); }

  /* ----- STEP 1: No-thanks link (text, muted, no border) ----- */
  .ds-newsletter-popup__no {
    display: block;
    width: 100%;
    margin: var(--space-4) auto 0;
    padding: 6px 10px;
    background: transparent;
    border: 0;
    color: var(--color-fg-faint, var(--color-fg-muted));
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-align: center;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--t-fast, 150ms) var(--ease, ease-out);
  }
  @media (hover: hover) {
    .ds-newsletter-popup__no:hover { color: var(--color-fg); }
  }
  .ds-newsletter-popup__no:focus { outline: 0; }
  .ds-newsletter-popup__no:focus-visible {
    outline: 1px solid var(--color-fg);
    outline-offset: 2px;
  }

  /* ----- STEP 2: form (email + submit) ----- */
  .ds-newsletter-popup__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-newsletter-popup__input {
    width: 100%;
    padding: 14px 16px;
    background: transparent;
    border: 1px solid var(--color-border-strong, var(--color-border));
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--fs-body, 16px);
    outline: none;
    transition: border-color var(--t-fast, 150ms) var(--ease, ease-out);
  }
  .ds-newsletter-popup__input::placeholder { color: var(--color-fg-faint, var(--color-fg-muted)); }
  .ds-newsletter-popup__input:focus { border-color: var(--color-fg); }

  /* Hidden iframe = form POST target. Zero size, no layout impact. */
  .ds-newsletter-popup__iframe {
    position: absolute;
    width: 0;
    height: 0;
    border: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .ds-newsletter-popup__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 20px;
    color: var(--color-fg);
    border: 0;
    background-color: transparent;
    background-image:
      repeating-linear-gradient(90deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(90deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(0deg, var(--color-fg) 0 11px, transparent 11px 18px),
      repeating-linear-gradient(0deg, var(--color-fg) 0 11px, transparent 11px 18px);
    background-position: 0 0, 0 100%, 0 0, 100% 0;
    background-size: 100% 2px, 100% 2px, 2px 100%, 2px 100%;
    background-repeat: no-repeat;
    font-family: var(--font-sans);
    font-size: var(--fs-caps, 13px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--t-fast, 150ms) var(--ease, ease-out),
      color var(--t-fast, 150ms) var(--ease, ease-out),
      border-color var(--t-fast, 150ms) var(--ease, ease-out),
      transform var(--t-fast, 150ms) var(--ease, ease-out);
  }
  @media (hover: hover) {
    .ds-newsletter-popup__submit:hover {
      background: var(--color-accent);
      color: var(--color-accent-fg);
      border-color: var(--color-accent);
    }
  }
  .ds-newsletter-popup__submit:active { transform: translateY(1px); }
  .ds-newsletter-popup__submit:disabled { opacity: 0.6; cursor: progress; }

  .ds-newsletter-popup__error {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-sale, #ff4d4d);
    margin: var(--space-3) 0 0;
  }
  .ds-newsletter-popup__fineprint {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-fg-faint, var(--color-fg-muted));
    margin: var(--space-4) 0 0;
  }

  /* ----- STEP 3: success ----- */
  .ds-newsletter-popup__filename {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
    margin: var(--space-3) 0 var(--space-4);
    text-transform: uppercase;
  }
  .ds-newsletter-popup__download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: 16px 20px;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    border: 0;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--fs-caps, 13px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--t-fast, 150ms) var(--ease, ease-out),
      color var(--t-fast, 150ms) var(--ease, ease-out);
  }
  @media (hover: hover) {
    .ds-newsletter-popup__download:hover {
      background: var(--color-fg);
      color: var(--color-bg);
    }
  }

  /* ----- Mobile bottom-sheet treatment ----- */
  @media (max-width: 600px) {
    .ds-newsletter-popup[open] {
      align-items: end;
      padding: 0 12px calc(12px + env(safe-area-inset-bottom));
    }
    .ds-newsletter-popup__panel {
      width: 100%;
      max-width: 100%;
      padding: calc(var(--space-5) + 8px) var(--space-5) var(--space-6);
      max-height: 85dvh;
    }
    .ds-newsletter-popup__panel::before {
      content: "";
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 36px;
      height: 3px;
      background: var(--color-border-strong, var(--color-border));
      border-radius: 2px;
    }
    .ds-newsletter-popup__close {
      top: 14px;
      right: 8px;
      width: 44px;
      height: 44px;
    }
    @starting-style {
      .ds-newsletter-popup[open] .ds-newsletter-popup__panel {
        opacity: 0;
        transform: translateY(24px);
      }
    }
  }
{% endstyle %}

<script>
  /* ============================================================
     DS Newsletter popup controller — two-step

     States:
       ask     → user sees Yes/No question (initial)
       form    → email capture (revealed after Yes click)
       success → download button (revealed after submit)

     Trigger logic same as v2: exit-intent + fallback timer on
     desktop; pure delay on touch devices. Localstorage gates
     re-show via dismissed timestamp + permanent signedup flag.

     Submission paths fire in parallel:
       1. Shopify customer form → iframe → creates customer record
       2. Klaviyo subscription API → instant welcome flow trigger
          (only when company_id + list_id are configured)

     Append ?ds-popup=1 to any URL to force-open for testing
     (bypasses gates + delays).
     ============================================================ */
  (function () {
    var dialog = document.getElementById('ds-newsletter-popup');
    if (!dialog) return;
    if (!dialog.showModal) return; /* graceful no-op on ancient browsers */

    var STORAGE_SIGNUP = 'ds_newsletter_signedup';
    var STORAGE_DISMISS = 'ds_newsletter_dismissed';

    var cooldownDays = parseInt(dialog.dataset.cooldownDays, 10) || 30;
    var mobileDelay = (parseInt(dialog.dataset.mobileDelay, 10) || 20) * 1000;
    var desktopFallback = (parseInt(dialog.dataset.desktopFallback, 10) || 45) * 1000;

    /* ?ds-popup=1 force-open bypass (for testing) */
    var DEBUG_FORCE = false;
    try {
      var params = new URLSearchParams(window.location.search);
      DEBUG_FORCE = params.get('ds-popup') === '1';
    } catch (e) {}

    /* ----- Gate ----- */
    function shouldSkip() {
      if (DEBUG_FORCE) return false;
      try {
        if (localStorage.getItem(STORAGE_SIGNUP) === '1') return true;
        var dismissedAt = localStorage.getItem(STORAGE_DISMISS);
        if (dismissedAt) {
          var ageMs = Date.now() - new Date(dismissedAt).getTime();
          var cooldownMs = cooldownDays * 24 * 60 * 60 * 1000;
          if (ageMs < cooldownMs) return true;
        }
      } catch (e) { /* localStorage disabled — show anyway */ }

      var path = (window.location.pathname || '').toLowerCase();
      if (path.indexOf('/cart') === 0) return true;
      if (path.indexOf('/account') === 0) return true;
      if (path.indexOf('/challenge') === 0) return true;
      if (path.indexOf('/checkouts') === 0) return true;

      return false;
    }
    if (shouldSkip()) return;

    /* ----- Open helper. Focus the Yes button on open so keyboard
             users can advance with Enter immediately. ----- */
    var hasOpened = false;
    function openPopup() {
      if (hasOpened) return;
      hasOpened = true;
      try { dialog.showModal(); } catch (e) { return; }
      var yesBtn = dialog.querySelector('[data-action="advance"]');
      if (yesBtn) {
        setTimeout(function () { yesBtn.focus(); }, 50);
      }
    }

    function recordDismiss() {
      try { localStorage.setItem(STORAGE_DISMISS, new Date().toISOString()); }
      catch (e) {}
    }
    function recordSignup() {
      try { localStorage.setItem(STORAGE_SIGNUP, '1'); }
      catch (e) {}
    }

    /* ----- Triggers ----- */
    var isCoarse = window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches;

    if (DEBUG_FORCE) {
      /* Force-open immediately for testing */
      openPopup();
    } else if (isCoarse) {
      setTimeout(openPopup, mobileDelay);
    } else {
      var onLeave = function (e) {
        if (e.clientY <= 0) openPopup();
      };
      document.addEventListener('mouseleave', onLeave, { once: false });
      setTimeout(openPopup, desktopFallback);
      dialog.addEventListener('close', function () {
        document.removeEventListener('mouseleave', onLeave);
      }, { once: true });
    }

    /* ----- Step refs ----- */
    var stepAsk = dialog.querySelector('[data-step="ask"]');
    var stepForm = dialog.querySelector('[data-step="form"]');
    var stepSuccess = dialog.querySelector('[data-step="success"]');
    var formEl = dialog.querySelector('form.ds-newsletter-popup__form-tag');
    var iframeEl = dialog.querySelector('.ds-newsletter-popup__iframe');
    var errorEl = dialog.querySelector('[data-error]');
    var submitBtn = dialog.querySelector('.ds-newsletter-popup__submit');

    /* ----- Step 1 → Step 2 advance (Yes button) ----- */
    var advanceBtn = dialog.querySelector('[data-action="advance"]');
    if (advanceBtn && stepAsk && stepForm) {
      advanceBtn.addEventListener('click', function () {
        stepAsk.hidden = true;
        stepForm.hidden = false;
        /* Focus the email input so users can start typing immediately.
           Small delay to let mobile keyboards behave. */
        var emailInput = stepForm.querySelector('input[type="email"]');
        if (emailInput) {
          setTimeout(function () { emailInput.focus(); }, 50);
        }
      });
    }

    /* ----- Close buttons (X in corner + "No thanks" link) ----- */
    var closeBtns = dialog.querySelectorAll('[data-action="close"]');
    closeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () { dialog.close(); });
    });

    /* Click backdrop (the dialog itself outside the panel) to close */
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', function () {
      if (DEBUG_FORCE) return;
      if (localStorage.getItem(STORAGE_SIGNUP) !== '1') recordDismiss();
    });

    /* ----- Klaviyo direct-API submission (optional) ----- */
    var klaviyoCompanyId = dialog.dataset.klaviyoCompanyId || '';
    var klaviyoListId = dialog.dataset.klaviyoListId || '';

    function submitToKlaviyo(email) {
      if (!klaviyoCompanyId || !klaviyoListId || !email) return;
      var url = 'https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(klaviyoCompanyId);
      var body = {
        data: {
          type: 'subscription',
          attributes: {
            custom_source: 'Newsletter Popup',
            profile: {
              data: {
                type: 'profile',
                attributes: {
                  email: email,
                  subscriptions: {
                    email: {
                      marketing: { consent: 'SUBSCRIBED' }
                    }
                  },
                  properties: {
                    popup_signup: true,
                    signup_source: 'newsletter_popup'
                  }
                }
              }
            }
          },
          relationships: {
            list: {
              data: { type: 'list', id: klaviyoListId }
            }
          }
        }
      };
      fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Revision': '2024-10-15'
        },
        body: JSON.stringify(body)
      }).then(function (resp) {
        if (resp.status !== 202 && resp.status !== 200) {
          console.warn('[ds-newsletter-popup] Klaviyo returned status', resp.status);
        }
      }).catch(function (err) {
        console.warn('[ds-newsletter-popup] Klaviyo subscribe failed', err);
      });
    }

    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    /* ----- Step 2 form submit ----- */
    if (formEl && iframeEl && stepForm && stepSuccess) {
      var hasSubmitted = false;

      formEl.addEventListener('submit', function () {
        clearError();
        hasSubmitted = true;
        if (submitBtn) submitBtn.disabled = true;

        /* Fire-and-forget Klaviyo subscription. Shopify iframe
           submission is the source of truth for success. */
        var emailInput = formEl.querySelector('input[name="contact[email]"]');
        if (emailInput && emailInput.value) {
          submitToKlaviyo(emailInput.value.trim());
        }
      });

      iframeEl.addEventListener('load', function () {
        if (!hasSubmitted) return;
        stepForm.hidden = true;
        stepSuccess.hidden = false;
        recordSignup();
      });
    }

  })();
</script>

