{%- comment -%}
  sections/ds-newsletter-card.liquid — Email signup card

  Two-column card on desktop (copy left, form right), stacks on <=800px.
  Bordered with a subtle radial gradient on the top-right per mockup.
  Inline email form: `{% form 'customer' %}` posts to Shopify's customer
  creation endpoint; success message shown after submit, errors inline.
  No JavaScript required.

  Eyebrow + multi-line title + sub paragraph + form. Email captured as a
  customer record with the optional "newsletter" tag for segmentation.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme
-%}

<section class="nl4 color-{{ cs }}">
  <div class="nl4__card">
    <div class="nl4__pitch">
      {%- if section.settings.eyebrow != blank -%}<p class="nl4__label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<p class="nl4__eyebrow">{{ section.settings.title }}</p>{%- endif -%}
    </div>
    <div class="nl4__action">
      {%- form 'customer', class: 'nl4__form' -%}
        {%- if section.settings.signup_tag != blank -%}<input type="hidden" name="contact[tags]" value="{{ section.settings.signup_tag }}">{%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="nl4__note nl4__success">{{ section.settings.success_message | default: 'Thanks. See you in your inbox.' }}</p>
        {%- else -%}
          <input class="nl4__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}" aria-label="Email address" required>
          <button class="nl4__btn" type="submit">{{ section.settings.button_label | default: 'Send me the font' }} <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 8h10M8 4l4 4-4 4"/></svg></button>
          {%- if form.errors -%}<p class="nl4__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.subhead != blank -%}<p class="nl4__note">{{ section.settings.subhead }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .ds-newsletter-section {
    background: var(--color-background);
    color: var(--color-foreground);
    padding-top: clamp(32px, 4vw, 56px);
    padding-bottom: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--color-border);
  }
  .ds-newsletter-section__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
  }
  .ds-newsletter-card {
    border: 1px solid var(--color-border);
    padding: clamp(28px, 3.5vw, 48px) clamp(24px, 4vw, 56px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    background:
      radial-gradient(circle at 90% 0%, rgba(255,255,255,0.04), transparent 50%),
      var(--color-bg);
  }
  @media (max-width: 800px) {
    .ds-newsletter-card {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
  .ds-newsletter-card__eyebrow {
    margin: 0 0 var(--space-4);
  }
  .ds-newsletter-card__title {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 var(--space-3);
  }
  .ds-newsletter-card__sub {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    max-width: 36ch;
    margin: 0;
  }
  .ds-newsletter-card__form {
    display: flex;
    border: 1px solid var(--color-border-strong);
    transition: border-color var(--t-fast) var(--ease);
  }
  .ds-newsletter-card__form:focus-within {
    border-color: var(--color-fg);
  }
  .ds-newsletter-card__input {
    flex: 1;
    min-width: 0;
    padding: 18px 20px;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    outline: none;
  }
  .ds-newsletter-card__input::placeholder {
    color: var(--color-fg-faint);
  }
  .ds-newsletter-card__btn {
    padding: 0 var(--space-6);
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-newsletter-card__btn:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .ds-newsletter-card__success {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-accent);
    padding: 18px 0;
    margin: 0;
  }
  .ds-newsletter-card__error {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-sale);
    margin: var(--space-3) 0 0;
  }

  /* ============================================================
     Phone overrides (≤480px) — kept at the END of the CSS so they
     win on the cascade.  Earlier this block sat near the top of
     the stylesheet, BEFORE the base button/form/input rules — so
     the base rules came later in source order and overrode the
     mobile values (CSS cascades: equal specificity → later wins).
     That's why the SUBSCRIBE button kept rendering as the thin
     desktop pill even on phone widths.

     Stack the form vertically and drop the unified form border —
     when input + button stack, the shared border made the button
     feel "trapped inside a box" rather than a distinct brutalist
     action.  Each control gets its own treatment.
     ============================================================ */
  @media (max-width: 480px) {
    .ds-newsletter-card {
      padding: var(--space-5) var(--space-4);
    }
    .ds-newsletter-card__form {
      flex-direction: column;
      gap: var(--space-3);
      border: 0;                              /* drop unified frame */
    }
    .ds-newsletter-card__form:focus-within {
      border-color: transparent;              /* no flash when input focused */
    }
    .ds-newsletter-card__input {
      border: 1px solid var(--color-border-strong);
      padding: 16px 18px;
      transition: border-color var(--t-fast) var(--ease);
    }
    .ds-newsletter-card__input:focus {
      border-color: var(--color-fg);
      outline: none;
    }
    .ds-newsletter-card__btn {
      width: 100%;
      padding: 18px 20px;                     /* heftier — matches the page's other CTAs */
      font-family: var(--font-mono);          /* mono caps — matches sticky CTA + buttons elsewhere */
      font-size: 12px;
      letter-spacing: 0.16em;
    }
  }

  /* ===== Newsletter — nl4 (spiral bg + dark card). Old .ds-newsletter-* rules above dead. ===== */
  .nl4{background-color:var(--color-bg);background-image:url({{ 'ds-freefont-spiral.webp' | asset_url }});background-size:cover;background-position:center;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:34px clamp(16px,6vw,30px);display:flex;justify-content:center;}
  .nl4__card{width:100%;max-width:560px;background:#0b0708;border:1px solid rgba(241,231,229,.14);box-shadow:0 20px 54px rgba(0,0,0,.55);padding:30px 24px;text-align:center;}
  .nl4__pitch{margin:0 0 20px;}
  .nl4__label{font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--color-fg-muted);margin:0 0 8px;}
  .nl4__eyebrow{font-family:var(--font-sans);font-size:20px;font-weight:800;letter-spacing:-.01em;color:var(--color-fg);margin:0;}
  .nl4__eyebrow b{color:var(--color-fg-muted);font-weight:400;font-size:.8em;}
  .nl4__eyebrow s{color:var(--color-fg-muted);}
  .nl4__form{display:flex;flex-direction:column;gap:11px;margin:0;}
  .nl4__input{width:100%;padding:15px 16px;background:transparent;border:1px solid rgba(241,231,229,.28);color:var(--color-fg);font-family:var(--font-mono);font-size:14px;outline:0;transition:border-color .16s;box-sizing:border-box;}
  .nl4__input::placeholder{color:rgba(241,231,229,.4);}
  .nl4__input:focus{border-color:var(--color-fg);}
  .nl4__btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:16px 20px;background:transparent;color:var(--color-fg);border:2px dashed var(--color-fg);font-family:var(--font-sans);font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:background .16s,color .16s,border-color .16s,transform .1s;white-space:nowrap;}
  .nl4__btn svg{width:15px;height:15px;flex:none;}
  .nl4__btn:hover{background:var(--color-accent);color:var(--color-accent-fg);border-color:var(--color-accent);}
  .nl4__btn:active{transform:translateY(1px);}
  .nl4__note{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.04em;color:var(--color-fg-muted);margin:14px 0 0;}
  .nl4__error{font-family:var(--font-mono);font-size:11px;color:#E0525B;margin:10px 0 0;}
  .nl4__success{color:var(--color-fg);font-size:14px;}
  @media (min-width:720px){
    .nl4{padding:58px 30px;}
    .nl4__card{max-width:880px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:48px;padding:42px 50px;text-align:left;}
    .nl4__pitch{margin:0;}
    .nl4__eyebrow{font-size:25px;white-space:nowrap;}
  }

{% endstyle %}

{% schema %}
{
  "name": "Newsletter card",
  "tag": "section",
  "class": "ds-section ds-section--newsletter-card",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    { "type": "header", "content": "Copy" },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "STAY IN THE LOOP",
      "label": "Eyebrow",
      "info": "Small uppercase label above the title. Leave empty to hide."
    },
    {
      "type": "textarea",
      "id": "title",
      "default": "New releases.\nFree assets.\nProcess notes.",
      "label": "Title",
      "info": "Line breaks render as <br>."
    },
    {
      "type": "text",
      "id": "subhead",
      "default": "Roughly twice a month. No spam, no upsells, no nonsense. Unsubscribe in one click.",
      "label": "Subhead"
    },
    { "type": "header", "content": "Form" },
    {
      "type": "text",
      "id": "placeholder",
      "default": "your@email.com",
      "label": "Email placeholder"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Subscribe",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "signup_tag",
      "default": "newsletter",
      "label": "Customer tag",
      "info": "Tag added to new customer records from this form (for segmentation). Leave empty for no tag."
    },
    {
      "type": "text",
      "id": "success_message",
      "default": "Thanks. See you in your inbox.",
      "label": "Success message"
    }
  ],
  "presets": [
    {
      "name": "Newsletter card"
    }
  ]
}
{% endschema %}
