{%- comment -%}
  Pixel Perfect plugin showcase + interactive Vector/Image viewer.
  1:1 port of homepage-build .pp / .ppv (the mock's Plugins-tab showcase).
  Left: product card + demo poster + spec grid. Right: side-by-side
  Vector vs Image renders driven by a shape stepper (■●+×) and a pixel
  slider; 40 pre-rendered frames baked as ds-ppv-g{V|I}-{shape}-{pixel}.webp.
{%- endcomment -%}
{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign product = section.settings.product
  if product == blank
    assign product = all_products['pixel-perfect-plugin']
  endif
  assign buy_label = section.settings.buy_label | default: '+ Add to cart'
-%}

<section class="pp-section color-{{ cs }}">
  {%- if section.settings.eyebrow != blank -%}
    <div class="sec-eye"><span>{{ section.settings.eyebrow }}</span></div>
  {%- endif -%}

  <div class="pp">
    <div class="pp__col pp__col--l">
      <div class="pp__media">
        <article class="pcard">
          <div class="pcard__img" style="background-image:url({{ product.featured_image | image_url: width: 700 }});aspect-ratio:1/1">
            {%- if product.tags contains 'new' -%}<span class="pcard__badge">[ NEW ]</span>{%- endif -%}
            <div class="pcard__scrim"></div>
            <div class="pcard__meta">
              <p class="pcard__name">{{ product.title | default: 'Pixel Perfect' }}</p>
              <div class="pcard__sub tnum">{% if product != blank %}{{ product.price | money_without_trailing_zeros }}{% else %}$25{% endif %} &nbsp;&middot;&nbsp; PLUGIN</div>
            </div>
          </div>
        </article>

        {%- assign poster = section.settings.demo_image -%}
        <a class="pp__video" href="{{ product.url | default: '#' }}">
          <div class="pp__poster" style="background-image:url({% if poster != blank %}{{ poster | image_url: width: 700 }}{% else %}{{ 'ds-pp-demo.webp' | asset_url }}{% endif %})"></div>
          <div class="pp__play"><span></span></div>
          {%- if section.settings.video_label != blank -%}<div class="pp__vlabel">{{ section.settings.video_label }}</div>{%- endif -%}
        </a>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pp__info">
          <div class="pp__spec">
            {%- for block in section.blocks -%}
              <div class="pp__cell" {{ block.shopify_attributes }}>
                <span class="pp__v">{{ block.settings.value }}</span>
                <span class="pp__k">{{ block.settings.key }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="pp__col pp__col--r">
      <div class="ppv">
        <div class="ppv__pair">
          <div class="ppv__col">
            <div class="ppv__box">
              <div class="ppv__img ppv__v pi--gV-1-3" style="aspect-ratio:1/1"></div>
              <span class="ppv__chip ppv__chip--v">vec &middot; &#9632;</span>
            </div>
            <div class="ppv__cap"><b>{{ section.settings.vector_label | default: 'Vector' }}</b><span>{{ section.settings.vector_desc | default: 'flat fill — one colour + threshold' }}</span></div>
          </div>
          <div class="ppv__col">
            <div class="ppv__box">
              <div class="ppv__img ppv__i pi--gI-1-3" style="aspect-ratio:1/1"></div>
              <span class="ppv__chip ppv__chip--i">img &middot; &#9632;</span>
            </div>
            <div class="ppv__cap"><b>{{ section.settings.image_label | default: 'Image' }}</b><span>{{ section.settings.image_desc | default: 'real tones — samples the pixels' }}</span></div>
          </div>
        </div>
        <div class="ppv__bar">
          <div class="ppv__slider">
            <span class="ppv__slabel">pixel</span>
            <input type="range" class="ppv__range" min="1" max="5" step="1" value="3" aria-label="Pixel size">
            <span class="ppv__sval tnum">13</span>
          </div>
          <div class="ppv__sel">
            <button type="button" class="ppv__arrow" data-ppv="prev" aria-label="Previous shape">&lsaquo;</button>
            <span class="ppv__shape" aria-live="polite">&#9632;</span>
            <button type="button" class="ppv__arrow" data-ppv="next" aria-label="Next shape">&rsaquo;</button>
          </div>
        </div>
      </div>

      {%- if product != blank and product.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pp__buyform">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="pp__buy">{{ buy_label }} &middot; {{ product.price | money_without_trailing_zeros }}</button>
        </form>
      {%- else -%}
        <a class="pp__buy" href="{{ product.url | default: '#' }}">{{ buy_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .pp-section { background:var(--color-bg); }
  .pp-section .sec-eye { font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--color-fg-muted);padding:28px 16px 4px;display:flex;justify-content:space-between; }
  .pp { padding:18px 16px 34px;border-top:1px solid var(--color-border); }
  .pp__col { display:flex;flex-direction:column;min-width:0; }
  .pp__media { display:grid;grid-template-columns:1fr 1fr;gap:12px; }
  .pp__video { position:relative;overflow:hidden;background:var(--color-bg-elev);display:block;text-decoration:none; }
  .pp__poster { aspect-ratio:1/1;background-size:cover;background-position:center;background-repeat:no-repeat; }
  .pp__play { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none; }
  .pp__play span { width:42px;height:42px;border-radius:50%;background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.55);display:block;position:relative; }
  .pp__play span::after { content:"";position:absolute;top:50%;left:54%;transform:translate(-50%,-50%);border-left:12px solid #fff;border-top:8px solid transparent;border-bottom:8px solid transparent; }
  .pp__vlabel { position:absolute;left:8px;bottom:8px;font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.5);padding:3px 6px; }
  .pp__info { margin-top:18px; }
  .pp__spec { display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--color-border);border-bottom:0; }
  .pp__cell { border-bottom:1px solid var(--color-border);padding:14px 12px;display:flex;flex-direction:column;gap:4px; }
  .pp__cell:nth-child(odd) { border-right:1px solid var(--color-border); }
  .pp__v { font-weight:700;font-size:14px;letter-spacing:-.01em;color:var(--color-fg); }
  .pp__k { font-family:var(--font-mono);font-size:10px;letter-spacing:.02em;color:var(--color-fg-muted);line-height:1.35; }
  .pp__buyform { width:100%;margin:0; }
  .pp__buy { display:flex;width:100%;justify-content:center;align-items:center;background:var(--color-accent);color:var(--color-accent-fg);font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;padding:13px 16px;margin-top:16px;cursor:pointer;border:0;text-decoration:none; }
  .pp__buy::before { content:"[";font-size:1.6em;line-height:0;margin-right:8px;font-weight:400; }
  .pp__buy::after { content:"]";font-size:1.6em;line-height:0;margin-left:8px;font-weight:400; }
  .pp__buy:hover { filter:brightness(1.09); }

  /* --- pcard (matches shop-by cards) --- */
  .pp .pcard { position:relative;overflow:hidden;background:var(--color-bg-elev);text-decoration:none;display:block; }
  .pp .pcard__img { position:relative;background-size:cover;background-position:center;background-repeat:no-repeat;background-color:var(--color-bg-elev); }
  .pp .pcard__badge { position:absolute;top:8px;left:8px;font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;padding:3px 6px;background:var(--color-accent);color:var(--color-accent-fg); }
  .pp .pcard__scrim { position:absolute;left:0;right:0;bottom:0;height:56%;background:linear-gradient(to top,rgba(0,0,0,.74),rgba(0,0,0,0));pointer-events:none; }
  .pp .pcard__meta { position:absolute;left:10px;right:10px;bottom:9px;color:#fff; }
  .pp .pcard__name { font-family:var(--font-mono);font-size:11px;letter-spacing:.02em;text-transform:uppercase;line-height:1.15;margin:0;color:#fff; }
  .pp .pcard__sub { font-family:var(--font-mono);font-size:9.5px;letter-spacing:.1em;margin-top:4px;color:rgba(255,255,255,.75); }

  /* --- interactive viewer --- */
  .ppv { margin-top:16px; }
  .ppv__pair { display:grid;grid-template-columns:1fr 1fr;gap:10px; }
  .ppv__col { display:flex;flex-direction:column;min-width:0; }
  .ppv__box { position:relative;border:1px solid var(--color-border);background:#0e090b;overflow:hidden; }
  .ppv__img { aspect-ratio:1/1;background-size:cover;background-position:center;background-repeat:no-repeat;transition:background-image .05s; }
  .ppv__chip { position:absolute;left:7px;bottom:7px;font-family:var(--font-mono);font-size:9px;letter-spacing:.03em;color:#e8646c;background:rgba(24,6,8,.78);border:1px solid rgba(193,18,31,.5);padding:2px 6px;border-radius:2px;pointer-events:none; }
  .ppv__cap { padding:9px 2px 0;font-family:var(--font-mono); }
  .ppv__cap b { display:block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--color-fg); }
  .ppv__cap span { display:block;margin-top:2px;font-size:9.5px;letter-spacing:.01em;color:var(--color-fg-muted);line-height:1.45; }
  .ppv__bar { display:flex;align-items:center;gap:16px;margin-top:15px; }
  .ppv__slider { display:flex;align-items:center;gap:10px;flex:1;min-width:0;font-family:var(--font-mono); }
  .ppv__slabel { font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-fg-muted);white-space:nowrap; }
  .ppv__range { -webkit-appearance:none;appearance:none;flex:1;min-width:0;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--color-accent) 50%,var(--color-border) 50%);cursor:pointer;margin:0;outline:none; }
  .ppv__range::-webkit-slider-thumb { -webkit-appearance:none;appearance:none;width:13px;height:13px;border-radius:50%;background:var(--color-accent);cursor:pointer;box-shadow:0 0 0 3px rgba(193,18,31,.2); }
  .ppv__range::-moz-range-thumb { width:13px;height:13px;border:0;border-radius:50%;background:var(--color-accent);cursor:pointer; }
  .ppv__sval { font-size:10px;letter-spacing:.02em;color:var(--color-fg);min-width:16px;text-align:right; }
  .ppv__sel { display:flex;align-items:center;gap:9px;flex:0 0 auto; }
  .ppv__shape { font-family:var(--font-mono);font-size:12px;color:var(--color-accent);min-width:14px;text-align:center; }
  .ppv__arrow { width:24px;height:24px;display:flex;align-items:center;justify-content:center;padding:0;border:1px solid var(--color-border);background:transparent;color:var(--color-fg);font-family:var(--font-mono);font-size:12px;line-height:1;cursor:pointer;border-radius:50%;transition:.15s; }
  .ppv__arrow:hover { border-color:var(--color-accent);color:var(--color-accent); }

  /* --- 40 pre-rendered frames --- */
  {%- assign modes = 'V,I' | split: ',' -%}
  {%- for md in modes -%}{%- for s in (1..4) -%}{%- for p in (1..5) -%}
    {%- capture fn -%}ds-ppv-g{{ md }}-{{ s }}-{{ p }}.webp{%- endcapture -%}
  .pp .pi--g{{ md }}-{{ s }}-{{ p }}{background-image:url({{ fn | asset_url }});}
  {%- endfor -%}{%- endfor -%}{%- endfor -%}

  @media (min-width:720px){
    .pp-section .sec-eye { padding:36px 30px 4px;font-size:11px; }
    .pp { padding:30px;display:flex;gap:30px;align-items:flex-start; }
    .pp__col--l { flex:1.15; }
    .pp__col--r { flex:1; }
  }
{% endstyle %}

{% javascript %}
  document.querySelectorAll('.ppv').forEach(function (root) {
    var v = root.querySelector('.ppv__v'), i = root.querySelector('.ppv__i'),
        vc = root.querySelector('.ppv__chip--v'), ic = root.querySelector('.ppv__chip--i'),
        gl = root.querySelector('.ppv__shape'), sv = root.querySelector('.ppv__sval'),
        rg = root.querySelector('.ppv__range');
    if (!v || !i || !rg) return;
    var sym = ['■', '●', '+', '×'], px = [7, 9, 13, 17, 24];
    var si = 0, zi = 2, cv = '', ci = '';
    function set(el, cls, cur) { if (cur) el.classList.remove(cur); el.classList.add(cls); return cls; }
    function render() {
      var s = si + 1, z = zi + 1;
      cv = set(v, 'pi--gV-' + s + '-' + z, cv);
      ci = set(i, 'pi--gI-' + s + '-' + z, ci);
      if (vc) vc.textContent = 'vec · ' + sym[si];
      if (ic) ic.textContent = 'img · ' + sym[si];
      if (gl) gl.textContent = sym[si];
      if (sv) sv.textContent = px[zi];
      var p = (zi / (px.length - 1)) * 100;
      rg.style.background = 'linear-gradient(90deg,var(--color-accent) ' + p + '%,var(--color-border) ' + p + '%)';
    }
    root.querySelectorAll('[data-ppv]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        si = (si + (btn.dataset.ppv === 'next' ? 1 : -1) + sym.length) % sym.length;
        render();
      });
    });
    rg.addEventListener('input', function () {
      zi = Math.max(0, Math.min(px.length - 1, (parseInt(rg.value, 10) || 1) - 1));
      render();
    });
    render();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Plugin showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "[ The plugin ]" },
    { "type": "product", "id": "product", "label": "Plugin product", "info": "Defaults to Pixel Perfect." },
    { "type": "image_picker", "id": "demo_image", "label": "Demo poster image", "info": "Defaults to the built-in demo still." },
    { "type": "text", "id": "video_label", "label": "Demo label", "default": "[ Demo · 0:38 ]" },
    { "type": "header", "content": "Viewer captions" },
    { "type": "text", "id": "vector_label", "label": "Left label", "default": "Vector" },
    { "type": "text", "id": "vector_desc", "label": "Left caption", "default": "flat fill — one colour + threshold" },
    { "type": "text", "id": "image_label", "label": "Right label", "default": "Image" },
    { "type": "text", "id": "image_desc", "label": "Right caption", "default": "real tones — samples the pixels" },
    { "type": "text", "id": "buy_label", "label": "Buy button label", "default": "+ Add to cart" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "Real-time" },
        { "type": "text", "id": "key", "label": "Label", "default": "Live pixel preview" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Plugin showcase",
      "blocks": [
        { "type": "spec", "settings": { "value": "Real-time", "key": "Live pixel preview" } },
        { "type": "spec", "settings": { "value": "Non-destructive", "key": "Original stays intact" } },
        { "type": "spec", "settings": { "value": "Vector + image", "key": "Type, shapes or photos" } },
        { "type": "spec", "settings": { "value": "One click", "key": "Apply & commit" } }
      ]
    }
  ]
}
{% endschema %}
