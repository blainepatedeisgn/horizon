/*
 * ------------------------------------------------------------
 * Disrupted Studio footer group
 *
 * Single custom section (ds-footer) replaces Horizon's stock
 * "footer" + "footer-utilities" sections entirely. Brutalist 4-col
 * layout with brand blurb, link columns, newsletter+social, legal
 * row, and giant DISRUPTED® wordmark.
 *
 * Configurable via Online Store → Themes → Customize → Footer.
 * ------------------------------------------------------------
 */
{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "ds_footer": {
      "type": "ds-footer",
      "settings": {
        "color_scheme": "scheme-1",
        "brand_name": "DISRUPTED STUDIO",
        "brand_blurb": "A small studio building plugins, type, and graphic assets for designers. Made in Atlanta, GA. One-time purchase, free updates.",
        "copyright_text": "© 2026 Disrupted Studio · All rights reserved",
        "show_payment_chips": true,
        "payment_chips": "Visa, MC, AmEx, PayPal, Apple Pay, Shop",
        "show_wordmark": true,
        "wordmark_text": "DISRUPTED",
        "show_wordmark_reg": true
      },
      "blocks": {
        "shop_links": {
          "type": "link_column",
          "settings": {
            "heading": "Shop",
            "menu": "footer"
          }
        },
        "studio_links": {
          "type": "link_column",
          "settings": {
            "heading": "Studio",
            "menu": "main-menu"
          }
        },
        "newsletter": {
          "type": "newsletter_column",
          "settings": {
            "heading": "Stay in the loop",
            "lead": "New releases, free assets, occasional process notes.",
            "placeholder": "your@email.com",
            "button_label": "Subscribe",
            "tag": "newsletter",
            "success_message": "Thanks. See you in your inbox.",
            "show_social": true
          }
        }
      },
      "block_order": ["shop_links", "studio_links", "newsletter"]
    }
  },
  "order": ["ds_footer"]
}
