{%- comment -%}
  sections/ds-pdp-faq.liquid — Per-template FAQ accordion

  Each Q/A is a section BLOCK ("faq_item"), pre-populated via the
  product template JSON (templates/product.plugin.json,
  product.font.json, etc.) so a freshly-assigned product picks up
  the right defaults for its type without per-product metafield setup.

  Merchant edits via theme editor → Customize → product template
  → FAQ section → blocks. Reorder, add, remove, edit per template.

  Migration note: previous version read product.metafields.disrupted.faq
  (list of faq_item metaobjects). That metafield is no longer read by
  this section — the definition can be deleted in Settings → Custom
  data → Products. Per-product overrides aren't supported anymore;
  to give a single product a unique FAQ, edit the template's blocks
  (affects all products on that template) or assign that product to
  a different template.

  Uses native HTML <details> / <summary> for the accordion — no JS
  needed. CSS handles the rotate animation on the toggle icon.
  Respects prefers-reduced-motion.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
-%}

{%- if section.blocks.size > 0 -%}
<section id="faq" class="ds-pdp-faq color-{{ cs }}">
  <div class="ds-pdp-faq__inner">

    {%- if section.settings.heading != blank or section.settings.subhead != blank -%}
      <div class="ds-section-head ds-pdp-faq__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ds-section-head__title">
            {{ section.settings.heading }}
            {%- if section.settings.num_label != blank -%}
              <span class="ds-section-head__num">{{ section.settings.num_label }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.subhead != blank -%}
          <p class="ds-section-head__sub">{{ section.settings.subhead }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      ---------- Per-product FAQ visibility, resolved ONCE ----------
      One FAQ set is shared by every product on a template, but some answers
      are only true for some products (e.g. TXT-84 and Obscura Gothic really
      are uppercase-only; Bone Marrow has a full lowercase set). So a block
      can gate itself on a product TAG:

        show_if_tag — render only when the product HAS that tag
        hide_if_tag — skip when the product HAS that tag

      Both blank = always show (existing blocks are unaffected).

      Resolved into `visible_ids` here because THREE loops must agree: the
      visible list, the JSON-LD counter, and the JSON-LD renderer. If they
      disagreed, the FAQPage schema would advertise an answer that isn't on
      the page (a Google FAQ policy violation) and the comma logic would emit
      invalid JSON. Match is delimiter-wrapped so "uppercase" can't match a
      tag like "uppercase-only".
    {%- endcomment -%}
    {%- liquid
      assign tag_hay = product.tags | join: '||' | downcase | prepend: '||' | append: '||'
      assign visible_ids = ''
      assign valid_q_count = 0
      for block in section.blocks
        if block.type != 'faq_item' or block.settings.question == blank
          continue
        endif
        assign faq_ok = true
        assign want = block.settings.show_if_tag | strip | downcase
        if want != blank
          assign needle = want | prepend: '||' | append: '||'
          unless tag_hay contains needle
            assign faq_ok = false
          endunless
        endif
        assign skip = block.settings.hide_if_tag | strip | downcase
        if skip != blank
          assign needle = skip | prepend: '||' | append: '||'
          if tag_hay contains needle
            assign faq_ok = false
          endif
        endif
        if faq_ok
          assign visible_ids = visible_ids | append: block.id | append: '||'
          if block.settings.answer != blank
            assign valid_q_count = valid_q_count | plus: 1
          endif
        endif
      endfor
      assign visible_ids = visible_ids | prepend: '||'
    -%}

    <div class="ds-pdp-faq__list">
      {%- assign vis_n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          {%- liquid
            assign question = block.settings.question
            assign answer = block.settings.answer
            assign bid = block.id | prepend: '||' | append: '||'
          -%}
          {%- if question != blank and visible_ids contains bid -%}
            {%- liquid
              assign vis_n = vis_n | plus: 1
              assign num_str = vis_n | prepend: '0' | slice: -2, 2
            -%}
            <details class="ds-pdp-faq__item" {{ block.shopify_attributes }}>
              <summary class="ds-pdp-faq__q">
                <span class="ds-pdp-faq__q-num">{{ num_str }}</span>
                <span class="ds-pdp-faq__q-text">{{ question }}</span>
                <span class="ds-pdp-faq__q-toggle" aria-hidden="true">+</span>
              </summary>
              {%- if answer != blank -%}
                <div class="ds-pdp-faq__a">
                  <div class="ds-pdp-faq__a-inner">{{ answer | newline_to_br }}</div>
                </div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  FAQPage structured data — unlocks Google's expandable FAQ rich
  snippet in search results, which is a direct CTR win on product
  pages with FAQs. Two-pass loop: first count valid Q/A pairs (so
  we can emit commas correctly), then render them. Plain JSON
  doesn't allow trailing commas in arrays.

  Each Question / Answer pair maps directly to one section block
  so the SEO surface stays in sync with what visitors actually see.
{%- endcomment -%}
{%- comment -%}
  valid_q_count is computed ABOVE, over VISIBLE blocks only (see the
  visibility note there) — a tag-hidden answer must not appear here, or the
  schema would claim something the page never shows.
{%- endcomment -%}
{%- liquid
  assign rendered_q = 0
-%}
{%- if valid_q_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- assign bid = block.id | prepend: '||' | append: '||' -%}
      {%- if block.type == 'faq_item' and block.settings.question != blank and block.settings.answer != blank and visible_ids contains bid -%}
        {%- assign rendered_q = rendered_q | plus: 1 -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
          }
        }{% if rendered_q < valid_q_count %},{% endif %}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- endif -%}

{% style %}
  /* ds-pdp-faq — port of mockup .faq (lines 1999-2045) */
  .ds-pdp-faq {
    background: var(--color-background);
    color: var(--color-foreground);
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--color-border);
  }
  .ds-pdp-faq__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
  }
  .ds-pdp-faq__head {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .ds-pdp-faq__list {
    display: flex;
    flex-direction: column;
  }

  /* native <details> reset */
  .ds-pdp-faq__item {
    border-top: 1px solid var(--color-border);
  }
  .ds-pdp-faq__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .ds-pdp-faq__item summary { list-style: none; cursor: pointer; }
  .ds-pdp-faq__item summary::-webkit-details-marker { display: none; }
  .ds-pdp-faq__item summary::marker { content: ''; }

  /* Question row */
  .ds-pdp-faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) 0;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: left;
    gap: var(--space-4);
  }
  .ds-pdp-faq__q-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    letter-spacing: 0.08em;
    margin-right: var(--space-4);
    flex-shrink: 0;
  }
  .ds-pdp-faq__q-text {
    flex: 1;
  }
  .ds-pdp-faq__q-toggle {
    font-size: 20px;
    color: var(--color-fg-muted);
    transition:
      transform var(--t-base) var(--ease),
      color     var(--t-base) var(--ease);
    flex-shrink: 0;
    width: 20px;
    text-align: center;
    display: inline-block;
  }
  .ds-pdp-faq__item[open] .ds-pdp-faq__q-toggle {
    transform: rotate(45deg);
    color: var(--color-accent);
  }

  /* Answer */
  .ds-pdp-faq__a {
    font-size: var(--fs-body);
    color: var(--color-fg-muted);
    line-height: 1.6;
    padding-left: calc(12px + var(--space-4) + 20px); /* num-width + num-margin + toggle-width */
    overflow: hidden;
  }
  .ds-pdp-faq__a-inner {
    padding-bottom: var(--space-5);
    max-width: 60ch;
  }
  .ds-pdp-faq__a-inner a {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-border-strong);
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease);
  }
  .ds-pdp-faq__a-inner a:hover {
    border-color: var(--color-fg);
  }

  /* Reduced-motion: drop the rotate transition */
  @media (prefers-reduced-motion: reduce) {
    .ds-pdp-faq__q-toggle { transition: none; }
  }

  /* Mobile — pull the answer back flush so paragraphs aren't squeezed,
     tighten the question row, shrink gap between num + text */
  @media (max-width: 700px) {
    .ds-pdp-faq__q {
      padding: var(--space-4) 0;
      font-size: 17px;
      gap: var(--space-3);
    }
    .ds-pdp-faq__q-num {
      margin-right: var(--space-2);
      font-size: 11px;
    }
    .ds-pdp-faq__a {
      padding-left: 0;        /* drop the 48px desktop indent */
    }
    .ds-pdp-faq__a-inner {
      padding-bottom: var(--space-4);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Disrupted PDP FAQ",
  "tag": "section",
  "class": "ds-section ds-section--pdp-faq",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Questions",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "num_label",
      "label": "Number badge",
      "info": "Optional mono superscript next to the title (e.g. \"06\")."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "info": "Optional secondary text below the title."
    },
    {
      "type": "paragraph",
      "content": "FAQ questions are blocks (add/remove/reorder below). Edits here apply to every product on this template — to give a single product a unique FAQ, assign it to a different template."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "info": "Line breaks render as paragraph breaks."
        },
        {
          "type": "header",
          "content": "Per-product visibility"
        },
        {
          "type": "text",
          "id": "show_if_tag",
          "label": "Only show if product tagged",
          "info": "Leave blank to always show. e.g. enter \"uppercase\" and this answer renders only for products carrying that tag."
        },
        {
          "type": "text",
          "id": "hide_if_tag",
          "label": "Hide if product tagged",
          "info": "Leave blank to never hide. Pair with the block above — same tag, opposite field — to serve two different answers to the same question."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Disrupted PDP FAQ"
    }
  ]
}
{% endschema %}
