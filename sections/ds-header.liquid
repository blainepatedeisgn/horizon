{%- comment -%}
  sections/ds-header.liquid — Disrupted Studio site-wide header

  Full custom replacement for Horizon's stock header. Lives in
  sections/header-group.json. Shows on every page above the announcement
  bar (if announcement bar is also configured in header-group).

  Layout (desktop):
    [ LOGO ]    [ NAV (Shop, Plugins, Fonts, Graphics, About) ]    [ SEARCH ][ CART (n) ]

  Mobile (≤900px):
    [ HAMBURGER  LOGO ]   [ SEARCH icon ][ CART (n) ]
    + slide-in drawer with full nav

  Active nav item gets the orange underline. Cart count badge appears
  whenever cart.item_count > 0.

  Section settings:
    color_scheme
    logo_text          (text)       — fallback when no image logo
    logo_image         (image)      — optional brand mark (replaces text)
    main_menu          (link_list)  — pick a Shopify menu
    show_search        (bool)
    show_cart          (bool)
    sticky             (bool)       — position: sticky on scroll
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign logo_text = section.settings.logo_text | default: 'DISRUPTED STUDIO'
  assign logo_image = section.settings.logo_image
  assign main_menu = section.settings.main_menu
  assign show_search = section.settings.show_search
  assign show_cart = section.settings.show_cart
  assign sticky = section.settings.sticky
-%}

<div class="ds-header color-{{ cs }}{% if sticky %} ds-header--sticky{% endif %}">
  <div class="ds-header__inner">

    <div class="ds-header__left">
      {%- if main_menu != blank and linklists[main_menu].links.size > 0 -%}
        <button class="ds-header__icon-btn ds-header__menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-ds-menu-toggle>
          <svg viewBox="0 0 22 16" width="22" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <line x1="0" y1="2"  x2="22" y2="2"  stroke="currentColor" stroke-width="1.5"/>
            <line x1="0" y1="8"  x2="22" y2="8"  stroke="currentColor" stroke-width="1.5"/>
            <line x1="0" y1="14" x2="22" y2="14" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Menu</span>
        </button>
      {%- endif -%}

      <a href="{{ routes.root_url }}" class="ds-header__logo" aria-label="{{ shop.name | escape }} — home">
        {%- if logo_image -%}
          {{
            logo_image
            | image_url: width: 240
            | image_tag:
              widths: '120,180,240,360',
              alt: shop.name,
              class: 'ds-header__logo-img',
              loading: 'eager'
          }}
        {%- else -%}
          {{ logo_text }}
        {%- endif -%}
      </a>
    </div>

    {%- if main_menu != blank and linklists[main_menu].links.size > 0 -%}
      <nav class="ds-header__nav" aria-label="Main navigation">
        {%- for link in linklists[main_menu].links -%}
          <a
            href="{{ link.url }}"
            class="ds-header__nav-link{% if link.active or link.child_active %} is-active{% endif %}"
          >{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="ds-header__actions">
      {%- if show_search -%}
        {%- comment -%}
          Button (not <a>) — opens the centered search modal mounted below.
          on:click="#<id>/<method>" is Horizon's declarative event syntax
          for referencing a sibling/global custom element by id.
        {%- endcomment -%}
        <button
          type="button"
          class="ds-header__icon-btn ds-header__search-trigger"
          on:click="#ds-search-modal/showDialog"
          aria-haspopup="dialog"
          aria-label="Open search"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false" width="16" height="16">
            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
            <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Search</span>
        </button>
      {%- endif -%}
      {%- if show_cart -%}
        {%- comment -%}
          Cart trigger + drawer dialog wrapped in Horizon's
          <cart-drawer-component>. The component listens for `on:click="/open"`
          on any descendant and calls `.showModal()` on the [ref="dialog"]
          child. AJAX line-item updates flow through the inner
          <cart-items-component> using the Section Rendering API
          (data-section-id must match this section's id).

          A native <dialog> element renders in the browser's top-layer when
          opened with showModal(), so the dialog escapes any containing
          block / backdrop-filter trap from the sticky header — same gotcha
          we just hit with the mobile menu drawer.
        {%- endcomment -%}
        <script src="{{ 'cart-drawer.js' | asset_url }}" type="module" fetchpriority="low"></script>

        <cart-drawer-component class="ds-header__cart-component" auto-open>
          <button
            type="button"
            class="ds-header__icon-btn ds-header__cart-link"
            on:click="/open"
            aria-haspopup="dialog"
            aria-label="Cart, {{ cart.item_count }} items"
            data-hydration-key="ds-header-cart-link"
          >
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false" width="16" height="16">
              <path d="M3 4h2l1.6 9.4a1 1 0 0 0 1 .8h7.2a1 1 0 0 0 1-.8L17.5 7H6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="8" cy="17" r="1.2" fill="currentColor"/>
              <circle cx="15" cy="17" r="1.2" fill="currentColor"/>
            </svg>
            <span>Cart</span>
            {%- if cart.item_count > 0 -%}
              <span class="ds-header__cart-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </button>

          <dialog
            ref="dialog"
            class="ds-cart-drawer"
            aria-labelledby="ds-cart-drawer-title"
          >
            {%- comment -%}
              data-hydration-key on the panel (NOT on the dialog
              itself) is the critical bit — it tells morph.js to
              update only the panel's contents on every cart change
              and leave the parent <dialog> element entirely alone.
              That preserves the dialog's [open] attribute so the
              drawer doesn't close+reopen on add / remove / qty
              updates. cart-items-component below carries the
              `data-drawer` flag that switches morphSection() to
              hydration mode, and the matching keyed wrapper is
              what hydration looks for.
            {%- endcomment -%}
            <div
              class="ds-cart-drawer__panel"
              data-hydration-key="ds-cart-drawer-panel"
            >
              <div class="ds-cart-drawer__head">
                <h2 id="ds-cart-drawer-title" class="ds-cart-drawer__title">
                  Cart
                  {%- if cart.item_count > 0 -%}
                    <span class="ds-cart-drawer__title-num">({{ cart.item_count }})</span>
                  {%- endif -%}
                </h2>
                <button
                  type="button"
                  class="ds-cart-drawer__close"
                  on:click="cart-drawer-component/close"
                  aria-label="Close cart"
                >×</button>
              </div>

              {%- comment -%}
                Loading bar — sits at the top edge of the body area
                below the head. Hidden by default; visible only when
                <cart-drawer-component> carries .is-loading (toggled
                by the ATC submit handler at the bottom of this file).
                Auto-clears on the `cart:update` event after Horizon's
                morph completes. Gives an "in-progress" cue between
                drawer-open and items-rendered so the empty cart
                doesn't read as broken on the first add.
              {%- endcomment -%}
              <div class="ds-cart-drawer__loading" aria-hidden="true">
                <div class="ds-cart-drawer__loading-bar"></div>
              </div>

              <cart-items-component
                class="ds-cart-drawer__body"
                data-section-id="{{ section.id }}"
                data-drawer
              >
                {%- if cart.empty? -%}
                  {%- render 'ds-cart-products', force_empty: true -%}
                {%- else -%}
                  {%- comment -%}
                    Items + upsell share one scrollable column so when
                    the cart has multiple items, the user can scroll
                    through them AND the upsell suggestions together
                    without the items area getting squeezed by the
                    upsell + summary footer. Summary stays pinned
                    below as a separate flex child.
                  {%- endcomment -%}
                  <div class="ds-cart__scrollable">
                    {%- render 'ds-cart-products' -%}
                    {%- render 'ds-cart-upsell', section: section -%}
                  </div>
                  {%- render 'ds-cart-summary' -%}
                {%- endif -%}
              </cart-items-component>
            </div>
          </dialog>
        </cart-drawer-component>

        {%- comment -%}
          Tier-upsell click handler. Lives here (rather than inside
          snippets/ds-cart-products.liquid) so the listener attaches
          during the initial document parse. Inline scripts that
          arrive later via cart-drawer morphing don't re-execute in
          browsers, so a snippet-level script would silently no-op
          for anyone whose cart starts empty.

          Uses document-level event delegation, so the handler still
          fires for upgrade buttons that show up only after morph.
        {%- endcomment -%}
        <script>
          (function () {
            if (window.__dsCartUpsellInit) return;
            window.__dsCartUpsellInit = true;

            document.addEventListener('click', function (e) {
              var btn = e.target.closest('[data-ds-cart-upsell]');
              if (!btn || btn.disabled) return;
              e.preventDefault();

              btn.disabled = true;
              btn.setAttribute('data-loading', '1');

              var lineKey = btn.getAttribute('data-line-key');
              var upgradeTo = parseInt(btn.getAttribute('data-upgrade-to'), 10);
              if (!lineKey || !upgradeTo) {
                btn.disabled = false;
                btn.removeAttribute('data-loading');
                return;
              }

              // Order: ADD the upgrade variant first, THEN remove the
              // lower tier. If the order is reversed and the cart ends
              // up empty between the two requests, some Shopify stores
              // redirect /cart endpoints to the empty-cart page and the
              // second request gets a 404. Add-then-remove is safer.
              fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: upgradeTo, quantity: 1 })
              })
              .then(function (r) {
                if (!r.ok) throw new Error('Add failed (' + r.status + ')');
                return fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: lineKey, quantity: 0 })
                });
              })
              .then(function (r) {
                if (!r.ok) throw new Error('Remove failed (' + r.status + ')');
                try { sessionStorage.setItem('ds-cart-reopen-after-upgrade', '1'); } catch (e) {}
                window.location.reload();
              })
              .catch(function (err) {
                console.error('Tier upgrade failed:', err);
                btn.disabled = false;
                btn.removeAttribute('data-loading');
              });
            });

            // After reload from an upgrade, re-open the cart drawer.
            // The drawer trigger is the .ds-header__cart-link button
            // — clicking it programmatically triggers Horizon's
            // on:click="/open" declarative handler.
            try {
              if (sessionStorage.getItem('ds-cart-reopen-after-upgrade') === '1') {
                sessionStorage.removeItem('ds-cart-reopen-after-upgrade');
                var openDrawer = function () {
                  var trigger = document.querySelector('.ds-header__cart-link');
                  if (trigger) trigger.click();
                };
                if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', function () {
                    setTimeout(openDrawer, 80);
                  });
                } else {
                  setTimeout(openDrawer, 80);
                }
              }
            } catch (e) {}
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  ----- MOBILE DRAWER -----
  IMPORTANT: this lives OUTSIDE .ds-header on purpose. When the header
  is sticky it has `backdrop-filter: blur(12px)`, which creates a
  containing block for `position: fixed` descendants. If the drawer
  were nested inside, its `inset: 0` would be relative to the header
  bar (just the 64px strip) and the overlay wouldn't cover the page.
{%- endcomment -%}
{%- if main_menu != blank and linklists[main_menu].links.size > 0 -%}
  <div class="ds-header__drawer" data-ds-drawer aria-hidden="true" role="dialog" aria-label="Menu">
    <div class="ds-header__drawer-inner">
      <div class="ds-header__drawer-head">
        <span class="ds-header__drawer-eyebrow">[ Menu ]</span>
        <button class="ds-header__drawer-close" type="button" aria-label="Close menu" data-ds-menu-toggle>
          <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path d="M5 5L19 19M19 5L5 19"/>
          </svg>
          <span>Close</span>
        </button>
      </div>

      <nav class="ds-header__drawer-nav" aria-label="Mobile main navigation">
        {%- for link in linklists[main_menu].links -%}
          <a
            href="{{ link.url }}"
            class="ds-header__drawer-link{% if link.active or link.child_active %} is-active{% endif %}"
          >
            <span>{{ link.title }}</span>
            <span class="ds-header__drawer-link-arrow" aria-hidden="true">→</span>
          </a>
        {%- endfor -%}
      </nav>

      {%- liquid
        assign drawer_loc    = section.settings.drawer_footer_location
        assign drawer_email  = section.settings.drawer_footer_email
        assign drawer_status = section.settings.drawer_footer_status
        assign current_year  = 'now' | date: '%Y'
      -%}
      {%- if drawer_loc != blank or drawer_email != blank or drawer_status != blank -%}
        <div class="ds-header__drawer-foot">
          {%- if drawer_loc != blank or drawer_status != blank -%}
            <div class="ds-header__drawer-foot-row">
              <span>{{ drawer_loc }}</span>
              {%- if drawer_status != blank -%}
                <span><span class="ds-header__drawer-dot" aria-hidden="true">●</span> {{ drawer_status }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if drawer_email != blank -%}
            <div class="ds-header__drawer-foot-row">
              <span>{{ drawer_email }}</span>
              <span>© {{ current_year }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- comment -%}
  ----- SEARCH MODAL -----
  Centered cmdk-style search popup. Mounted outside .ds-header (same
  reason as the cart drawer + mobile menu — escape backdrop-filter
  containing block). Uses Horizon's <dialog-component> for open/close
  + <predictive-search-component> for the search API + section render.

  Trigger lives in the header bar: <button on:click="#ds-search-modal/showDialog">
  Required refs (don't rename — JS depends on them):
    form, searchInput, resetButton, predictiveSearchResults, viewAllButton
{%- endcomment -%}
{%- if show_search -%}
  <script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
  <script src="{{ 'predictive-search.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <dialog-component id="ds-search-modal" class="ds-search-modal">
    <dialog
      ref="dialog"
      class="ds-search-modal__dialog"
      on:click="/closeDialogOnClickOutside"
      on:keydown="/closeDialogOnEscapePress"
      aria-labelledby="ds-search-modal-title"
    >
      <h2 id="ds-search-modal-title" class="visually-hidden">Search</h2>

      <predictive-search-component
        class="ds-search-modal__panel"
        data-section-id="ds-predictive-search"
        role="search"
        aria-label="Search"
      >
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="ds-search-modal__form"
          ref="form"
          on:keydown="/onSearchKeyDown"
        >
          <div class="ds-search-modal__inputbar">
            <svg class="ds-search-modal__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false" width="16" height="16">
              <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
              <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <label for="ds-search-input" class="visually-hidden">Search</label>
            <input
              id="ds-search-input"
              ref="searchInput"
              type="search"
              name="q"
              placeholder="Search products, fonts, plugins…"
              class="ds-search-modal__input"
              role="combobox"
              aria-expanded="false"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocomplete="off"
              on:input="/search"
              on:keydown="/onSearchKeyDown"
            >
            <input name="options[prefix]" type="hidden" value="last">
            <input name="type" type="hidden" value="product">
            <input name="options[unavailable_products]" type="hidden" value="last">

            <button
              type="button"
              ref="resetButton"
              hidden
              class="ds-search-modal__reset"
              on:click="/resetSearch"
              aria-label="Clear search"
            >Clear</button>

            <button
              type="button"
              class="ds-search-modal__close"
              on:click="dialog-component/closeDialog"
              aria-label="Close search"
            >×</button>
          </div>

          {%- comment -%}
            Two-column body for desktop:
              [ BROWSE sidebar | live results ]
            Sidebar hides on mobile (≤900px) so the results take the full
            width — mobile keeps the simple single-column flow.

            Recent searches column is a TODO (Phase 5 polish — requires
            localStorage write on form submit + read on dropdown open).
          {%- endcomment -%}
          <div class="ds-search-modal__body">
            <aside class="ds-search-modal__sidebar" aria-label="Browse">
              <div class="ds-search-modal__sidebar-group">
                <div class="ds-search-modal__sidebar-head">Browse</div>
                <a href="{{ routes.all_products_collection_url }}" class="ds-search-modal__sidebar-link">All products</a>
                <a href="/collections/plugins" class="ds-search-modal__sidebar-link">Plugins</a>
                <a href="/collections/fonts"   class="ds-search-modal__sidebar-link">Fonts</a>
                <a href="/collections/graphics" class="ds-search-modal__sidebar-link">Graphics</a>
              </div>

              {%- comment -%}
                Recent searches — populated client-side from localStorage by
                the script at the bottom of this section. Renders hidden by
                default; the script reveals it once it has at least one entry.
              {%- endcomment -%}
              <div class="ds-search-modal__sidebar-group ds-search-modal__sidebar-group--recent" data-ds-recent-group hidden>
                <div class="ds-search-modal__sidebar-head ds-search-modal__sidebar-head--with-action">
                  <span>Recent</span>
                  <button type="button" class="ds-search-modal__sidebar-clear" data-ds-recent-clear aria-label="Clear recent searches">Clear</button>
                </div>
                <ul class="ds-search-modal__sidebar-recent-list" data-ds-recent-list role="list"></ul>
              </div>
            </aside>

            <div
              class="ds-search-modal__results"
              ref="predictiveSearchResults"
              tabindex="-1"
              on:click="/handleModalClick"
            >
              <div class="ds-search-results ds-search-results--idle">
                <p class="ds-search-results__hint">
                  Start typing to search products, collections &amp; more.
                </p>
              </div>
            </div>
          </div>

          <div class="ds-search-modal__foot">
            <button
              type="submit"
              ref="viewAllButton"
              class="ds-search-modal__viewall"
            >
              View all results →
            </button>
            <span class="ds-search-modal__hint">
              <kbd>Esc</kbd> to close
            </span>
          </div>
        </form>
      </predictive-search-component>
    </dialog>
  </dialog-component>
{%- endif -%}

{% style %}
  /* ds-header — port of mockup .header (lines 211-320) */
  .ds-header {
    background: var(--color-bg);
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-border);
    z-index: 50;
  }
  .ds-header--sticky {
    position: sticky;
    top: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .ds-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: 0 var(--pad-x);
    gap: 40px;
  }
  .ds-header__left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .ds-header__logo {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.005em;
    color: var(--color-fg);
    text-decoration: none;
    white-space: nowrap;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
  }
  .ds-header__logo-img {
    display: block;
    height: 32px;
    width: auto;
  }
  .ds-header__nav {
    display: flex;
    gap: 32px;
    flex: 1;
    justify-content: flex-start;
  }
  .ds-header__nav-link {
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    opacity: 0.55;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition:
      opacity      var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .ds-header__nav-link:hover { opacity: 1; }
  .ds-header__nav-link.is-active {
    opacity: 1;
    border-bottom-color: var(--color-accent);
  }
  .ds-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }
  .ds-header__icon-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    opacity: 0.7;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: opacity var(--t-fast) var(--ease);
    position: relative;
    padding: 0;
  }
  .ds-header__icon-btn:hover { opacity: 1; }
  .ds-header__icon-btn svg {
    flex-shrink: 0;
  }
  .ds-header__cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0;
    border-radius: 99px;
    font-weight: 500;
    margin-left: 4px;
    /* `transform-origin: center` so the scale pulse expands evenly
       around the bubble's middle, not from a corner. */
    transform-origin: center center;
  }
  /* Pulse animation triggered after a successful /cart/add (only —
     not on remove or quantity-change). The JS adds .is-pulsing
     after cart:update fires, the keyframe scale-ticks the bubble
     to draw the eye to the new count value, then auto-removes via
     animationend. Re-fires reliably on rapid adds because the JS
     toggles the class with a forced reflow between removes/adds. */
  @keyframes ds-cart-count-pulse {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .ds-header__cart-count.is-pulsing {
    animation: ds-cart-count-pulse 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-header__cart-count.is-pulsing {
      animation: none;
    }
  }
  .ds-header__menu-toggle { display: none; }

  @media (max-width: 900px) {
    .ds-header__nav { display: none; }
    .ds-header__menu-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ds-header__icon-btn span:not(.ds-header__cart-count) {
      display: none;
    }
    .ds-header__actions { gap: 8px; }
    .ds-header__inner { gap: 16px; }
    .ds-header__icon-btn {
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
      opacity: 1;
    }
    .ds-header__menu-toggle { padding: 0 4px; }

    /* The left chunk holds [hamburger + logo image].  Desktop's
       flex-shrink: 0 prevents the logo from compressing against the
       nav links, which works fine because the nav has plenty of room.
       On mobile (no nav, just hamburger + logo + actions) the chunk
       can stay flex-shrink: 0 — we instead constrain the LOGO IMAGE
       itself via max-width so it doesn't push the actions off-screen.
       Importantly NO overflow:hidden anywhere — the image's
       max-width + object-fit:contain keeps it bounded without
       clipping (clipping was the source of the previous "STUDI…"
       cut-off bug). */
    .ds-header__logo-img {
      height: 22px;                 /* down from 32px on desktop */
      width: auto;
      max-width: 45vw;              /* hard cap so a wide wordmark can't push the icons off-screen */
      object-fit: contain;
      object-position: left center;
    }
  }

  /* Phones (≤480px): logo shrinks further so [hamburger + logo +
     gap + search + cart + 2×pad-x] all fit on a 360px viewport. */
  @media (max-width: 480px) {
    .ds-header__logo-img {
      height: 18px;
      max-width: 40vw;              /* ~145px on a 360px phone */
    }
  }

  /* Mobile drawer — full overhaul to match the original mockup
     (lines 320-404 of disrupted-studio-mockup.html). Slides in from
     the left, fills the viewport, structured as head / nav / foot
     with the foot pushed down via margin-top: auto. */
  .ds-header__drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-bg);
    color: var(--color-fg);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform var(--t-slow, 480ms) var(--ease, cubic-bezier(.2,.7,.2,1));
    visibility: hidden;
  }
  .ds-header__drawer.is-open {
    transform: translateX(0);
    visibility: visible;
  }
  .ds-header__drawer-inner {
    padding: var(--space-5) var(--pad-x) var(--space-7);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  /* Head — [Menu] eyebrow on left, × Close on right, hairline under */
  .ds-header__drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .ds-header__drawer-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .ds-header__drawer-close {
    background: none;
    border: 0;
    color: var(--color-fg);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  .ds-header__drawer-close svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  /* Nav links — huge display type, divider per row, arrow on the right.
     Hover slides text right and reveals the arrow shift. */
  .ds-header__drawer-nav {
    display: flex;
    flex-direction: column;
  }
  .ds-header__drawer-link {
    font-family: var(--font-sans);
    font-size: clamp(40px, 12vw, 60px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-fg);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    transition:
      color        var(--t-fast) var(--ease),
      padding-left var(--t-fast) var(--ease);
  }
  .ds-header__drawer-link:first-child {
    padding-top: var(--space-4);
  }
  .ds-header__drawer-link-arrow {
    font-size: 0.42em;
    font-weight: 400;
    color: var(--color-fg-muted);
    transition:
      transform var(--t-fast) var(--ease),
      color     var(--t-fast) var(--ease);
  }
  .ds-header__drawer-link:hover,
  .ds-header__drawer-link:active,
  .ds-header__drawer-link.is-active {
    color: var(--color-accent);
    padding-left: var(--space-3);
  }
  .ds-header__drawer-link:hover .ds-header__drawer-link-arrow,
  .ds-header__drawer-link:active .ds-header__drawer-link-arrow,
  .ds-header__drawer-link.is-active .ds-header__drawer-link-arrow {
    transform: translateX(6px);
    color: var(--color-accent);
  }

  /* Foot — pushed to the bottom via margin-top: auto; mono caps rows */
  .ds-header__drawer-foot {
    margin-top: auto;
    padding-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-header__drawer-foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }
  .ds-header__drawer-dot { color: var(--color-accent); }

  /* Respect reduced motion — drop the slide transition */
  @media (prefers-reduced-motion: reduce) {
    .ds-header__drawer { transition: none; }
  }

  /* ============================================================
     CART DRAWER (ds-cart-drawer)
     Slides in from the right, native <dialog> in the top layer.
     ============================================================ */
  .ds-cart-drawer {
    /* Reset native dialog chrome */
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-fg);
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100svh;
    inset: 0;
    /* Hidden by default — :modal styles take over when .showModal() is called */
    overflow: visible;
  }
  .ds-cart-drawer::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  /* The actual sliding panel — flush right, full height.
     IMPORTANT: panel sits at translateX(0) by default (visible position
     when the dialog is open). The slide-in is a one-shot @keyframes
     animation, NOT a CSS transition. Transitions re-fire on any style
     recalculation, and morphSection touching the section caused the
     panel to "close + reopen" mid-cart-update. Animations only play on
     first rule application, so morph touches don't replay them. */
  .ds-cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(440px, 92vw);
    height: 100svh;
    background: var(--color-bg-elev);
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transform: translateX(0);
  }
  /* Slide-in animation — strictly one-shot via the .is-opening class
     toggled by JS on DialogOpenEvent. The old version bound the
     animation to .ds-cart-drawer[open] .ds-cart-drawer__panel,
     which made the animation re-fire whenever morph touched the
     panel's attributes (even with hydration mode the morph's
     copyAttributes can re-evaluate the animation rule and replay
     the slide-in, producing a visible "close+reopen" flicker on
     every cart change). Gating on a JS-managed class means the
     animation runs ONLY on actual dialog-open. */
  @keyframes ds-cart-drawer-slide-in {
    from { transform: translateX(100%); }
    to   { transform: translateX(0); }
  }
  .ds-cart-drawer.is-opening .ds-cart-drawer__panel {
    animation: ds-cart-drawer-slide-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* DialogComponent.closeDialog() waits for animationend on the dialog
     before calling .close(). We give it a near-instant opacity tick so
     the close path resolves immediately — visible result: drawer just
     disappears (consistent with native <dialog> behavior). */
  @keyframes ds-cart-drawer-close-noop {
    to { opacity: 1; }
  }
  .ds-cart-drawer.dialog-closing {
    animation: ds-cart-drawer-close-noop 1ms forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-cart-drawer.is-opening .ds-cart-drawer__panel { animation: none; }
  }
  /* Head — Title + close X */
  .ds-cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .ds-cart-drawer__title {
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
  }
  .ds-cart-drawer__title-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    margin-left: 6px;
    color: var(--color-fg-muted);
  }
  .ds-cart-drawer__close {
    background: transparent;
    border: 0;
    /* Safari renders <button> with a native UA outline + subtle inner
       border by default; both stay visible after a click until blur,
       producing the "black inner stroke" the user sees underneath
       the grey hover overlay. appearance: none neutralizes the UA
       chrome; outline + box-shadow: none kills any inherited focus
       ring. Keyboard accessibility is preserved via :focus-visible
       below. */
    appearance: none;
    -webkit-appearance: none;
    outline: 0;
    box-shadow: none;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: var(--color-fg);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-cart-drawer__close:hover,
  .ds-cart-drawer__close:focus {
    background: var(--color-border);
    outline: 0;
    box-shadow: none;
  }
  /* Keyboard-only focus ring — preserves a11y without leaking into
     mouse interactions. */
  .ds-cart-drawer__close:focus-visible {
    outline: 2px solid var(--color-accent, #ff4d1f);
    outline-offset: -2px;
  }

  /* Loading bar — thin orange shimmer that slides L→R across the top
     edge of the drawer body while /cart/add.js is in flight. Hidden
     by default (opacity 0); the .is-loading class on
     <cart-drawer-component> reveals it AND starts the animation.
     Paused-by-default means we don't pay animation cost when idle.
     Cleared by the `cart:update` event after Horizon morphs in the
     fresh items, OR by a 5s safety timer if the request fails. */
  .ds-cart-drawer__loading {
    position: relative;
    height: 2px;
    background: var(--color-border);
    overflow: hidden;
    opacity: 0;
    transition: opacity 120ms var(--ease, ease);
    pointer-events: none;
    flex-shrink: 0;
  }
  cart-drawer-component.is-loading .ds-cart-drawer__loading {
    opacity: 1;
  }
  .ds-cart-drawer__loading-bar {
    position: absolute;
    inset: 0;
    background: var(--color-accent, #ff4d1f);
    transform: translateX(-100%);
    animation: ds-cart-loading 900ms cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-play-state: paused;
  }
  cart-drawer-component.is-loading .ds-cart-drawer__loading-bar {
    animation-play-state: running;
  }
  @keyframes ds-cart-loading {
    0%   { transform: translateX(-100%); }
    50%  { transform: translateX(20%); }
    100% { transform: translateX(110%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-cart-drawer__loading-bar {
      animation: none;
      transform: none;
      opacity: 0.6;
    }
  }

  /* Optimistic line-item skeleton — injected by the ATC submit
     handler with real title + thumbnail from the source form's
     data-skeleton-* attrs, then auto-removed when Horizon morphs
     the fresh cart HTML in (the new HTML doesn't contain
     [data-cart-skeleton], so it gets diffed out). Matches the
     visual structure of a real .ds-cart__item so the transition
     reads as "this exact item filled in" rather than "fake
     placeholder swapped for a real thing". */
  .ds-cart__skeleton {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    align-items: start;
    animation: ds-cart-skeleton-in 200ms ease-out;
  }
  .ds-cart__skeleton-media {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
    width: 96px;
  }
  .ds-cart__skeleton-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Faintly desaturated so the eye reads it as "in progress" even
       though it's the real image. */
    opacity: 0.7;
  }
  .ds-cart__skeleton-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 96px;
  }
  .ds-cart__skeleton-title {
    font-size: 14px;
    color: var(--color-fg);
    font-weight: 500;
    line-height: 1.3;
  }
  .ds-cart__skeleton-status {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent, #ff4d1f);
    animation: ds-cart-skeleton-pulse 1s ease-in-out infinite;
  }
  @keyframes ds-cart-skeleton-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ds-cart-skeleton-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-cart__skeleton { animation: none; }
    .ds-cart__skeleton-status { animation: none; opacity: 0.85; }
  }

  /* Body: scrollable area (items + upsell) + pinned summary footer */
  .ds-cart-drawer__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  /* The new shared scrollable wrapper — holds both items and upsell so
     when the cart has 2+ items, the area dedicated to them isn't
     squeezed by the upsell + summary growing alongside. Everything
     above the summary scrolls together; summary stays pinned below. */
  .ds-cart__scrollable {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    /* Subtle inner padding so items / upsell don't kiss the panel
       edges. Each inner snippet (items-wrap, upsell) handles its own
       horizontal/vertical padding for its content rhythm. */
  }
  .ds-cart__items-wrap {
    /* No longer the scrollable element — its parent
       .ds-cart__scrollable handles that. Just keeps its content
       padding for breathing room. */
    padding: var(--space-5);
  }

  /* When the wrapper contains the empty state, zero its vertical
     padding (no gap above the headline) but KEEP the horizontal
     24px so the empty content's left + right edges align with the
     cart header's "CART" label and "X" close button (both of which
     sit inside the drawer head's var(--space-5) = 24px padding).
     The empty state's own padding handles only vertical spacing
     below — that way there's no chance of double-padding making
     the content more inset than the header. */
  .ds-cart__items-wrap--empty {
    padding: 0 var(--space-5);
  }

  /* Empty state v5 — Drake's / ALD pattern. Every vertical band
     holds real content: editorial lede → featured product card
     (visual anchor) → category nav → trust+wordmark dock. No band
     is decoration alone. Horizontal alignment is governed entirely
     by the .ds-cart__items-wrap--empty parent above — this rule
     only deals with vertical breathing room and stacking. */
  .ds-cart__empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: var(--space-4) 0 var(--space-5);
    gap: var(--space-4);
  }

  /* Editorial lede — replaces the ghosted "EMPTY." anchor with
     copy that has voice + hierarchy. Two-line headline + one-line
     subcopy. Brand voice doing the visual weight work that the
     previous ghosted typography couldn't. */
  .ds-cart__empty-lede {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-cart__empty-headline {
    font-family: var(--font-paragraph--family, inherit);
    font-size: clamp(26px, 7vw, 36px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0;
  }
  .ds-cart__empty-subcopy {
    font-family: var(--font-paragraph--family, inherit);
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-fg-muted);
    margin: 0;
  }

  /* Featured product card — the centerpiece. 1:1 image; title +
     price stacked; eyebrow trust line; primary CTA.
       Desktop: image full-width on top, body (meta + button)
                stacked below — title row spans full card width.
       Mobile:  image fixed 140×140 square on the left, body in
                the right column with explicit 140px card height
                so the whole thing reads compact + balanced. Body
                content compresses (title clamps to 2 lines,
                tighter padding) to fit inside the image height. */
  .ds-cart__empty-feature {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    width: 100%; /* explicit so it always spans full drawer */
  }
  .ds-cart__empty-feature-media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-bg);
    width: 100%;
  }
  .ds-cart__empty-feature-img,
  .ds-cart__empty-feature-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--color-bg);
  }
  /* Body wraps meta + button so they can move as a unit when the
     card flips to horizontal on mobile. On desktop it's a flex
     column that stretches to the card width. */
  .ds-cart__empty-feature-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }
  .ds-cart__empty-feature-meta {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--color-border);
  }
  /* Title row spans full meta width — title link grows, price
     pinned right via justify-content: space-between. */
  .ds-cart__empty-feature-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
  }
  .ds-cart__empty-feature-title-link {
    color: inherit;
    text-decoration: none;
    min-width: 0;
    flex: 1;
  }
  .ds-cart__empty-feature-title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-fg);
  }
  .ds-cart__empty-feature-price {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-fg);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .ds-cart__empty-feature-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  /* Form wrapper — pass-through container for the AJAX add. */
  .ds-cart__empty-feature-form {
    display: block;
    width: 100%;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  /* CTA button — full-width inside its container. display:flex
     (not inline-flex) so the width:100% reliably takes effect
     across browsers including Safari which sometimes refuses to
     stretch inline-flex elements. */
  .ds-cart__empty-feature-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-top: 1px solid var(--color-border);
  }
  /* When the form wraps the button, the form already has the
     border-top, so suppress the inner button's. */
  .ds-cart__empty-feature-form .ds-cart__empty-feature-btn {
    border-top: 0;
  }

  /* Categories section — small label + the three outline buttons.
     Label gives the buttons context as secondary navigation
     instead of competing with the featured CTA above. */
  .ds-cart__empty-cats-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-cart__empty-cats-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    opacity: 0.7;
  }

  /* Trust + wordmark dock — pinned to the bottom via margin-top:
     auto. The trust line gives the wordmark a reason to be there
     (brand signs off on a promise) instead of floating alone. */
  .ds-cart__empty-dock {
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .ds-cart__empty-trust {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .ds-cart__empty-mark {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg);
    opacity: 0.65;
  }

  /* Mobile (<= 640px) — featured product card flips to side-by-
     side AND is pinned at a fixed 140px tall. Image stays a 1:1
     square (140×140) by both width AND height being explicit, so
     it doesn't get stretched by the body column's content height.
     Body content compresses to fit (title clamps to 2 lines max,
     tighter padding, smaller eyebrow). Result: a compact 140-tall
     rectangle that reads like a beefier cart line item. */
  @media (max-width: 640px) {
    .ds-cart__empty {
      /* Horizontal alignment delegated to .ds-cart__items-wrap--empty
         (uses var(--space-5) to match the header's padding). This
         rule only sets vertical breathing — tighter on mobile. */
      padding: var(--space-3) 0 var(--space-4);
      gap: var(--space-3);
    }
    .ds-cart__empty-headline {
      font-size: 24px;
    }
    .ds-cart__empty-subcopy {
      font-size: 13px;
    }

    .ds-cart__empty-feature {
      flex-direction: row;
      height: 140px; /* pins the card */
      overflow: hidden; /* belt-and-suspenders sub-pixel clip */
    }
    .ds-cart__empty-feature-media {
      width: 140px;
      /* height: 100% (= card interior height after border-box's 1px
         top/bottom borders are subtracted) instead of an explicit
         140px. Explicit 140 overflowed the card's 138 interior by
         2px, pushing the image's bottom edge 1px below the body
         column's bottom and causing the misalignment the user saw. */
      height: 100%;
      flex-shrink: 0;
    }
    .ds-cart__empty-feature-body {
      flex: 1;
      height: 100%;
      border-left: 1px solid var(--color-border);
    }
    .ds-cart__empty-feature-meta {
      border-top: 0;
      flex: 1;
      padding: var(--space-3);
      min-height: 0;
      overflow: hidden;
    }
    /* Title row stacks vertically on mobile so a long title +
       price don't collide in the narrow right column. */
    .ds-cart__empty-feature-title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .ds-cart__empty-feature-title {
      font-size: 14px;
      line-height: 1.2;
      /* Clamp to 2 lines max — prevents long product names from
         overflowing the 140px-tall card. */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ds-cart__empty-feature-price {
      font-size: 13px;
    }
    .ds-cart__empty-feature-eyebrow {
      font-size: 9px;
      letter-spacing: 0.1em;
    }
    /* Explicit height overriding .ds-btn--lg's vertical padding —
       the base class applies 20px top + 20px bottom + ~17px text,
       which adds up to ~57px and was pushing the button's bottom
       edge past the 140px-tall image on the left. Forcing exact
       48px keeps the card a true rectangle with image + body
       bottoms flush. min-height: 0 stops the inherited min-height
       from fighting the explicit height. */
    .ds-cart__empty-feature-btn {
      height: 48px;
      min-height: 0;
      padding: 0 var(--space-4);
      font-size: 12px;
    }

    .ds-cart__empty-cats-section {
      gap: var(--space-2);
    }
    .ds-cart__empty-cat {
      padding: 11px 16px;
    }
    .ds-cart__empty-dock {
      padding-top: var(--space-3);
    }
  }
  /* Category buttons — outline by default, fill orange on hover/
     focus/tap. Stretch to full container width so they align with
     the featured card and dock above/below, edge-to-edge across
     the drawer's internal padding. */
  .ds-cart__empty-cats {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .ds-cart__empty-cat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 18px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .ds-cart__empty-cat-arrow {
    color: var(--color-fg-muted);
    transition: color var(--t-fast) var(--ease);
  }
  .ds-cart__empty-cat:hover,
  .ds-cart__empty-cat:focus-visible,
  .ds-cart__empty-cat:active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-background);
    outline: 0;
  }
  .ds-cart__empty-cat:hover .ds-cart__empty-cat-arrow,
  .ds-cart__empty-cat:focus-visible .ds-cart__empty-cat-arrow,
  .ds-cart__empty-cat:active .ds-cart__empty-cat-arrow {
    color: var(--color-background);
  }

  /* Items list */
  .ds-cart__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ds-cart__item {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: var(--space-4);
    align-items: start;
  }
  .ds-cart__item-media {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
    display: block;
    width: 96px;
  }
  .ds-cart__item-img,
  .ds-cart__item-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--color-bg);
  }
  .ds-cart__item-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* Consistent 6px gap between every stacked element. Previous
       version mixed 2px flex gap with 4px / 6px margin-tops on some
       children — produced an uneven vertical rhythm that read as
       awkward against the (now bigger) image. */
    gap: 6px;
  }
  .ds-cart__item-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
    line-height: 1.3;
  }
  .ds-cart__item-title:hover { color: var(--color-accent); }
  /* Product type — visually marked as a metadata tag, not body text.
     Bordered pill with align-self: flex-start so it hugs its content
     instead of stretching across the info column. */
  .ds-cart__item-cat {
    align-self: flex-start;
    display: inline-block;
    padding: 2px 7px;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  /* Selected variant — kept muted and small. The cart already gets
     its hierarchy from the PLUGIN pill above and the underlined
     REMOVE action below; promoting Commercial to body weight made it
     compete with the title for attention. Lighter treatment lets the
     three-line info column read as a clean descending hierarchy. */
  .ds-cart__item-variant {
    font-size: 12px;
    color: var(--color-fg-muted);
  }
  .ds-cart__item-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: 2px;
  }
  /* Remove action — underlined so it's obviously interactive, distinct
     from the descriptive labels above (which are static text). Accent
     on hover gives a brand-correct interactive feel. */
  .ds-cart__item-remove {
    background: transparent;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-cart__item-remove:hover { color: var(--color-accent); }
  .ds-cart__item-price {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-fg);
    text-align: right;
    white-space: nowrap;
  }
  .ds-cart__item-price-strike {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    color: var(--color-fg-muted);
  }
  .ds-cart__item-error {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-sale, #ff4d1f);
    padding-top: 4px;
  }
  .ds-cart__item-error.hidden { display: none; }

  /* Tier upsell — rendered inside .ds-cart__item as a full-width row
     below the item content (spans all 3 grid columns). Visible only
     when the cart item has a higher-priced available variant. Click
     swaps the line item for the upgrade tier via Cart Ajax API.

     Styling matches the cart's existing mono-caps actions ("REMOVE",
     "PLUGIN" type tags, etc.) — single font family + casing + size
     so the upsell reads as part of the cart's visual rhythm rather
     than a foreign element. Left-aligned label, right-aligned diff. */
  .ds-cart__upsell {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 12px 14px;
    background: rgba(255, 77, 31, 0.06);
    border: 1px dashed var(--color-accent);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: left;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-cart__upsell:hover {
    background: rgba(255, 77, 31, 0.14);
  }
  .ds-cart__upsell-text {
    color: var(--color-fg);
  }
  .ds-cart__upsell-diff {
    color: var(--color-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  /* Loading state — set by JS during the /cart/change → /cart/add
     round-trip so the user gets feedback that the click registered. */
  .ds-cart__upsell[data-loading] {
    cursor: wait;
    opacity: 0.55;
    pointer-events: none;
  }
  .ds-cart__upsell[data-loading] .ds-cart__upsell-text::after {
    content: " — updating…";
    color: var(--color-fg-muted);
  }

  /* Summary footer */
  .ds-cart__summary {
    padding: var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex-shrink: 0;
    background: var(--color-bg-elev);
  }
  .ds-cart__summary-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ds-cart__sub-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .ds-cart__sub-label { color: var(--color-fg-muted); }
  .ds-cart__sub-value { color: var(--color-fg); }
  .ds-cart__sub-row--discount .ds-cart__sub-value { color: var(--color-accent); }
  /* Border + spacing only when Total sits below subtotal/discount
     rows — when Total is the only row (no cart-level discount),
     the divider would be a floating line above the very first
     line of content. :not(:first-child) keeps the visual
     separation when needed and drops it cleanly when not. */
  .ds-cart__sub-row--total {
    font-size: 16px;
  }
  .ds-cart__sub-row--total:not(:first-child) {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-2);
  }
  .ds-cart__sub-row--total .ds-cart__sub-label,
  .ds-cart__sub-row--total .ds-cart__sub-value {
    color: var(--color-fg);
    font-weight: 500;
  }
  .ds-cart__checkout-form { margin: 0; }
  .ds-cart__checkout-btn { width: 100%; }

  /* Accelerated checkout buttons (Shop Pay, PayPal, Apple Pay, Google
     Pay) — Shopify renders its own <shop-pay-button> web component
     and friends inside this wrapper. We:
       1) give them breathing room from our Checkout button,
       2) force full width to match the typographic rhythm.
     Shopify ships these buttons unstyled with low contrast on dark
     backgrounds, so we also bump min-height + reset rounding for
     our brutalist square aesthetic. */
  .ds-cart__express {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-cart__express shop-pay-button,
  .ds-cart__express [role="button"],
  .ds-cart__express > * {
    width: 100% !important;
    min-height: 48px;
    border-radius: 0 !important;
  }
  .ds-cart__express shop-pay-button {
    --shop-pay-button-border-radius: 0;
  }

  /* Mobile: minimum-intervention layout — just force the
     container itself to lay out as a single column. Earlier
     attempts to target every Shopify wrapper class were either
     ineffective (Shopify-injected styles winning specificity) or
     destabilizing (margin/flex resets cascading where they
     shouldn't). We'll iterate this once we can inspect the actual
     rendered express markup on the dev store. */
  @media (max-width: 600px) {
    .ds-cart__express {
      gap: var(--space-2);
    }
  }

  /* License-terms acknowledgment link in the cart note. Same muted
     mono treatment as the surrounding tax/download lines, with a
     subtle underline so it reads as clickable without shouting. */
  .ds-cart__note-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-cart__note-link:hover {
    color: var(--color-fg);
  }

  /* Cart-footer trust line — tax / delivery / license link as a
     wrapping single-line flex row. Switched from three <br>-
     separated lines (~60px tall) to one wrapping line (~14px on
     desktop, ~28px on narrow mobile) to free up vertical space
     above the checkout buttons. */
  .ds-cart__note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0;
    line-height: 1.5;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .ds-cart__note-sep {
    opacity: 0.6;
  }

  /* ---- Cart upsell — "Pairs well with" ----
     Sits between the items list and the summary footer. Inside the
     scrollable body so it scrolls with the items rather than stealing
     space from the sticky checkout. */
  .ds-cart-upsell {
    flex-shrink: 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elev);
  }
  .ds-cart-upsell__head {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
  }
  .ds-cart-upsell__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-cart-upsell__item {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }
  .ds-cart-upsell__item-media {
    display: block;
    aspect-ratio: 1 / 1;
    width: 48px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .ds-cart-upsell__item-img,
  .ds-cart-upsell__item-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ds-cart-upsell__item-info {
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .ds-cart-upsell__item-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-cart-upsell__item-info:hover .ds-cart-upsell__item-title {
    color: var(--color-accent);
  }
  .ds-cart-upsell__item-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-top: 2px;
    display: flex;
    align-items: baseline;
    gap: 4px;
    overflow: hidden;
    white-space: nowrap;
  }
  .ds-cart-upsell__item-cat {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ds-cart-upsell__item-price {
    color: var(--color-fg);
    flex-shrink: 0;
  }
  .ds-cart-upsell__add-form { display: contents; }
  .ds-cart-upsell__add {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 10px;
    cursor: pointer;
    text-decoration: none;
    border-radius: 0;
    transition:
      background var(--t-fast) var(--ease),
      color      var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
    white-space: nowrap;
  }
  .ds-cart-upsell__add:hover {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }

  /* Small phones: drawer takes full width */
  @media (max-width: 480px) {
    .ds-cart-drawer__panel {
      width: 100vw;
    }
    .ds-cart__items-wrap,
    .ds-cart__summary,
    .ds-cart-drawer__head {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }

  /* ============================================================
     SEARCH MODAL (ds-search-modal)
     Full-width dropdown anchored beneath the header bar.
     The native <dialog> renders in the top layer, so we just pin it
     with `inset` to slot directly under the sticky header — header
     stays visible above, dropdown spans the full viewport width.
     ============================================================ */
  .ds-search-modal { display: contents; }
  .ds-search-modal__dialog {
    /* Native <dialog> defaults to margin:auto centering — beat it with
       explicit position + size + zero margin. Important note: some
       browsers honor `margin: 0` only on `position: fixed`, so we set
       both explicitly (top-layer dialogs are positioned by the browser
       but we re-pin them via inset). */
    position: fixed;
    margin: 0 !important;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
    /* --ds-search-top is updated by JS below to track the live bottom
       edge of the header (handles announce bar + scroll states). */
    top: var(--ds-search-top, 64px);
    left: 0;
    right: 0;
    bottom: auto;
    width: 100vw !important;
    max-width: none !important;
    max-height: calc(100vh - var(--ds-search-top, 64px));
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }
  /* Transparent backdrop — we don't want to dim the header. The dropdown
     panel itself is dark; the page below remains visible as context. */
  .ds-search-modal__dialog::backdrop {
    background: transparent;
  }
  /* Slide-down entrance — @starting-style is the modern way to animate
     an element from display:none → display:block (which transitions
     normally can't catch). */
  .ds-search-modal__dialog[open] {
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity   180ms ease;
    @starting-style {
      transform: translateY(-16px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-search-modal__dialog[open] {
      transition: none;
      @starting-style { transform: none; opacity: 1; }
    }
  }
  .ds-search-modal__panel {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - var(--ds-search-top, 64px));
    min-height: 0;
    width: 100%;
    /* Span full viewport width — inner blocks use --pad-x for their own
       gutters, matching the header's padding so input/results align with
       the logo + nav above them. */
  }
  .ds-search-modal__form {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    margin: 0;
  }

  /* Input bar (top) — horizontal padding matches the header's --pad-x
     so the search icon lines up with the logo above it. */
  .ds-search-modal__inputbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--pad-x);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .ds-search-modal__icon {
    color: var(--color-fg-muted);
    flex-shrink: 0;
  }
  .ds-search-modal__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 6px 0;
    outline: none;
  }
  .ds-search-modal__input::placeholder {
    color: var(--color-fg-faint);
    font-weight: 400;
  }
  /* Hide native search cancel button (Safari) — we use our own */
  .ds-search-modal__input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .ds-search-modal__reset {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .ds-search-modal__reset:hover { color: var(--color-fg); border-color: var(--color-fg); }
  .ds-search-modal__close {
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-search-modal__close:hover { background: var(--color-border); }

  /* Body: 2-column on desktop (sidebar + results), single column on mobile */
  .ds-search-modal__body {
    display: grid;
    grid-template-columns: 280px 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* Sidebar (desktop only) */
  .ds-search-modal__sidebar {
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    padding: var(--space-5) var(--pad-x);
    min-height: 0;
  }
  .ds-search-modal__sidebar-group + .ds-search-modal__sidebar-group {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .ds-search-modal__sidebar-head {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-3);
  }
  .ds-search-modal__sidebar-link {
    display: block;
    font-size: 14px;
    color: var(--color-fg);
    text-decoration: none;
    padding: 6px 0;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-search-modal__sidebar-link:hover { color: var(--color-accent); }

  /* Recent searches group — head has an inline "Clear" action */
  .ds-search-modal__sidebar-head--with-action {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .ds-search-modal__sidebar-clear {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
    transition: color var(--t-fast) var(--ease);
  }
  .ds-search-modal__sidebar-clear:hover { color: var(--color-fg-muted); }

  .ds-search-modal__sidebar-recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ds-search-modal__sidebar-recent-link {
    background: transparent;
    border: 0;
    padding: 4px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
    width: 100%;
    font-family: inherit;
    font-size: 13px;
    color: var(--color-fg-muted);
    transition: color var(--t-fast) var(--ease);
  }
  .ds-search-modal__sidebar-recent-link span:first-child {
    color: var(--color-fg-faint);
    font-size: 11px;
    flex-shrink: 0;
  }
  .ds-search-modal__sidebar-recent-link:hover {
    color: var(--color-fg);
  }
  .ds-search-modal__sidebar-recent-link:hover span:first-child {
    color: var(--color-accent);
  }

  /* Results column (right on desktop, full on mobile) */
  .ds-search-modal__results {
    overflow-y: auto;
    min-height: 0;
    padding: 0;
  }

  /* Desktop (sidebar visible): tighten padding near the divider so the
     gap between sidebar text and results text isn't a giant 2× --pad-x
     dead zone on big screens. Outer edges (sidebar-left + results-right)
     still align with the header's --pad-x. */
  @media (min-width: 901px) {
    .ds-search-modal__sidebar {
      padding-right: var(--space-5);
    }
    .ds-search-modal__body .ds-search-results__group-head,
    .ds-search-modal__body .ds-search-results__product-link,
    .ds-search-modal__body .ds-search-results__suggestion-link,
    .ds-search-modal__body .ds-search-results__collection-link,
    .ds-search-modal__body .ds-search-results__empty,
    .ds-search-modal__body .ds-search-results--idle {
      padding-left: var(--space-5);
    }
  }

  /* Mobile: collapse to single-column flow (sidebar hidden) */
  @media (max-width: 900px) {
    .ds-search-modal__body {
      grid-template-columns: 1fr;
    }
    .ds-search-modal__sidebar { display: none; }
  }

  /* Footer */
  .ds-search-modal__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--pad-x);
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .ds-search-modal__viewall {
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    padding: 6px 0;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-search-modal__viewall:hover { color: var(--color-accent); }
  .ds-search-modal__hint {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-fg-faint);
    text-transform: uppercase;
  }
  .ds-search-modal__hint kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--color-border);
    color: var(--color-fg);
    padding: 2px 6px;
    border-radius: 2px;
    margin-right: 4px;
  }

  /* --- Inner result groups (rendered by ds-predictive-search section) --- */
  .ds-search-results {
    display: flex;
    flex-direction: column;
  }
  /* Reset any vendor styles leaking from Horizon's base.css for items
     that still carry .predictive-search-results__card (needed for the
     component's keyboard nav). We strip transitions, hover transforms,
     shadows, and any unintended borders. */
  .ds-search-modal .predictive-search-results__card,
  .ds-search-modal .predictive-search-results__card:hover {
    transition: none !important;
    transform: none !important;
    box-shadow: none !important;
    border: 0 !important;
    background: transparent !important;
    will-change: auto !important;
  }
  /* Same for the list/wrapper containers — strip any vendor padding/spacing */
  .ds-search-modal .predictive-search-results__list,
  .ds-search-modal .predictive-search-results__wrapper-queries,
  .ds-search-modal .predictive-search-results__wrapper-products {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .ds-search-results--idle {
    padding: var(--space-7) var(--pad-x);
    align-items: center;
    text-align: center;
  }
  .ds-search-results__hint {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
    margin: 0;
  }
  .ds-search-results__empty {
    padding: var(--space-6) var(--pad-x);
    text-align: center;
  }
  .ds-search-results__empty-text {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    margin: 0;
  }
  .ds-search-results__group {
    border-top: 1px solid var(--color-border);
  }
  .ds-search-results__group:first-child { border-top: 0; }
  .ds-search-results__group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--pad-x);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    background: var(--color-bg);
  }
  .ds-search-results__group-count {
    color: var(--color-fg-faint);
    letter-spacing: 0;
  }
  .ds-search-results__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* Product result row */
  .ds-search-results__product-link {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--pad-x);
    text-decoration: none;
    color: inherit;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-search-results__product:hover .ds-search-results__product-link,
  .ds-search-results__product:focus-within .ds-search-results__product-link,
  .ds-search-results__product.is-active .ds-search-results__product-link {
    background: var(--color-border);
  }
  .ds-search-results__product-media {
    aspect-ratio: 1 / 1;
    width: 48px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .ds-search-results__product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ds-search-results__product-info { min-width: 0; }
  .ds-search-results__product-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-fg);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ds-search-results__product-cat {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-top: 2px;
  }
  .ds-search-results__product-price {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg);
    white-space: nowrap;
  }

  /* Suggestion + collection rows */
  .ds-search-results__suggestion-link,
  .ds-search-results__collection-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--pad-x);
    text-decoration: none;
    color: var(--color-fg);
    font-size: 13px;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-search-results__suggestion:hover .ds-search-results__suggestion-link,
  .ds-search-results__collection:hover .ds-search-results__collection-link {
    background: var(--color-border);
  }
  .ds-search-results__collection-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* No mobile-specific overrides needed — all inner blocks use --pad-x
     which already clamps from 16px on phones up to 80px on big monitors. */
{% endstyle %}

