<script>
  // Mobile menu drawer toggle
  (function () {
    var toggles = document.querySelectorAll('[data-ds-menu-toggle]');
    var drawer = document.querySelector('[data-ds-drawer]');
    if (!drawer || toggles.length === 0) return;
    toggles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var isOpen = drawer.classList.toggle('is-open');
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        toggles.forEach(function (t) { t.setAttribute('aria-expanded', isOpen ? 'true' : 'false'); });
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
    });
  })();

  // Search dropdown positioning — keep --ds-search-top in sync with the
  // live bottom edge of the header. This accounts for:
  //   • Announcement bar above the header (only visible at top of scroll)
  //   • Sticky header (which stays at top when scrolled)
  // So the dropdown always slots right under whatever's visible.
  (function () {
    var header = document.querySelector('.ds-header');
    if (!header) return;

    var ticking = false;
    function syncTop() {
      var bottom = Math.max(0, header.getBoundingClientRect().bottom);
      document.documentElement.style.setProperty('--ds-search-top', bottom + 'px');
      ticking = false;
    }
    function onScrollOrResize() {
      if (!ticking) {
        requestAnimationFrame(syncTop);
        ticking = true;
      }
    }

    syncTop();
    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize, { passive: true });
  })();

  // iOS Safari sticky-header URL-bar-collapse workaround.
  //
  // Symptom: on iPhone, a fast drag on the before/after slider can make
  // the entire page header vanish.  The header doesn't come back until
  // the user scrolls, at which point it snaps back into place.
  //
  // Cause: iOS Safari interprets rapid touch movement as scroll-like
  // input and starts collapsing its URL bar, which resizes the visual
  // viewport.  `position: sticky` elements on iOS can get stuck above
  // the new viewport during the transition — visually they're scrolled
  // off-screen even though the page hasn't scrolled.  The next real
  // scroll event forces a layout pass and the header snaps back.
  // `backdrop-filter: blur(...)` on the sticky header makes this worse
  // because it creates a containing block that interacts badly with
  // sticky positioning on iOS Safari specifically.
  //
  // Fix: listen for visualViewport.resize (fires when the URL bar
  // transitions in/out) and force the sticky header to re-evaluate
  // its position by nudging `top` to a fractional pixel and back.
  // Reading offsetHeight alone isn't enough on iOS — we need an actual
  // style write to trigger the sticky recalc.  The 0.001px change is
  // invisible to the user.
  (function () {
    if (!window.visualViewport) return;
    var stickyHeader = document.querySelector('.ds-header--sticky');
    if (!stickyHeader) return;

    var rafId = null;
    function forceStickyRecalc() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(function () {
        rafId = null;
        stickyHeader.style.top = '0.001px';
        requestAnimationFrame(function () {
          stickyHeader.style.top = '';
        });
      });
    }
    window.visualViewport.addEventListener('resize', forceStickyRecalc);
  })();

  // Recent searches — track the last N queries in localStorage and
  // render them in the sidebar of the search dropdown. Stored under a
  // namespaced key so it doesn't collide with other Shopify themes.
  (function () {
    var modal       = document.getElementById('ds-search-modal');
    if (!modal) return;
    var dialog      = modal.querySelector('dialog');
    var form        = modal.querySelector('.ds-search-modal__form');
    var input       = modal.querySelector('.ds-search-modal__input');
    var group       = modal.querySelector('[data-ds-recent-group]');
    var list        = modal.querySelector('[data-ds-recent-list]');
    var clearBtn    = modal.querySelector('[data-ds-recent-clear]');
    if (!form || !input || !group || !list || !clearBtn) return;

    var STORAGE_KEY = 'ds:recent-searches';
    var MAX_ENTRIES = 6;

    function read() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed.filter(function (q) { return typeof q === 'string' && q.length > 0; }) : [];
      } catch (e) {
        return [];
      }
    }
    function write(arr) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); } catch (e) { /* quota or blocked */ }
    }
    function add(query) {
      query = (query || '').trim();
      if (!query) return;
      var arr = read();
      // de-dupe case-insensitively, keep newest first
      arr = arr.filter(function (q) { return q.toLowerCase() !== query.toLowerCase(); });
      arr.unshift(query);
      if (arr.length > MAX_ENTRIES) arr = arr.slice(0, MAX_ENTRIES);
      write(arr);
    }
    function render() {
      var arr = read();
      if (arr.length === 0) {
        group.hidden = true;
        list.innerHTML = '';
        return;
      }
      // Build LI list. Each item is a button that fills the search input
      // and triggers the predictive-search-component's own input handler.
      list.innerHTML = arr.map(function (q) {
        var safe = q.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        return '<li><button type="button" class="ds-search-modal__sidebar-recent-link" data-q="' + safe + '"><span aria-hidden="true">↗</span><span>' + safe + '</span></button></li>';
      }).join('');
      group.hidden = false;
    }

    // Re-render whenever the dialog opens, in case another tab added entries
    if (dialog) {
      dialog.addEventListener('toggle', function () {
        if (dialog.open) render();
      });
    }
    // Initial render on page load (in case dialog is auto-opened or pre-rendered)
    render();

    // Save on form submit (when user hits enter or clicks "View all results")
    form.addEventListener('submit', function () {
      add(input.value);
    });

    // Clicking a recent entry: fill the input and dispatch an input event
    // so <predictive-search-component> picks it up via its `on:input="/search"`
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-q]');
      if (!btn) return;
      e.preventDefault();
      input.value = btn.getAttribute('data-q') || '';
      input.focus();
      input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText' }));
    });

    // Clear-all button
    clearBtn.addEventListener('click', function (e) {
      e.preventDefault();
      write([]);
      render();
    });
  })();

  // Drawer slide-in animation gate — adds .is-opening to the
  // <dialog.ds-cart-drawer> the moment the dialog actually opens
  // (DialogOpenEvent), removes it on animationend. The CSS bound
  // the slide-in to .ds-cart-drawer.is-opening (not .ds-cart-drawer
  // [open]) so the animation only runs on real opens — morph
  // touching the panel's attributes during a cart update no longer
  // re-evaluates the keyframe rule and re-plays the slide. Fixes
  // the close+reopen flicker on every add/remove/qty-change.
  (function () {
    document.addEventListener('dialog:open', function (e) {
      var dialog = e.target && e.target.querySelector
        ? e.target.querySelector('.ds-cart-drawer')
        : null;
      if (!dialog) return;
      dialog.classList.add('is-opening');
      // Pure CSS animationend cleanup. once:true so we don't pile
      // listeners across repeat opens.
      dialog.addEventListener('animationend', function () {
        dialog.classList.remove('is-opening');
      }, { once: true });
    });
  })();

  // Mobile quick-add bypass — iOS sticky-hover defeat.
  //
  // Even with all :hover rules on the button itself wrapped in
  // @media (hover: hover), iOS still defers the first tap on a
  // .ds-product-card__quick--add because the parent .ds-product-
  // card has a :hover rule (image swap, kept intentionally so the
  // hover feature still works on tap-outside-the-+). iOS treats any
  // ancestor :hover as grounds to defer descendant clicks.
  //
  // Workaround: capture touchend on the + button, confirm it was
  // a tap (not a scroll), preventDefault to cancel the deferred
  // click iOS would have fired later, and manually submit the
  // form. requestSubmit() preserves Horizon's product-form-component
  // submit-event listener; falls back to btn.click() on browsers
  // (older iOS Safari) that don't expose requestSubmit.
  (function () {
    if (!('ontouchstart' in window)) return;

    var startX = 0, startY = 0, startTime = 0;

    document.addEventListener('touchstart', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('.ds-product-card__quick--add');
      if (!btn) return;
      var touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;
      startTime = Date.now();
    }, { passive: true });

    document.addEventListener('touchend', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('.ds-product-card__quick--add');
      if (!btn) return;

      // Tap, not scroll/drag — finger moved < 10px in < 700ms.
      var touch = e.changedTouches[0];
      var dx = Math.abs(touch.clientX - startX);
      var dy = Math.abs(touch.clientY - startY);
      var dt = Date.now() - startTime;
      if (dx > 10 || dy > 10 || dt > 700) return;

      // Cancel the deferred click iOS would otherwise fire on the
      // next tap.
      e.preventDefault();

      var form = btn.closest('form');
      if (form && typeof form.requestSubmit === 'function') {
        form.requestSubmit(btn);
      } else if (form) {
        // Fallback: programmatic click on the submit button still
        // triggers the form's submit event (which product-form-
        // component is listening on).
        btn.click();
      }
    }, { passive: false });
  })();

  // Semi-eager cart drawer open + in-flight loading bar.
  //
  // <cart-drawer-component> normally opens AFTER /cart/add.js resolves
  // (~200-600ms of network). Opening it on the SAME tick as the click
  // felt premature — drawer appeared before the user perceived the
  // add as having happened. We hold for ~180ms so the open reads as a
  // RESULT of the click, not a side effect.
  //
  // If the AJAX is fast (<180ms) the native auto-open path runs first
  // and our timer is a no-op (showDialog is idempotent). If it's slow,
  // the drawer is already up by the time the response lands and the
  // cart contents morph in seamlessly.
  //
  // 180ms = within the "fast" perception band, longer than a single
  // paint cycle. Tune by editing OPEN_DELAY_MS if it still feels off.
  //
  // The .is-loading class shows a 2px orange shimmer bar at the top
  // of the body while we wait. It clears on `cart:update` (which
  // Horizon's <cart-items-component> dispatches after morphing in
  // the fresh items) or on `cart:error`, with a 5s safety timer as
  // belt-and-suspenders in case a network failure swallows both.
  (function () {
    var OPEN_DELAY_MS = 180;
    var SAFETY_TIMEOUT_MS = 5000;
    var safetyTimer = null;
    /* Flag set on each ATC submit, consumed by the cart:update
       listener to fire the bubble pulse. Gating on this flag
       (instead of pulsing on every cart:update) means removes,
       quantity changes, and post-checkout re-renders DON'T
       trigger an unwanted dance. */
    var pulseOnNextUpdate = false;

    function isAddToCartForm(form) {
      if (!form || !form.action) return false;
      return form.action.indexOf('/cart/add') !== -1;
    }
    function getDrawer() {
      return document.querySelector('cart-drawer-component');
    }
    function setLoading(on) {
      var drawer = getDrawer();
      if (!drawer) return;
      drawer.classList.toggle('is-loading', !!on);
    }
    function clearLoading() {
      if (safetyTimer) {
        window.clearTimeout(safetyTimer);
        safetyTimer = null;
      }
      setLoading(false);
    }

    // Optimistic skeleton: when the source form carries
    // data-skeleton-title + data-skeleton-image (set by all our ATC
    // forms via Liquid), render a placeholder line item at the top
    // of <cart-items-component> the instant we know an add is
    // happening. Horizon's morph removes it when fresh cart HTML
    // lands (the morphed-in HTML doesn't contain [data-cart-skeleton]
    // so it gets diffed out). Belt-and-suspenders clearSkeleton()
    // on cart:update / cart:error / safety timer too.
    function getSkeletonSource(form) {
      // Walk up to the <product-form-component> that wraps the form;
      // that's where Liquid emits data-skeleton-* (so the attrs are
      // available even if the user is mid-variant-change).
      var component = form.closest && form.closest('product-form-component');
      return component || null;
    }
    function buildSkeleton(source) {
      if (!source) return null;
      var title = source.getAttribute('data-skeleton-title');
      var image = source.getAttribute('data-skeleton-image');
      if (!title) return null;

      var skel = document.createElement('div');
      skel.setAttribute('data-cart-skeleton', '');
      skel.className = 'ds-cart__skeleton';
      skel.setAttribute('aria-hidden', 'true'); // visual-only; SR users get cart:update announcement

      var media = document.createElement('div');
      media.className = 'ds-cart__skeleton-media';
      if (image) {
        var img = document.createElement('img');
        img.src = image;
        img.alt = '';
        img.className = 'ds-cart__skeleton-img';
        media.appendChild(img);
      }
      skel.appendChild(media);

      var info = document.createElement('div');
      info.className = 'ds-cart__skeleton-info';
      var titleEl = document.createElement('div');
      titleEl.className = 'ds-cart__skeleton-title';
      titleEl.textContent = title;
      info.appendChild(titleEl);
      var status = document.createElement('div');
      status.className = 'ds-cart__skeleton-status';
      status.textContent = 'Adding…';
      info.appendChild(status);
      skel.appendChild(info);

      return skel;
    }
    function injectSkeleton(form) {
      var source = getSkeletonSource(form);
      var skel = buildSkeleton(source);
      if (!skel) return;

      var drawer = getDrawer();
      if (!drawer) return;
      var panel = drawer.querySelector('.ds-cart-drawer__panel');
      if (!panel) return;

      // Wipe any prior skeleton (rapid clicks).
      drawer.querySelectorAll('[data-cart-skeleton]').forEach(function (el) { el.remove(); });

      // Inject as a sibling of cart-items-component INSIDE the
      // panel — explicitly outside the morph target. cart-items-
      // component is what Horizon morphs on cart updates, and
      // putting the skeleton inside it (or worse, inside the items
      // <ul>) lets morphdom confuse skeleton elements with real
      // line items and produce ghost-row layouts. Living outside
      // the morph target means our cleanup logic is fully in
      // charge of when the skeleton disappears.
      var cartBody = panel.querySelector('cart-items-component');
      if (cartBody) {
        cartBody.parentNode.insertBefore(skel, cartBody);
      } else {
        panel.appendChild(skel);
      }
    }
    function clearSkeleton() {
      document.querySelectorAll('[data-cart-skeleton]').forEach(function (el) {
        el.remove();
      });
    }

    /* Trigger the .ds-header__cart-count bubble's scale-pulse
       animation. Called from the cart:update listener AFTER
       Horizon has morphed in the fresh count value, so the new
       number appears WITH the pulse rather than during it.

       The remove → reflow → add dance is required because the
       cart-count element gets re-rendered by morph on every
       cart:update — if .is-pulsing was on the previous DOM node
       it's gone from the new one, but we also want a fresh
       animation each time even on rapid adds where the node
       happens to persist. void offsetWidth forces a synchronous
       layout flush so the browser sees the class go away before
       it comes back. */
    function pulseCount() {
      var count = document.querySelector('.ds-header__cart-count');
      if (!count) return;
      count.classList.remove('is-pulsing');
      void count.offsetWidth;
      count.classList.add('is-pulsing');
    }

    document.addEventListener('submit', function (e) {
      if (!isAddToCartForm(e.target)) return;

      // Reset any stale safety timer from a prior in-flight add.
      if (safetyTimer) window.clearTimeout(safetyTimer);
      setLoading(true);
      injectSkeleton(e.target);
      pulseOnNextUpdate = true;
      safetyTimer = window.setTimeout(function () {
        clearLoading();
        clearSkeleton();
        pulseOnNextUpdate = false;
      }, SAFETY_TIMEOUT_MS);

      window.setTimeout(function () {
        var drawer = getDrawer();
        if (drawer && typeof drawer.open === 'function') {
          try { drawer.open(); } catch (_) { /* component not upgraded */ }
        }
      }, OPEN_DELAY_MS);
    }, true); // capture phase

    // Horizon dispatches `cart:update` after each successful morph
    // (assets/events.js → ThemeEvents.cartUpdate). That's our cue
    // that the items are now in the DOM and the bar can disappear.
    // Morph itself usually wipes the skeleton (it's not in the new
    // HTML), but explicit cleanup catches the edge case where
    // morphdom preserves an unmatched element by accident.
    document.addEventListener('cart:update', function () {
      clearLoading();
      clearSkeleton();
      if (pulseOnNextUpdate) {
        pulseOnNextUpdate = false;
        // requestAnimationFrame so the pulse runs AFTER morph has
        // settled the new bubble element into the DOM.
        window.requestAnimationFrame(pulseCount);
      }
    });

    // Belt-and-suspenders for failed adds — sold-out variant, gift
    // card limits, network drop. Horizon dispatches `cart:error`
    // from cart-items-component on these paths.
    document.addEventListener('cart:error', function () {
      clearLoading();
      clearSkeleton();
    });
  })();
</script>
