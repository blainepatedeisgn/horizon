{%- comment -%}
  sections/ds-license-terms.liquid — Disrupted Studio license page.

  Rendered on /pages/license via templates/page.license.json. Structure:
    1. Header (eyebrow, title, version pill + effective date)
    2. TL;DR (3 plain-language summary tiles)
    3. Tier comparison tables — one per product type (plugins, fonts,
       graphics, bundles)
    4. Numbered full terms (11-clause EULA minimum)
    5. Changelog at bottom

  --------------------------------------------------------------------
  VERSIONING

  Per Pangram Pangram convention, the license applicable to a given
  purchase is the version in effect at order time. Therefore:
    • Bump the version in the schema (or hardcoded below) on each change
    • Add a row to the Changelog section listing the date + what changed
    • NEVER delete prior versions — they apply to past orders

  Legal body text is intentionally in Liquid (not theme settings) so
  edits are version-controlled in git. Merchant-editable surface is just
  the header copy (eyebrow, title, version pill, intro paragraph).

  --------------------------------------------------------------------
  DRAFT — REVIEW BEFORE LAUNCH

  This is reasonable boilerplate for an indie digital-asset shop based
  on Studio 2am, Mass-Driver, Klim, and Creative Market common patterns.
  Before going live: have an attorney in your jurisdiction review it,
  especially the Governing law, Refund, and Warranty sections.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme
  assign version = section.settings.version | default: 'v1.1'
  assign version_date = section.settings.version_date | default: 'May 2026'
  assign eyebrow = section.settings.eyebrow | default: 'ASSET LICENSE'
  assign title = section.settings.title | default: 'License terms'
  assign intro = section.settings.intro | default: 'Plain-language summary first. Full numbered terms below. The version in effect at the time of your order is the one that applies to your purchase — see the changelog at the bottom for prior versions.'
-%}

<section class="ds-license color-{{ cs }}">
  <div class="ds-license__container">

    {%- comment -%} ============ HEADER ============ {%- endcomment -%}
    <header class="ds-license__header">
      <p class="ds-license__eyebrow ds-mono">[ {{ eyebrow }} ]</p>
      <h1 class="ds-license__title">{{ title }}</h1>
      <div class="ds-license__version">
        <span class="ds-license__version-pill ds-mono">{{ version }}</span>
        <span class="ds-license__version-date ds-mono">Effective {{ version_date }}</span>
      </div>
      <p class="ds-license__intro">{{ intro }}</p>
    </header>

    {%- comment -%} ============ TL;DR ============ {%- endcomment -%}
    <section class="ds-license__block" aria-labelledby="license-tldr">
      <h2 class="ds-license__block-title" id="license-tldr">
        <span class="ds-license__block-num ds-mono">01</span>
        TL;DR
      </h2>
      <div class="ds-license__tldr-grid">
        <div class="ds-license__tldr-card">
          <p class="ds-license__tldr-card-eyebrow ds-mono">[ PERSONAL ]</p>
          <ul class="ds-license__tldr-card-list">
            <li>Your own non-monetized work — hobby, learning, portfolio, art for yourself.</li>
            <li>Use, modify, combine for personal projects.</li>
            <li>NOT for client work, products you sell, paid ads, or anything that brings in money.</li>
          </ul>
        </div>
        <div class="ds-license__tldr-card">
          <p class="ds-license__tldr-card-eyebrow ds-mono">[ COMMERCIAL ]</p>
          <ul class="ds-license__tldr-card-list">
            <li>Client work, products you sell, agency work, paid ads, anything monetized.</li>
            <li>Full media rights — print, web, app, broadcast (per product type).</li>
            <li>Modify, combine, embed in your end products.</li>
          </ul>
        </div>
        <div class="ds-license__tldr-card">
          <p class="ds-license__tldr-card-eyebrow ds-mono">[ NEVER ]</p>
          <ul class="ds-license__tldr-card-list">
            <li>Redistribute or resell the source files.</li>
            <li>Train AI/ML models on what you buy.</li>
            <li>Transfer the license to another person or company.</li>
          </ul>
        </div>
      </div>
    </section>

    {%- comment -%} ============ TIER COMPARISON ============ {%- endcomment -%}
    <section class="ds-license__block" aria-labelledby="license-tiers">
      <h2 class="ds-license__block-title" id="license-tiers">
        <span class="ds-license__block-num ds-mono">02</span>
        Tiers by product type
      </h2>
      <p class="ds-license__block-intro">Two tiers — <strong>Personal</strong> for your own non-monetized work, <strong>Commercial</strong> for anything that brings in money (client work, products you sell, agency use, ads). The rights at each tier vary by what you're buying — plugins, fonts, and graphics each gate on different things.</p>

      <h3 class="ds-license__tier-heading ds-mono">[ PLUGINS — BACKLIT, PIXEL PERFECT, ETC. ]</h3>
      <div class="ds-license__tier-table">
        <div class="ds-license__tier-col">
          <h4 class="ds-license__tier-name">Personal</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Personal projects only</strong></li>
            <li>Hobby art, learning, portfolio, your own non-sale work</li>
            <li>1 designer · 2 devices</li>
            <li>Output may NOT be sold, monetized, or used in paid client work</li>
            <li>Lifetime updates within the major version</li>
          </ul>
        </div>
        <div class="ds-license__tier-col ds-license__tier-col--upsell">
          <h4 class="ds-license__tier-name">Commercial</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Client work + monetized output</strong></li>
            <li>Use in products you sell, ads, marketing, agency / business work</li>
            <li>1 designer · 2 devices (single seat)</li>
            <li>For 5+ seats or a whole studio, email for a custom Studio quote</li>
            <li>Lifetime updates within the major version</li>
          </ul>
        </div>
      </div>

      <h3 class="ds-license__tier-heading ds-mono">[ FONTS — NEUE PORTAL, RIVET MONO, ETC. ]</h3>
      <div class="ds-license__tier-table">
        <div class="ds-license__tier-col">
          <h4 class="ds-license__tier-name">Personal</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Personal projects only</strong></li>
            <li>Desktop installation, your own design work</li>
            <li>Embed in personal PDFs / static documents</li>
            <li>NOT for client work, branding, products for sale, paid advertising, or web embedding</li>
            <li>1 user · 1 device</li>
          </ul>
        </div>
        <div class="ds-license__tier-col ds-license__tier-col--upsell">
          <h4 class="ds-license__tier-name">Commercial</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Full commercial use — desktop, web, app, ePub, broadcast</strong></li>
            <li>Client logos, branding systems, products for sale, paid ads</li>
            <li>Self-hosted webfont (WOFF/WOFF2) — no pageview cap</li>
            <li>Embed in mobile and desktop apps you distribute</li>
            <li>Up to 5 employees / freelancers at one organization</li>
          </ul>
        </div>
      </div>

      <h3 class="ds-license__tier-heading ds-mono">[ GRAPHICS — CHROMA, BOTANIC, ARCADE, STARGAZER, ETC. ]</h3>
      <div class="ds-license__tier-table">
        <div class="ds-license__tier-col">
          <h4 class="ds-license__tier-name">Personal</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Personal projects only</strong></li>
            <li>Wallpapers, hobby art, learning, non-monetized social posts</li>
            <li>Modify, combine, recolor for personal use</li>
            <li>NOT for client work, products sold, paid ads, or any monetized output</li>
          </ul>
        </div>
        <div class="ds-license__tier-col ds-license__tier-col--upsell">
          <h4 class="ds-license__tier-name">Commercial</h4>
          <ul class="ds-license__tier-list">
            <li><strong>Up to 250,000 end products for sale</strong></li>
            <li>Use in client work, products you sell, marketing, paid ads</li>
            <li>Modify, combine, recolor, embed in larger compositions you sell</li>
            <li>May not redistribute the source assets as standalone files</li>
            <li>Sublicensing allowed only INSIDE your end product (not as a standalone asset)</li>
          </ul>
        </div>
      </div>

      <p class="ds-license__tier-note ds-mono">
        Bundles inherit the highest tier of any included product. The bundle's product page states which tier applies.
      </p>
    </section>

    {%- comment -%} ============ FULL TERMS ============ {%- endcomment -%}
    <section class="ds-license__block" aria-labelledby="license-full">
      <h2 class="ds-license__block-title" id="license-full">
        <span class="ds-license__block-num ds-mono">03</span>
        Full terms
      </h2>

      <article class="ds-license__terms">

        <h3 id="defs" class="ds-license__term-heading">3.1 Definitions</h3>
        <p>"<strong>Disrupted Studio</strong>" means Disrupted Studio (the licensor), reachable at hello@disruptedstudio.com.</p>
        <p>"<strong>Asset</strong>" means any plugin, font, graphic, illustration, template, code, or other digital file delivered as part of an order.</p>
        <p>"<strong>Licensee</strong>" means the individual or organization named on the order receipt.</p>
        <p>"<strong>Personal</strong>" means use for non-monetized purposes only — your own hobby, learning, portfolio, or non-sale projects. No money may change hands as a direct or indirect result of the Asset's involvement in the work.</p>
        <p>"<strong>Commercial</strong>" means use for any monetized or business purpose — client work, paid projects, products for sale, paid advertising, agency work, or use within a for-profit organization.</p>
        <p>"<strong>End product</strong>" means any deliverable created using an Asset (a logo, web page, mobile app, packaging design, illustration, animation, video, etc.).</p>

        <h3 id="grant" class="ds-license__term-heading">3.2 License grant</h3>
        <p>Subject to payment in full and ongoing compliance with these terms, Disrupted Studio grants Licensee a <strong>perpetual, non-exclusive, non-transferable, worldwide</strong> license to use the Asset as described in Section 02 for the tier purchased.</p>
        <p>The license is granted to the Licensee named on the order. Designers buying a Commercial license for a client should place the order in the client's name (this is industry standard practice).</p>

        <h3 id="permitted" class="ds-license__term-heading">3.3 Permitted uses</h3>
        <p>Within the limits of the purchased tier:</p>
        <ul>
          <li><strong>Personal tier</strong> permits use in non-monetized personal projects only — hobby art, learning, portfolio pieces that are not paid, and non-commercial social posts.</li>
          <li><strong>Commercial tier</strong> permits all Personal uses, plus use in client work, products for sale, paid marketing, paid advertising, and within for-profit organizations.</li>
          <li>Both tiers permit modifying, combining, recoloring, and remixing the Asset within Licensee's own work.</li>
          <li>Both tiers permit backup copies for personal archival use.</li>
        </ul>

        <h3 id="prohibited" class="ds-license__term-heading">3.4 Prohibited uses</h3>
        <p>Regardless of tier, Licensee may NOT:</p>
        <ul>
          <li><strong>Redistribute the source Asset</strong> — including selling, sharing, giving away, or making available the original files outside Licensee's organization.</li>
          <li><strong>Sublicense the Asset as a standalone file</strong> — except as explicitly permitted by Commercial Graphics (sublicensing within end products only).</li>
          <li><strong>Use the Asset in any AI/ML training dataset</strong>, embedding-generation pipeline, or generative model training, in whole or in part.</li>
          <li><strong>Use a Personal license for any monetized output</strong> — including paid client work, products for sale, paid advertising, sponsored social content, or anything that generates revenue. The Commercial license is required for any of these uses.</li>
          <li><strong>Create competing products</strong> whose primary value is the Asset (e.g., reselling a font as your own font, repackaging a graphics pack as your own).</li>
          <li><strong>Claim authorship</strong> of the Asset.</li>
          <li><strong>Transfer the license</strong> to another person, company, or successor organization (except as permitted in 3.9).</li>
        </ul>

        <h3 id="limits" class="ds-license__term-heading">3.5 Tier limits and upgrades</h3>
        <p>The seat / volume / usage limits stated in Section 02 are part of the license grant. Exceeding them — using a Personal license for monetized work, exceeding the seat or volume caps on Commercial, or embedding fonts beyond the purchased usage type — requires upgrading to the appropriate tier.</p>
        <p>Upgrading from Personal to Commercial (or expanding a Commercial license to cover more seats / a larger team) is available at any time by emailing hello@disruptedstudio.com. Licensee pays the difference between the original purchase and the upgraded tier (the Grilli Type / Foundry Types pay-the-difference model).</p>

        <h3 id="formats" class="ds-license__term-heading">3.6 Permitted embedding and formats</h3>
        <p>For fonts:</p>
        <ul>
          <li><strong>Personal:</strong> desktop installation only. Embed in personal PDFs as subset (security-locked or print-only) for your own non-sale documents.</li>
          <li><strong>Commercial:</strong> includes Personal usage plus self-hosted webfont (WOFF/WOFF2), iOS / Android app embedding, ePub embedding, broadcast, and paid advertising.</li>
        </ul>
        <p>For plugins: the plugin itself is installed and run on the Licensee's machine. The Personal vs Commercial distinction governs the use of the <em>output</em> created with the plugin, not the plugin's installation. See Section 3.3.</p>
        <p>For graphics: no specific embedding restrictions beyond Section 3.4 apply. Commercial tier allows inclusion in end products for sale up to the volume cap stated in Section 02.</p>

        <h3 id="refunds" class="ds-license__term-heading">3.7 Refunds</h3>
        <p>All sales are final. Because Assets are digital files delivered immediately at purchase, refunds are not available except where required by applicable law.</p>
        <p><strong>EU buyers:</strong> the 14-day right of withdrawal for digital content does not apply once you have downloaded the Asset, per Article 16(m) of the Consumer Rights Directive (2011/83/EU). Before downloading, you may request a refund within 14 days.</p>
        <p>Defective or non-functional Assets will be replaced at no charge. Email hello@disruptedstudio.com.</p>

        <h3 id="termination" class="ds-license__term-heading">3.8 Termination</h3>
        <p>This license terminates immediately if Licensee materially breaches any clause, including but not limited to the prohibited uses in 3.4 or the tier limits in 3.5.</p>
        <p>On termination, Licensee must delete all copies of the Asset and stop distributing any end products that contain the Asset within 30 days. End products already distributed to third parties before termination may remain in those third parties' hands.</p>
        <p>If a purchase is reversed by chargeback, refund, or dispute, the license terminates automatically.</p>

        <h3 id="transfer" class="ds-license__term-heading">3.9 Transfer and inheritance</h3>
        <p>Licenses are non-transferable. Exception: in the case of a sale of substantially all of a sole proprietor's business, the license may be assigned to the new owner at no charge by emailing hello@disruptedstudio.com with documentation. The new owner must accept these terms.</p>

        <h3 id="warranty" class="ds-license__term-heading">3.10 Disclaimer of warranties</h3>
        <p>Assets are provided <strong>"as is"</strong> without warranty of any kind, express or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, or non-infringement. Disrupted Studio does not warrant that the Asset will be uninterrupted, error-free, or compatible with any specific software or hardware configuration.</p>
        <p>To the maximum extent permitted by law, Disrupted Studio's total liability under this license is limited to the amount paid for the Asset.</p>

        <h3 id="law" class="ds-license__term-heading">3.11 Governing law</h3>
        <p>This license is governed by the laws of the United States and the State of <em>[fill in your state]</em>, without regard to conflict-of-laws principles. Any dispute arising under this license shall be resolved in the state or federal courts located in <em>[fill in your county/state]</em>.</p>

      </article>
    </section>

    {%- comment -%} ============ CHANGELOG ============ {%- endcomment -%}
    <section class="ds-license__block" aria-labelledby="license-changelog">
      <h2 class="ds-license__block-title" id="license-changelog">
        <span class="ds-license__block-num ds-mono">04</span>
        Changelog
      </h2>
      <p class="ds-license__block-intro">The version in effect when you placed your order is the one that applies to your purchase. Older versions are kept here for reference.</p>
      <ul class="ds-license__changelog">
        <li>
          <span class="ds-license__changelog-version ds-mono">v1.1 — May 2026</span>
          <span class="ds-license__changelog-note">Restructured to a Personal vs Commercial split across all product types. Personal tier covers non-monetized personal projects only; Commercial covers everything paid (client work, products for sale, paid ads, agencies). Replaces the previous Standard / Studio / Extended naming.</span>
        </li>
        <li>
          <span class="ds-license__changelog-version ds-mono">v1.0 — May 2026</span>
          <span class="ds-license__changelog-note">Initial publication. Standard + Studio for plugins, Standard + Extended for fonts and graphics. (Superseded by v1.1.)</span>
        </li>
      </ul>
    </section>

  </div>
</section>

{% style %}
  .ds-license {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(48px, 6vw, 96px) 0;
  }
  .ds-license__container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  /* ----- Header ----- */
  .ds-license__header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(48px, 5vw, 72px);
  }
  .ds-license__eyebrow {
    color: var(--color-accent);
    font-size: 12px;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
  }
  .ds-license__title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-5);
  }
  .ds-license__version {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .ds-license__version-pill {
    display: inline-block;
    border: 1px solid var(--color-border);
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .ds-license__version-date {
    font-size: 12px;
    opacity: 0.7;
  }
  .ds-license__intro {
    max-width: 64ch;
    font-size: 17px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
  }

  /* ----- Block (TL;DR / Tiers / Terms / Changelog) ----- */
  .ds-license__block {
    padding-block: clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--color-border);
  }
  .ds-license__block:last-of-type {
    border-bottom: none;
  }
  .ds-license__block-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-5);
  }
  .ds-license__block-num {
    color: var(--color-accent);
    font-size: 14px;
    font-weight: 500;
  }
  .ds-license__block-intro {
    max-width: 60ch;
    line-height: 1.55;
    margin: 0 0 var(--space-6);
    opacity: 0.85;
  }

  /* ----- TL;DR grid ----- */
  .ds-license__tldr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .ds-license__tldr-card {
    border: 1px solid var(--color-border);
    padding: var(--space-5);
    background: var(--color-bg-elev);
  }
  .ds-license__tldr-card-eyebrow {
    color: var(--color-accent);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
  }
  .ds-license__tldr-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-license__tldr-card-list li::before {
    content: "→ ";
    color: var(--color-accent);
    margin-right: 6px;
  }

  /* ----- Tier tables ----- */
  .ds-license__tier-heading {
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: 0.06em;
    margin: var(--space-6) 0 var(--space-4);
  }
  .ds-license__tier-table {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
  }
  .ds-license__tier-col {
    padding: var(--space-5);
  }
  .ds-license__tier-col + .ds-license__tier-col {
    border-left: 1px solid var(--color-border);
  }
  .ds-license__tier-col--upsell {
    background: rgba(255, 77, 31, 0.05);
  }
  .ds-license__tier-name {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  .ds-license__tier-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-license__tier-list li::before {
    content: "·  ";
    color: var(--color-accent);
  }
  .ds-license__tier-note {
    font-size: 12px;
    opacity: 0.7;
    margin-top: var(--space-5);
    letter-spacing: 0.04em;
  }

  /* ----- Terms body ----- */
  .ds-license__terms {
    max-width: 70ch;
  }
  .ds-license__term-heading {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: var(--space-6) 0 var(--space-3);
  }
  .ds-license__terms p {
    line-height: 1.6;
    margin: 0 0 var(--space-3);
    opacity: 0.9;
  }
  .ds-license__terms ul {
    line-height: 1.6;
    margin: 0 0 var(--space-3);
    padding-left: 24px;
    opacity: 0.9;
  }
  .ds-license__terms li {
    margin-bottom: 6px;
  }
  .ds-license__terms strong {
    font-weight: 600;
    opacity: 1;
  }

  /* ----- Changelog ----- */
  .ds-license__changelog {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ds-license__changelog > li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) 0;
    border-bottom: 1px dashed var(--color-border);
  }
  .ds-license__changelog > li:last-child {
    border-bottom: none;
  }
  .ds-license__changelog-version {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .ds-license__changelog-note {
    font-size: 14px;
    opacity: 0.85;
    line-height: 1.4;
  }

  /* ----- Mobile ----- */
  @media (max-width: 768px) {
    .ds-license__tldr-grid {
      grid-template-columns: 1fr;
    }
    .ds-license__tier-table {
      grid-template-columns: 1fr;
    }
    .ds-license__tier-col + .ds-license__tier-col {
      border-left: none;
      border-top: 1px solid var(--color-border);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "License terms",
  "tag": "section",
  "class": "ds-section ds-section--license",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "ASSET LICENSE",
      "label": "Eyebrow",
      "info": "Mono caps text above the title."
    },
    {
      "type": "text",
      "id": "title",
      "default": "License terms",
      "label": "Page title"
    },
    {
      "type": "text",
      "id": "version",
      "default": "v1.1",
      "label": "Version",
      "info": "Bump on each amendment. Old versions stay in the changelog at the bottom of the page."
    },
    {
      "type": "text",
      "id": "version_date",
      "default": "May 2026",
      "label": "Effective date",
      "info": "Month + year. Shown next to the version pill."
    },
    {
