{%- comment -%}
  sections/ds-pdp-typespecimen.liquid — Live type specimen for FONT products

  Reads `product.metafields.disrupted.font_file` (single file_reference;
  accepts .ttf / .otf / .woff / .woff2). If set, this section inlines an
  @font-face declaration with that file as the source and renders sample
  text rendered IN THE ACTUAL FONT.

  Designed for font products (Neue Portal, Rivet Mono, etc.) where the
  buyer wants to see the typeface live before purchase.

  Section settings let you customise the specimen content (display quote,
  whether to show alphabet / numbers / symbols).

  Hides entirely if no font file is uploaded on the product.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign font_file = product.metafields.disrupted.font_file.value
-%}

{%- if font_file and font_file.url != blank -%}
  {%- liquid
    assign font_family = 'ds-product-font-' | append: product.id
    assign font_url = font_file.url
    assign specimen_quote = section.settings.specimen_quote | default: 'The quick brown fox jumps over the lazy dog'
  -%}

  <style>
    @font-face {
      font-family: '{{ font_family }}';
      src: url('{{ font_url }}');
      font-display: swap;
    }
    .ds-pdp-typespecimen--{{ section.id }} .ds-pdp-typespecimen__live {
      font-family: '{{ font_family }}', system-ui, -apple-system, sans-serif;
    }
  </style>

  <section class="ds-pdp-typespecimen ds-pdp-typespecimen--{{ section.id }} color-{{ cs }}">
    <div class="ds-pdp-typespecimen__inner">

      {%- if section.settings.heading != blank or section.settings.subhead != blank -%}
        <div class="ds-section-head">
          {%- if section.settings.heading != blank -%}
            <h2 class="ds-section-head__title">
              {{ section.settings.heading }}
              {%- if section.settings.num_label != blank -%}
                <span class="ds-section-head__num">{{ section.settings.num_label }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.subhead != blank -%}
            <p class="ds-section-head__sub">{{ section.settings.subhead }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ds-pdp-typespecimen__quote ds-pdp-typespecimen__live">
        {{ specimen_quote }}
      </div>

      {%- if section.settings.show_alphabet -%}
        <div class="ds-pdp-typespecimen__row">
          <div class="ds-pdp-typespecimen__row-label">Uppercase</div>
          <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">ABCDEFGHIJKLMNOPQRSTUVWXYZ</div>
        </div>
        <div class="ds-pdp-typespecimen__row">
          <div class="ds-pdp-typespecimen__row-label">Lowercase</div>
          <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">abcdefghijklmnopqrstuvwxyz</div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_numbers -%}
        <div class="ds-pdp-typespecimen__row">
          <div class="ds-pdp-typespecimen__row-label">Numerals</div>
          <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">0123456789</div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_glyphs -%}
        <div class="ds-pdp-typespecimen__row">
          <div class="ds-pdp-typespecimen__row-label">Symbols</div>
          <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">! @ # $ % &amp; * ? . , ; : - + = / \ ( ) [ ] { } &lt; &gt; &quot; &apos;</div>
        </div>
      {%- endif -%}

      <div class="ds-pdp-typespecimen__controls">
        <div class="ds-pdp-typespecimen__controls-left">
          {%- if section.settings.link_label != blank -%}
            <a href="{{ section.settings.link_url | default: '#' }}" class="ds-pdp-typespecimen__link">
              {{ section.settings.link_label }}
              <span class="ds-pdp-typespecimen__link-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
        <div class="ds-pdp-typespecimen__sliders" data-ds-specimen-controls>
          <label class="ds-pdp-typespecimen__slider">
            <span class="ds-pdp-typespecimen__slider-label">Size</span>
            <input
              type="range"
              min="32"
              max="220"
              value="96"
              step="1"
              data-ds-specimen-target="size"
              aria-label="Specimen size in pixels"
            >
            <span class="ds-pdp-typespecimen__slider-value" data-ds-specimen-value="size">96<span class="ds-pdp-typespecimen__slider-unit">px</span></span>
          </label>
          <label class="ds-pdp-typespecimen__slider">
            <span class="ds-pdp-typespecimen__slider-label">Spacing</span>
            <input
              type="range"
              min="-80"
              max="80"
              value="-20"
              step="2"
              data-ds-specimen-target="spacing"
              aria-label="Specimen letter spacing"
            >
            <span class="ds-pdp-typespecimen__slider-value" data-ds-specimen-value="spacing">-0.02<span class="ds-pdp-typespecimen__slider-unit">em</span></span>
          </label>
        </div>
      </div>

    </div>
  </section>

  <script>
    (function () {
      var sections = document.querySelectorAll('.ds-pdp-typespecimen--{{ section.id }}');
      sections.forEach(function (section) {
        var quote = section.querySelector('.ds-pdp-typespecimen__quote');
        var inputs = section.querySelectorAll('[data-ds-specimen-target]');
        if (!quote || inputs.length === 0) return;
        inputs.forEach(function (input) {
          var target = input.getAttribute('data-ds-specimen-target');
          var valueEl = section.querySelector('[data-ds-specimen-value="' + target + '"]');
          input.addEventListener('input', function () {
            if (target === 'size') {
              quote.style.setProperty('--ds-specimen-size', input.value + 'px');
              if (valueEl) valueEl.innerHTML = input.value + '<span class="ds-pdp-typespecimen__slider-unit">px</span>';
            } else if (target === 'spacing') {
              var em = (parseInt(input.value, 10) / 1000).toFixed(3);
              quote.style.setProperty('--ds-specimen-spacing', em + 'em');
              if (valueEl) valueEl.innerHTML = em + '<span class="ds-pdp-typespecimen__slider-unit">em</span>';
            }
          });
        });
      });
    })();
  </script>
{%- endif -%}

{% style %}
  /* ds-pdp-typespecimen — font-product specific */
  .ds-pdp-typespecimen {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(56px, 7vw, 96px) 0;
    border-top: 1px solid var(--color-border);
  }
  .ds-pdp-typespecimen__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
  }
  .ds-pdp-typespecimen__quote {
    font-size: var(--ds-specimen-size, clamp(48px, 8vw, 128px));
    font-weight: 400;
    letter-spacing: var(--ds-specimen-spacing, -0.02em);
    line-height: 0.95;
    margin: clamp(32px, 5vw, 56px) 0;
    color: var(--color-fg);
    overflow-wrap: break-word;
    transition: font-size var(--t-fast) var(--ease), letter-spacing var(--t-fast) var(--ease);
  }
  .ds-pdp-typespecimen__row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    align-items: baseline;
  }
  .ds-pdp-typespecimen__row:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .ds-pdp-typespecimen__row-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .ds-pdp-typespecimen__row-text {
    font-size: clamp(20px, 2.5vw, 32px);
    line-height: 1.2;
    color: var(--color-fg);
    word-spacing: 0.15em;
    overflow-wrap: break-word;
  }
  @media (max-width: 700px) {
    .ds-pdp-typespecimen__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  /* Controls row: link on left, sliders on right */
  .ds-pdp-typespecimen__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }
  .ds-pdp-typespecimen__controls-left { flex-shrink: 0; }
  .ds-pdp-typespecimen__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 4px;
    transition: border-color var(--t-fast) var(--ease);
  }
  .ds-pdp-typespecimen__link:hover {
    border-bottom-color: var(--color-fg);
  }
  .ds-pdp-typespecimen__link-arrow {
    display: inline-block;
    transition: transform var(--t-fast) var(--ease);
  }
  .ds-pdp-typespecimen__link:hover .ds-pdp-typespecimen__link-arrow {
    transform: translateX(3px);
  }

  /* Sliders */
  .ds-pdp-typespecimen__sliders {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    flex-wrap: wrap;
  }
  .ds-pdp-typespecimen__slider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
  }
  .ds-pdp-typespecimen__slider-label {
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .ds-pdp-typespecimen__slider input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 120px;
    height: 2px;
    background: var(--color-border-strong);
    outline: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
  }
  .ds-pdp-typespecimen__slider input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 0;
    border: 0;
    cursor: pointer;
  }
  .ds-pdp-typespecimen__slider input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 0;
    border: 0;
    cursor: pointer;
  }
  .ds-pdp-typespecimen__slider input[type="range"]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .ds-pdp-typespecimen__slider-value {
    color: var(--color-fg);
    min-width: 4ch;
    text-align: right;
    font-feature-settings: "tnum";
  }
  .ds-pdp-typespecimen__slider-unit {
    color: var(--color-fg-muted);
    margin-left: 2px;
  }

  @media (max-width: 600px) {
    .ds-pdp-typespecimen__controls { flex-direction: column; align-items: flex-start; }
    .ds-pdp-typespecimen__slider input[type="range"] { width: 100px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Disrupted PDP specimen",
  "tag": "section",
  "class": "ds-section ds-section--pdp-typespecimen",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "default": "Type specimen",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "num_label",
      "label": "Number badge"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead"
    },
    { "type": "header", "content": "Specimen" },
    {
      "type": "text",
      "id": "specimen_quote",
      "default": "The quick brown fox jumps over the lazy dog",
      "label": "Display quote",
      "info": "Renders large in the loaded product font."
    },
    {
      "type": "checkbox",
      "id": "show_alphabet",
      "default": true,
      "label": "Show alphabet (uppercase + lowercase)"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "default": true,
      "label": "Show numerals"
    },
    {
      "type": "checkbox",
      "id": "show_glyphs",
      "default": true,
      "label": "Show symbols / punctuation"
    },
    {
      "type": "paragraph",
      "content": "Requires the product's `disrupted.font_file` metafield to be set with a .woff2 / .ttf / .otf file. Section hides if no font is uploaded."
    },
    { "type": "header", "content": "Full specimen link" },
    {
      "type": "text",
      "id": "link_label",
      "default": "See the full specimen",
      "label": "Link label",
      "info": "Small mono link below the specimen. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Where the link points (e.g. a downloadable PDF specimen, or a /pages/X specimen page)."
    }
  ],
  "presets": [
    {
      "name": "Disrupted PDP type specimen"
    }
  ]
}
{% endschema %}
