{%- comment -%}
  sections/ds-pdp-typespecimen.liquid — Live type specimen for FONT products

  Reads `product.metafields.disrupted.font_file` (single file_reference;
  accepts .ttf / .otf / .woff / .woff2). If set, this section inlines an
  @font-face declaration with that file as the source and renders sample
  text rendered IN THE ACTUAL FONT.

  Designed for font products (Neue Portal, Rivet Mono, etc.) where the
  buyer wants to see the typeface live before purchase.

  Section settings let you customise the specimen content (display quote,
  whether to show alphabet / numbers / symbols).

  Hides entirely if no font file is uploaded on the product.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
  assign font_file = product.metafields.disrupted.font_file.value
-%}

{%- if font_file and font_file.url != blank -%}
  {%- liquid
    assign font_family = 'ds-product-font-' | append: product.id
    assign font_url = font_file.url
    assign specimen_quote = section.settings.specimen_quote | default: 'The quick brown fox jumps over the lazy dog'
  -%}

  <style>
    @font-face {
      font-family: '{{ font_family }}';
      src: url('{{ font_url }}');
      font-display: swap;
    }
    .ds-pdp-typespecimen--{{ section.id }} .ds-pdp-typespecimen__live {
      font-family: '{{ font_family }}', system-ui, -apple-system, sans-serif;
    }
  </style>

  <section id="specimen" class="ds-pdp-typespecimen ds-pdp-typespecimen--{{ section.id }} color-{{ cs }}">
    <div class="ds-pdp-typespecimen__inner">

      {%- if section.settings.heading != blank or section.settings.subhead != blank -%}
        <div class="ds-section-head">
          {%- if section.settings.heading != blank -%}
            <h2 class="ds-section-head__title">
              {{ section.settings.heading }}
              {%- if section.settings.num_label != blank -%}
                <span class="ds-section-head__num">{{ section.settings.num_label }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.subhead != blank -%}
            <p class="ds-section-head__sub">{{ section.settings.subhead }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ds-pdp-typespecimen__controls" data-ds-specimen-controls>
        <div class="ds-pdp-typespecimen__sliders">
          <div class="ds-pdp-typespecimen__control">
            <div class="ds-pdp-typespecimen__control-head">
              <span class="ds-pdp-typespecimen__control-label">Size</span>
              <span class="ds-pdp-typespecimen__control-value" data-ds-specimen-value="size">96<span class="ds-pdp-typespecimen__unit">PX</span></span>
            </div>
            <input
              type="range"
              min="32"
              max="220"
              value="96"
              step="1"
              data-ds-specimen-target="size"
              aria-label="Specimen size in pixels"
              class="ds-pdp-typespecimen__range"
            >
          </div>
          <div class="ds-pdp-typespecimen__control">
            <div class="ds-pdp-typespecimen__control-head">
              <span class="ds-pdp-typespecimen__control-label">Tracking</span>
              <span class="ds-pdp-typespecimen__control-value" data-ds-specimen-value="spacing">-0.02<span class="ds-pdp-typespecimen__unit">EM</span></span>
            </div>
            <input
              type="range"
              min="-80"
              max="80"
              value="-20"
              step="2"
              data-ds-specimen-target="spacing"
              aria-label="Specimen letter spacing"
              class="ds-pdp-typespecimen__range"
            >
          </div>
        </div>
        <button type="button" class="ds-pdp-typespecimen__reset" data-ds-specimen-reset aria-label="Reset specimen">
          Reset
        </button>
      </div>

      <div
        class="ds-pdp-typespecimen__quote ds-pdp-typespecimen__live"
        contenteditable="true"
        spellcheck="false"
        data-ds-specimen-default="{{ specimen_quote | escape }}"
        data-ds-specimen-placeholder="Type to preview…"
        aria-label="Editable specimen text — type to preview"
      >{{ specimen_quote }}</div>

      {%- if section.settings.show_alphabet or section.settings.show_numbers or section.settings.show_glyphs -%}
        <details class="ds-pdp-typespecimen__details">
          <summary class="ds-pdp-typespecimen__details-summary">
            <span class="ds-pdp-typespecimen__details-label">{{ section.settings.link_label | default: 'See the full specimen' }}</span>
            <span class="ds-pdp-typespecimen__details-arrow" aria-hidden="true">→</span>
          </summary>
          <div class="ds-pdp-typespecimen__details-content">
            {%- if section.settings.show_alphabet -%}
              <div class="ds-pdp-typespecimen__row" data-row-kind="uppercase">
                <div class="ds-pdp-typespecimen__row-label">Uppercase</div>
                <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">ABCDEFGHIJKLMNOPQRSTUVWXYZ</div>
              </div>
              <div class="ds-pdp-typespecimen__row" data-row-kind="lowercase">
                <div class="ds-pdp-typespecimen__row-label">Lowercase</div>
                <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">abcdefghijklmnopqrstuvwxyz</div>
              </div>
            {%- endif -%}

            {%- if section.settings.show_numbers -%}
              <div class="ds-pdp-typespecimen__row" data-row-kind="numerals">
                <div class="ds-pdp-typespecimen__row-label">Numerals</div>
                <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">0123456789</div>
              </div>
            {%- endif -%}

            {%- if section.settings.show_glyphs -%}
              <div class="ds-pdp-typespecimen__row" data-row-kind="symbols">
                <div class="ds-pdp-typespecimen__row-label">Symbols</div>
                <div class="ds-pdp-typespecimen__row-text ds-pdp-typespecimen__live">! @ # $ % &amp; * ? . , ; : - + = / \ ( ) [ ] { } &lt; &gt; &quot; &apos;</div>
              </div>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}

    </div>
  </section>

  <script>
    (function () {
      var FONT_FAMILY = '{{ font_family }}';
      var sections = document.querySelectorAll('.ds-pdp-typespecimen--{{ section.id }}');

      // --- Glyph detection ------------------------------------------------
      // Compare the width of a character rendered with [our font, monospace]
      // vs [our font, serif]. If our font has the glyph, both stacks use it
      // and widths match. If our font is missing the glyph, the two fallback
      // fonts kick in — and monospace vs serif almost always have different
      // widths, so a mismatch ⇒ glyph missing.
      var detectCanvas = document.createElement('canvas');
      var detectCtx = detectCanvas.getContext('2d');
      function fontHasGlyph(family, ch) {
        detectCtx.font = '32px "' + family + '", monospace';
        var w1 = detectCtx.measureText(ch).width;
        detectCtx.font = '32px "' + family + '", serif';
        var w2 = detectCtx.measureText(ch).width;
        return w1 === w2;
      }
      function filterRows(section) {
        var rows = section.querySelectorAll('.ds-pdp-typespecimen__row');
        var visibleCount = 0;
        rows.forEach(function (row) {
          var textEl = row.querySelector('.ds-pdp-typespecimen__row-text');
          if (!textEl) return;
          var original = textEl.textContent;
          var hasSpaces = original.indexOf(' ') !== -1;
          var glyphs = hasSpaces ? original.trim().split(/\s+/) : original.split('');
          var supported = glyphs.filter(function (g) {
            return fontHasGlyph(FONT_FAMILY, g);
          });
          if (supported.length === 0) {
            row.style.display = 'none';
          } else {
            visibleCount++;
            if (supported.length !== glyphs.length) {
              textEl.textContent = supported.join(hasSpaces ? ' ' : '');
            }
          }
        });
        // If every row was filtered out, hide the dropdown wrapper too —
        // there's nothing for the toggle to reveal.
        if (visibleCount === 0) {
          var details = section.querySelector('.ds-pdp-typespecimen__details');
          if (details) details.style.display = 'none';
        }
      }

      sections.forEach(function (section) {
        // Wait for the @font-face to actually load before measuring, or we'll
        // see the system-fallback widths and incorrectly drop every glyph.
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { filterRows(section); });
        }

        var quote = section.querySelector('.ds-pdp-typespecimen__quote');
        var inputs = section.querySelectorAll('[data-ds-specimen-target]');
        var resetBtn = section.querySelector('[data-ds-specimen-reset]');
        if (!quote || inputs.length === 0) return;

        var defaults = {};
        inputs.forEach(function (input) {
          defaults[input.getAttribute('data-ds-specimen-target')] = input.value;
        });
        var defaultText = quote.getAttribute('data-ds-specimen-default') || '';

        function updateValueDisplay(target, raw) {
          var valueEl = section.querySelector('[data-ds-specimen-value="' + target + '"]');
          if (!valueEl) return;
          if (target === 'size') {
            valueEl.innerHTML = raw + '<span class="ds-pdp-typespecimen__unit">PX</span>';
          } else if (target === 'spacing') {
            var em = (parseInt(raw, 10) / 1000).toFixed(3);
            valueEl.innerHTML = em + '<span class="ds-pdp-typespecimen__unit">EM</span>';
          }
        }

        function applyValue(target, raw) {
          if (target === 'size') {
            quote.style.setProperty('--ds-specimen-size', raw + 'px');
          } else if (target === 'spacing') {
            var em = (parseInt(raw, 10) / 1000).toFixed(3);
            quote.style.setProperty('--ds-specimen-spacing', em + 'em');
          }
          updateValueDisplay(target, raw);
        }

        inputs.forEach(function (input) {
          input.addEventListener('input', function () {
            applyValue(input.getAttribute('data-ds-specimen-target'), input.value);
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', function () {
            inputs.forEach(function (input) {
              var t = input.getAttribute('data-ds-specimen-target');
              input.value = defaults[t];
              applyValue(t, defaults[t]);
            });
            if (defaultText) quote.textContent = defaultText;
          });
        }

        // Prevent newlines / formatting in the editable quote
        quote.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') e.preventDefault();
        });
        quote.addEventListener('paste', function (e) {
          e.preventDefault();
          var text = (e.clipboardData || window.clipboardData).getData('text/plain');
          document.execCommand('insertText', false, text);
        });
      });
    })();
  </script>
{%- endif -%}

{% style %}
  /* ds-pdp-typespecimen — font-product specific */
  .ds-pdp-typespecimen {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(56px, 7vw, 96px) 0;
    border-top: 1px solid var(--color-border);
  }
  .ds-pdp-typespecimen__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
  }
  .ds-pdp-typespecimen__quote {
    font-size: var(--ds-specimen-size, clamp(48px, 8vw, 128px));
    font-weight: 400;
    letter-spacing: var(--ds-specimen-spacing, -0.02em);
    line-height: 0.95;
    margin: clamp(32px, 5vw, 56px) 0;
    color: var(--color-fg);
    /* Break inside long words too, so the user dragging the size slider
       to its max on a narrow screen can't push the section into horizontal
       scroll. `anywhere` is the modern, more aggressive break-word. */
    overflow-wrap: anywhere;
    word-break: break-word;
    transition: font-size var(--t-fast) var(--ease), letter-spacing var(--t-fast) var(--ease);
    outline: none;
    cursor: text;
    caret-color: var(--color-accent);
  }
  .ds-pdp-typespecimen__quote:focus {
    outline: 1px dashed var(--color-border-strong);
    outline-offset: 12px;
  }
  /* Placeholder when the editable quote is empty */
  .ds-pdp-typespecimen__quote:empty:not(:focus)::before {
    content: attr(data-ds-specimen-placeholder);
    color: var(--color-fg-faint);
    font-style: italic;
  }
  .ds-pdp-typespecimen__row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    align-items: baseline;
  }
  .ds-pdp-typespecimen__row:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .ds-pdp-typespecimen__row-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .ds-pdp-typespecimen__row-text {
    font-size: clamp(20px, 2.5vw, 32px);
    line-height: 1.2;
    color: var(--color-fg);
    letter-spacing: 0.06em;
    word-spacing: 0.4em;
    overflow-wrap: break-word;
  }
  /* Symbols row gets even more breathing room */
  .ds-pdp-typespecimen__row[data-row-kind="symbols"] .ds-pdp-typespecimen__row-text {
    letter-spacing: 0.12em;
    word-spacing: 0.55em;
  }
  @media (max-width: 700px) {
    .ds-pdp-typespecimen__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  /* Controls — sit ABOVE the editable quote so dragging the size slider
     grows the quote DOWNWARD without pushing the slider off-screen. */
  .ds-pdp-typespecimen__controls {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  /* "See the full specimen →" dropdown — full-width accordion row,
     label flush left, arrow flush right, separators span the whole
     section width (same pattern as the FAQ accordion). */
  .ds-pdp-typespecimen__details {
    margin-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--color-border);
  }
  /* When the dropdown is collapsed, close it off with a bottom rule too,
     so the summary reads as a complete row. When open, the last row
     inside the content already provides the closing line, so we omit it
     to avoid a doubled border. */
  .ds-pdp-typespecimen__details:not([open]) {
    border-bottom: 1px solid var(--color-border);
  }
  .ds-pdp-typespecimen__details-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;     /* text left, arrow right */
    gap: var(--space-4);
    padding: var(--space-5) 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
    user-select: none;
    transition: color var(--t-fast) var(--ease);
  }
  /* Hide the native disclosure triangle in both engine families */
  .ds-pdp-typespecimen__details-summary::-webkit-details-marker { display: none; }
  .ds-pdp-typespecimen__details-summary::marker { content: ''; }
  .ds-pdp-typespecimen__details-summary:hover {
    color: var(--color-accent);
  }
  .ds-pdp-typespecimen__details-arrow {
    display: inline-block;
    transition: transform var(--t-med) var(--ease);
  }
  .ds-pdp-typespecimen__details[open] .ds-pdp-typespecimen__details-arrow {
    transform: rotate(90deg);
  }

  /* Sliders — Pangram Pangram-inspired pro layout */
  .ds-pdp-typespecimen__sliders {
    display: flex;
    gap: var(--space-6);
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .ds-pdp-typespecimen__control {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 200px;
  }
  .ds-pdp-typespecimen__control-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .ds-pdp-typespecimen__control-label {
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-weight: 500;
  }
  .ds-pdp-typespecimen__control-value {
    color: var(--color-fg);
    font-size: 13px;
    font-weight: 500;
    font-feature-settings: "tnum";
    letter-spacing: 0;
  }
  .ds-pdp-typespecimen__unit {
    color: var(--color-fg-muted);
    margin-left: 4px;
    font-size: 10px;
  }
  /* Native range input — browsers draw their own track in the
     ::-webkit-slider-runnable-track / ::-moz-range-track pseudos, so
     setting `background` on the input itself doesn't show a bar.
     Reset the input chrome, then style track + thumb explicitly. */
  .ds-pdp-typespecimen__range {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 100%;
    background: transparent;     /* track is drawn by pseudo-element below */
    outline: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    height: 16px;                /* total slider height = thumb height */
  }
  /* WebKit / Blink */
  .ds-pdp-typespecimen__range::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--color-fg-faint);
    border: 0;
    border-radius: 0;
  }
  .ds-pdp-typespecimen__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -7px;            /* center 16px thumb on 2px track */
    background: var(--color-fg);
    border-radius: 0;
    border: 0;
    cursor: grab;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-pdp-typespecimen__range::-webkit-slider-thumb:active {
    cursor: grabbing;
    background: var(--color-accent);
  }
  /* Firefox */
  .ds-pdp-typespecimen__range::-moz-range-track {
    height: 2px;
    background: var(--color-fg-faint);
    border: 0;
    border-radius: 0;
  }
  .ds-pdp-typespecimen__range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--color-fg);
    border-radius: 0;
    border: 0;
    cursor: grab;
  }
  .ds-pdp-typespecimen__range::-moz-range-thumb:active {
    cursor: grabbing;
    background: var(--color-accent);
  }
  .ds-pdp-typespecimen__range:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  /* Reset button */
  .ds-pdp-typespecimen__reset {
    align-self: flex-end;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 14px;
    cursor: pointer;
    transition:
      background var(--t-fast) var(--ease),
      color      var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .ds-pdp-typespecimen__reset:hover {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }

  @media (max-width: 700px) {
    .ds-pdp-typespecimen {
      padding: clamp(40px, 9vw, 64px) 0;
    }
    .ds-pdp-typespecimen__controls {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-4) 0;
      gap: var(--space-4);
    }
    .ds-pdp-typespecimen__sliders {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }
    .ds-pdp-typespecimen__control { min-width: 0; }
    .ds-pdp-typespecimen__reset { align-self: flex-start; }
    /* Quote min size pulls in so it actually fits a phone screen */
    .ds-pdp-typespecimen__quote {
      font-size: var(--ds-specimen-size, clamp(36px, 11vw, 72px));
      margin: var(--space-4) 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Disrupted PDP specimen",
  "tag": "section",
  "class": "ds-section ds-section--pdp-typespecimen",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "default": "Type specimen",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "num_label",
      "label": "Number badge"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead"
    },
    { "type": "header", "content": "Specimen" },
    {
      "type": "text",
      "id": "specimen_quote",
      "default": "The quick brown fox jumps over the lazy dog",
      "label": "Display quote",
      "info": "Renders large in the loaded product font."
    },
    {
      "type": "checkbox",
      "id": "show_alphabet",
      "default": true,
      "label": "Show alphabet (uppercase + lowercase)"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "default": true,
      "label": "Show numerals"
    },
    {
      "type": "checkbox",
      "id": "show_glyphs",
      "default": true,
      "label": "Show symbols / punctuation"
    },
    {
      "type": "paragraph",
      "content": "Requires the product's `disrupted.font_file` metafield to be set with a .woff2 / .ttf / .otf file. Section hides if no font is uploaded."
    },
    { "type": "header", "content": "Full specimen toggle" },
    {
      "type": "text",
      "id": "link_label",
      "default": "See the full specimen",
      "label": "Toggle label",
      "info": "Label for the dropdown that opens/closes the uppercase, lowercase, numerals and symbols rows."
    }
  ],
  "presets": [
    {
      "name": "Disrupted PDP type specimen"
    }
  ]
}
{% endschema %}
