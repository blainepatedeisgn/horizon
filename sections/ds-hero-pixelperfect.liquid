{%- comment -%}
  sections/ds-hero-pixelperfect.liquid — Hero for PIXEL PERFECT product.

  Functionally identical to ds-hero.liquid (same markup, same CSS, same
  layout): two-column grid on desktop, single column on mobile.  The
  ONLY differences from the BACKLIT hero are in the schema:

    1. `name` is "Hero — Pixel Perfect" so it appears as a separate
       option in the section picker
    2. `presets.blocks` ship with PIXEL PERFECT copy as defaults
       (eyebrow accent, title text, meta strip items)

  CSS classes are shared with ds-hero.liquid — both sections render
  visually identical chrome.  This keeps the brand consistent and
  means style tweaks land on both heroes from one place.

  Why not just re-use ds-hero with different content?
    The default block content is locked into the `presets` array
    in the schema, which is what populates a freshly-added section.
    Dragging in a new BACKLIT-defaulted hero and manually swapping
    every block every time is friction.  A dedicated section comes
    pre-filled with the right copy, ready to be customised.
{%- endcomment -%}

{%- liquid
  assign before_image = section.settings.before_image
  assign after_image  = section.settings.after_image
  assign start_pos    = section.settings.starting_position | default: 50
  assign hero_video   = section.settings.hero_video
  assign visual       = section.settings.visual
  assign cs           = section.settings.color_scheme
-%}

<div class="ds-hero color-{{ cs }}">
  <div class="ds-hero__content">
    {%- content_for 'blocks' -%}
  </div>

  <div class="ds-hero__visual">
    <div class="ds-hero__visual-inner">
      {%- if before_image != blank and after_image != blank -%}
        {%- comment -%}
          Before/after comparison slider — the on-brand demo of the
          Pixel Perfect plugin (drag to compare original vs pixel-art
          output). Built as a role="slider" element with full keyboard
          + pointer + touch support. See script + CSS below.
        {%- endcomment -%}
        <div
          class="ds-before-after"
          data-ds-before-after
          role="slider"
          tabindex="0"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ start_pos }}"
          aria-label="Compare before and after — {{ start_pos }}% after visible. Drag, click, or use arrow keys."
          style="--position: {{ start_pos }}%;"
        >
          {{
            before_image
            | image_url: width: 1400
            | image_tag:
                class: 'ds-before-after__img ds-before-after__img--before',
                alt: 'Before',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '480, 720, 960, 1200, 1400'
          }}
          {{
            after_image
            | image_url: width: 1400
            | image_tag:
                class: 'ds-before-after__img ds-before-after__img--after',
                alt: 'After',
                loading: 'eager',
                widths: '480, 720, 960, 1200, 1400'
          }}

          <span class="ds-before-after__divider" aria-hidden="true"></span>
          <span class="ds-before-after__handle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 6l-6 6 6 6M13 6l6 6-6 6"/>
            </svg>
          </span>
        </div>
      {%- elsif hero_video != blank -%}
        {%- comment -%}
          Manual <video> (not the video_tag filter) so we get playsinline
          (iOS Safari refuses to autoplay without it) and preload=auto
          for the hero. Poster pulls from the video's auto-generated
          first frame so there's no blank box while sources fetch.
        {%- endcomment -%}
        <video
          class="ds-hero__visual-img ds-hero__visual-video"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          poster="{{ hero_video.preview_image | image_url: width: 1200 }}"
        >
          {%- for source in hero_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif visual != blank -%}
        {{
          visual
          | image_url: width: 1200
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw',
              class: 'ds-hero__visual-img'
        }}
      {%- else -%}
        {%- render 'ds-backlit-render-fallback' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .ds-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
    position: relative;
    padding: clamp(24px, 3vw, 48px) 0;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .ds-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: var(--pad-x);
    padding-right: clamp(24px, 4vw, 56px);
    z-index: 2;
  }
  .ds-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-right: var(--pad-x);
    min-height: 360px;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.04), transparent 60%);
  }
  .ds-hero__visual-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-hero__visual-img,
  .ds-hero__visual-video {
    /* Square visual with a fluid-but-capped width. The earlier "match
       content column height" approach hit a flex layout pathology —
       images inside flex parents inherit min-width from their intrinsic
       source size (here, 1200px), which fought max-width: 100% on narrow
       viewports (image overflowed) and let the square grow taller than
       content on wide ones (image overhung the eyebrow/buttons).
       Switched to the standard Shopify hero pattern: width fills the
       column up to a sensible cap, aspect-ratio: 1 / 1 locks the shape.
       The image is sometimes slightly shorter than the content column
       (normal for hero layouts) but it never overflows, crops at the
       edges, or distorts. */
    width: 100%;
    max-width: 560px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    display: block;
  }

  /* Tighten the in-hero variants of block styles */
  .ds-hero .ds-eyebrow .ds-mono {
    color: var(--color-accent);
    font-size: 11px;
  }
  .ds-hero .ds-rich-text { max-width: 38ch; }

  /* Display title — flat headline, no spotlight/halo for this section.
     The ds-hero-title block renders a `.ds-hero-title__glow` span as
     a duplicate of the text (used by the BACKLIT hero for a soft
     halo), so we hide that span here — otherwise the title would
     render twice as inline text. */
  .ds-hero-title {
    /* PP hero runs the headline at 80% of the responsive default — the
       copy is short enough that the full BACKLIT size felt oversized.
       Multiplies the clamp so mobile still scales down proportionally. */
    font-size: calc(var(--fs-display) * 0.8);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.04em;
    position: relative;
    display: inline-block;
    margin: 0;
  }
  .ds-hero-title__glow { display: none; }

  /* ============================================================
     BEFORE/AFTER SLIDER
     Drag-to-compare visual for the Pixel Perfect hero. Fills the
     full right column on desktop (no max-width cap, no 1:1 aspect
     constraint — wider rectangle that scales with the column),
     collapses to a square on mobile. White border + white divider
     + white circular handle. The plugin's on-brand demo: drag to
     see the original vs the pixel-art output.

     Layout
       • Container takes 100% of column width
       • aspect-ratio: 4/3 on desktop → wider rectangle that fills
         the column nicely. aspect-ratio: 1/1 on mobile.
       • Before image: absolute, full size, base layer
       • After image: absolute, full size, clip-path inset cuts
         away the left portion based on --position CSS variable
       • Divider + handle: positioned via --position

     Interaction model
       • Pointer drag (mouse, pen, touch — Pointer Events API
         handles all three uniformly)
       • Click anywhere on the frame jumps the slider to that x
       • Pointer capture on the frame so dragging works even when
         the cursor leaves the bounds
       • Keyboard: arrow keys (1 step), PageUp/Down (10 steps),
         Home/End (0/100). Wrapper has role="slider" + aria-valuenow
         so SR users get a properly-typed control.
  ============================================================ */
  .ds-before-after {
    --position: 50%;
    position: relative;
    width: 100%;
    /* Cap at 720px so the slider doesn't sprawl on wide viewports —
       matches the visual weight of the old image cap (560px) but bigger
       to suit the comparison-rich content. Centers in the column when
       the column is wider than the cap. */
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* White border, hardcoded so it can't be overridden by a future
       color-scheme tweak that re-maps --color-fg to something else. */
    border: 2px solid #ffffff;
    background: var(--color-bg-elev);
    user-select: none;
    cursor: ew-resize;
    /* Disable native touch scroll handling on the slider so drag
       works on mobile without the page also panning. */
    touch-action: none;
  }
  .ds-before-after:focus-visible {
    /* Subtle white outline matching the brutalist border. Was accent
       orange before — moved to white so the focus indicator doesn't
       fight the brand-white frame. */
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }
  .ds-before-after__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    /* GPU-promote so the clip-path repaints are smooth during drag */
    will-change: clip-path;
  }
  .ds-before-after__img--after {
    /* clip-path inset(top right bottom left) — inset the LEFT edge
       by --position so only the right portion of the after image
       shows. The left portion of the before image is visible
       underneath. */
    clip-path: inset(0 0 0 var(--position));
  }
  .ds-before-after__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    width: 2px;
    background: #ffffff;
    transform: translateX(-50%);
    pointer-events: none;
    /* Subtle drop shadow so the line reads against both light and
       dark image content. */
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.4);
  }
  .ds-before-after__handle {
    position: absolute;
    top: 50%;
    left: var(--position);
    transform: translate(-50%, -50%);
    /* Shrunk handle — was 44px, now 32px. Visible but less dominant. */
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-background);
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease;
  }
  .ds-before-after:hover .ds-before-after__handle,
  .ds-before-after[data-dragging] .ds-before-after__handle {
    transform: translate(-50%, -50%) scale(1.1);
  }
  @media (max-width: 900px) {
    .ds-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-5);
      padding-bottom: var(--space-7);
    }
    .ds-hero__content {
      padding-right: var(--pad-x);
    }
    .ds-hero__visual {
      min-height: 0;
      padding: 0 var(--pad-x);
    }
    /* Phones: shrink the cap to 480px and add 3% side breathing room
       via the 94% width so the square doesn't kiss the viewport edges. */
    .ds-hero__visual-img,
    .ds-hero__visual-video {
      width: min(94%, 480px);
      max-width: none;
    }
    /* Before/after slider on mobile: 1:1 square instead of 4:3
       landscape. Keeps the comparison readable at phone widths. */
    .ds-before-after {
      aspect-ratio: 1 / 1;
      max-width: none;
    }
    .ds-before-after__handle {
      width: 28px;
      height: 28px;
    }
  }
  @media (max-width: 480px) {
    .ds-hero__visual { padding: 0 var(--space-3); }
  }
{% endstyle %}

<script>
  /* Reduced-motion: pause hero videos for users who've asked the OS to
     limit motion. Muted, looped hero video is mild (closer to a GIF
     than to true animation), but pausing is the safer default — users
     still see the poster frame as a still image. */
  (function () {
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.ds-hero__visual-video').forEach(function (v) {
      v.removeAttribute('autoplay');
      v.pause();
    });
  })();

  /* Before/after slider — drag, click-to-jump, keyboard nav.
     Uses Pointer Events API so mouse/pen/touch all flow through the
     same code path. Pointer capture means dragging works even when
     the cursor leaves the frame. Keyboard arrows + Home/End handle
     a11y. The wrapper has role="slider" + aria-valuenow so screen
     readers announce position as the user navigates. */
  (function () {
    var els = document.querySelectorAll('[data-ds-before-after]');
    if (!els.length) return;

    els.forEach(function (el) {
      var min = 0;
      var max = 100;
      var step = 1;
      var pageStep = 10;

      function getCurrent() {
        return parseFloat(el.getAttribute('aria-valuenow')) || 50;
      }
      function setPosition(pct) {
        pct = Math.max(min, Math.min(max, pct));
        var rounded = Math.round(pct);
        el.style.setProperty('--position', pct + '%');
        el.setAttribute('aria-valuenow', rounded);
        el.setAttribute(
          'aria-label',
          'Compare before and after — ' + rounded + '% after visible. Drag, click, or use arrow keys.'
        );
      }
      function positionFromEvent(e) {
        var rect = el.getBoundingClientRect();
        var x = e.clientX - rect.left;
        return (x / rect.width) * 100;
      }

      el.addEventListener('pointerdown', function (e) {
        // Ignore non-primary mouse buttons
        if (e.button !== undefined && e.button !== 0) return;
        e.preventDefault();
        el.setAttribute('data-dragging', '');
        try { el.setPointerCapture(e.pointerId); } catch (_) {}
        el.focus({ preventScroll: true });
        setPosition(positionFromEvent(e));

        function onMove(ev) {
          if (ev.pointerId !== e.pointerId) return;
          setPosition(positionFromEvent(ev));
        }
        function onEnd(ev) {
          if (ev.pointerId !== e.pointerId) return;
          el.removeEventListener('pointermove', onMove);
          el.removeEventListener('pointerup', onEnd);
          el.removeEventListener('pointercancel', onEnd);
          el.removeAttribute('data-dragging');
          try { el.releasePointerCapture(e.pointerId); } catch (_) {}
        }
        el.addEventListener('pointermove', onMove);
        el.addEventListener('pointerup', onEnd);
        el.addEventListener('pointercancel', onEnd);
      });

      el.addEventListener('keydown', function (e) {
        var current = getCurrent();
        var next = current;
        switch (e.key) {
          case 'ArrowLeft':
          case 'ArrowDown':
            next = current - step; break;
          case 'ArrowRight':
          case 'ArrowUp':
            next = current + step; break;
          case 'PageDown':
            next = current - pageStep; break;
          case 'PageUp':
            next = current + pageStep; break;
          case 'Home':
            next = min; break;
          case 'End':
            next = max; break;
          default:
            return;
        }
        e.preventDefault();
        setPosition(next);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Hero — Pixel Perfect",
  "tag": "section",
  "class": "ds-section ds-section--hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Before/after slider (top priority)"
    },
    {
      "type": "paragraph",
      "content": "Drag-to-compare visual that fills the right column. Set BOTH images for the slider to render; otherwise the section falls back to the video / image / placeholder below."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image",
      "info": "The base layer — visible on the LEFT side of the slider when dragged. e.g. the original, un-pixelated render."
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image",
      "info": "The top layer — visible on the RIGHT side of the slider when dragged. e.g. the Pixel Perfect output of the same source. Same dimensions as the before image for clean comparison."
    },
    {
      "type": "range",
      "id": "starting_position",
      "label": "Starting position",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%",
      "info": "Where the divider sits on initial load. 0 = full After visible, 100 = full Before, 50 = centered."
    },
    {
      "type": "header",
      "content": "Fallback: video or static image"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video",
      "info": "Used when before/after slider isn't set. Plays muted on loop. Encode at 1200×1200."
    },
    {
      "type": "image_picker",
      "id": "visual",
      "label": "Hero visual (static)",
      "info": "Used when neither the slider nor a video is set. 1200×1200 square render recommended. Falls back to the BACKLIT CSS-art placeholder if empty."
    }
  ],
  "blocks": [
    { "type": "ds-eyebrow"    },
    { "type": "ds-hero-title" },
    { "type": "ds-meta-strip" },
    { "type": "ds-rich-text"  },
    { "type": "ds-button-row" }
  ],
  "presets": [
    {
      "name": "Hero — Pixel Perfect",
      "blocks": [
        { "type": "ds-eyebrow",    "settings": { "text": "Introducing", "accent": "PIXEL PERFECT v1.0" } },
        { "type": "ds-hero-title", "settings": { "text": "Real pixels.\nOne slider.", "spotlight": false } },
        { "type": "ds-meta-strip", "settings": { "item_1": "PS 23.3+", "item_2": "UXP plugin", "item_3": "Live now", "last_has_dot": true } },
        { "type": "ds-rich-text"  },
        { "type": "ds-button-row" }
      ]
    }
  ]
}
{% endschema %}
