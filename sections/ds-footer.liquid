{%- comment -%}
  sections/ds-footer.liquid — Disrupted Studio site-wide footer

  Replaces Horizon's stock footer (Email signup + columns) and footer-
  utilities (copyright + policies + social) sections entirely with a
  single brutalist 4-col composition + legal row + giant wordmark.

  Lives in `sections/footer-group.json` (configured at the theme.liquid
  level). Shows on every page.

  Layout:
    [ Brand+blurb ] [ Link col 1 ] [ Link col 2 ] [ Newsletter+social ]
    --------- Legal row (copyright + payment chips) ---------
    ============ Giant DISRUPTED® wordmark ============

  Section settings:
    color_scheme
    brand_name              text  — big "DISRUPTED STUDIO" mark
    brand_blurb             textarea — short studio bio paragraph
    copyright_text          text  — e.g. "© 2026 Disrupted Studio · All rights reserved"
    show_payment_chips      bool
    payment_chips           text  — comma-separated chip labels (VISA, MC, AMEX, …)
    show_wordmark           bool
    wordmark_text           text
    show_wordmark_reg       bool  — toggle the ® mark
    instagram_url           url
    x_url                   url
    youtube_url             url
    tiktok_url              url
    facebook_url            url
    email_address           text  — email for the "envelope" social link

  Section blocks (merchant-managed):
    link_column         heading + menu (linklist picker)
    newsletter_column   heading + lead + form placeholder/button + tag
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
-%}

<footer class="ftF color-{{ cs }}" role="contentinfo">
  <div class="ftF__frame">
    <div class="ftF__grid">

      <section class="ftF__cell ftF__b-brand">
        {%- if section.settings.brand_use_logo and section.settings.brand_logo != blank -%}
          <a href="{{ routes.root_url }}" class="ftF__logo-link" aria-label="{{ shop.name | escape }}">
            {{ section.settings.brand_logo | image_url: width: 440 | image_tag: class: 'ftF__logo-img', alt: shop.name, widths: '160,240,320,440', loading: 'lazy' }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="ftF__wordmark-txt">{{ section.settings.brand_name | default: shop.name }}</a>
        {%- endif -%}
        {%- if section.settings.brand_blurb != blank -%}
          <p class="ftF__blurb">{{ section.settings.brand_blurb }}</p>
        {%- endif -%}
      </section>

      {%- assign col_n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          {%- assign col_n = col_n | plus: 1 -%}
          <nav class="ftF__cell" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <p class="ftF__tag"><b>INDEX</b> // {{ block.settings.heading }} <span class="ftF__no">{{ col_n | prepend: '0' }}</span></p>
            {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
              <ul class="ftF__list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a class="ftF__link" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}

      {%- assign col_n = col_n | plus: 1 -%}
      <section class="ftF__cell ftF__b-connect ftF__accent" aria-label="Connect">
        <p class="ftF__tag"><b>CONNECT</b> // SOCIAL <span class="ftF__no">{{ col_n | prepend: '0' }}</span></p>
        <div class="ftF__social">
          {%- if section.settings.instagram_url != blank -%}<a class="ftF__soc" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a>{%- endif -%}
          {%- if section.settings.x_url != blank -%}<a class="ftF__soc" href="{{ section.settings.x_url }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21l-6.52 7.45L22 22h-6.72l-5.26-6.91L3.94 22H1.18l6.99-7.99L1 2h6.83l4.75 6.31L18.244 2zm-1.18 18h1.83L7.04 4H5.1l11.964 16z"/></svg><span>X</span></a>{%- endif -%}
          {%- if section.settings.youtube_url != blank -%}<a class="ftF__soc" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.6-.46-5.3a2.78 2.78 0 0 0-2-2C18.86 4 12 4 12 4s-6.86 0-8.54.7a2.78 2.78 0 0 0-2 2C1 8.4 1 12 1 12s0 3.6.46 5.3a2.78 2.78 0 0 0 2 2C5.14 20 12 20 12 20s6.86 0 8.54-.7a2.78 2.78 0 0 0 2-2C23 15.6 23 12 23 12zM10 15.5v-7l6 3.5-6 3.5z"/></svg><span>YouTube</span></a>{%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}<a class="ftF__soc" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.32 5.59A5.6 5.6 0 0 1 16.5 2h-3.41v13.34a3.13 3.13 0 0 1-3.12 3.05A3.12 3.12 0 0 1 6.85 15.3a3.12 3.12 0 0 1 3.12-3.05c.32 0 .63.05.92.13V8.9a6.56 6.56 0 0 0-.92-.06A6.42 6.42 0 0 0 3.55 15.3a6.42 6.42 0 0 0 6.42 6.42 6.42 6.42 0 0 0 6.42-6.42V9.16a8.97 8.97 0 0 0 5.16 1.63V7.4a5.62 5.62 0 0 1-2.23-1.81z"/></svg><span>TikTok</span></a>{%- endif -%}
          {%- if section.settings.facebook_url != blank -%}<a class="ftF__soc" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.1 5.66 21.27 10.44 22v-7.02H7.9v-2.91h2.54V9.87c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.34V22C18.34 21.27 22 17.1 22 12.07z"/></svg><span>Facebook</span></a>{%- endif -%}
          {%- if section.settings.email_address != blank -%}<a class="ftF__soc" href="mailto:{{ section.settings.email_address }}" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="M3 6.5 12 13l9-6.5"/></svg><span>Email</span></a>{%- endif -%}
        </div>
      </section>

      <section class="ftF__cell ftF__b-legal">
        <p class="ftF__copy">{{ section.settings.copyright_text | default: '© Disrupted Minds Studio · All rights reserved' }}</p>
        {%- if section.settings.show_payment_chips and section.settings.payment_chips != blank -%}
          <div class="ftF__chips">
            {%- assign chips = section.settings.payment_chips | split: ',' -%}
            {%- for chip in chips -%}<span class="ftF__chip">{{ chip | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
      </section>

    </div>
  </div>
</footer>

{% style %}
  /* ds-footer — brutalist 4-col footer matching mockup lines 3060-3138 */
  .ds-footer {
    background: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid var(--color-border);
  }
  .ds-footer__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
    padding-top: clamp(48px, 5vw, 72px);
    padding-bottom: var(--space-5);
  }

  /* Grid: brand wider, then equal cols, with newsletter slightly wider */
  .ds-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: clamp(32px, 4vw, 64px);
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  @media (max-width: 900px) {
    .ds-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6) var(--space-5);
    }
    .ds-footer__brand,
    .ds-footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 500px) {
    .ds-footer__grid { grid-template-columns: 1fr; }
    .ds-footer__brand,
    .ds-footer__col--newsletter { grid-column: auto; }
  }

  /* Brand column */
  .ds-footer__brand-mark {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .ds-footer__brand-logo-link {
    display: inline-block;
    margin-bottom: var(--space-4);
  }
  .ds-footer__brand-logo {
    display: block;
    height: var(--ds-footer-logo-h, 34px);
    width: auto;
    max-width: 220px;
  }
  .ds-footer__brand-blurb {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    max-width: 44ch;
    line-height: 1.55;
    margin: 0;
  }

  /* Link columns */
  .ds-footer__col-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .ds-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-footer__link {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-footer__link:hover { color: var(--color-fg); }

  /* Newsletter column */
  .ds-footer__newsletter-lead {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
    max-width: 36ch;
    line-height: 1.5;
  }
  .ds-footer__newsletter-form { margin: 0; }
  .ds-footer__newsletter-inner {
    display: flex;
    border: 1px solid var(--color-border-strong);
    transition: border-color var(--t-fast) var(--ease);
    margin-bottom: var(--space-4);
  }
  .ds-footer__newsletter-inner:focus-within { border-color: var(--color-fg); }
  .ds-footer__newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    outline: none;
  }
  .ds-footer__newsletter-input::placeholder { color: var(--color-fg-faint); }
  .ds-footer__newsletter-btn {
    padding: 0 var(--space-4);
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-footer__newsletter-btn:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .ds-footer__newsletter-success {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  /* Social */
  .ds-footer__social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-3);
  }
  .ds-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    transition:
      color        var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .ds-footer__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Legal row */
  .ds-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .ds-footer__payment {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .ds-footer__chip {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--color-border-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
  }

  /* Wordmark — SVG with JS-measured viewBox.  See markup comment
     for the migration rationale.  No font-size clamp here; the
     SVG handles scale based on the runtime bbox measurement. */
  .ds-footer__wordmark {
    margin-top: clamp(32px, 5vw, 56px);
    padding: 0 var(--pad-x) clamp(16px, 2vw, 32px);
    user-select: none;
    overflow: hidden;   /* hard clip — the SVG inside is already
                           sized via max-width: 100% but this is
                           belt-and-braces against any sub-pixel
                           SVG content overflow on Mobile Safari. */
  }
  .ds-footer__wordmark-svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    overflow: hidden;
  }
  .ds-footer__wordmark-text {
    fill: var(--color-fg);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 100px;          /* SVG-coord base size for bbox math
                                   only; the viewBox scale handles
                                   actual rendered size. */
    letter-spacing: -0.055em;
  }
  .ds-footer__wordmark-reg-svg {
    fill: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0;
  }

  /* ============================================================
     Phone overrides for the footer newsletter form (≤500px).
     Placed at the END of the stylesheet so they win the cascade
     against the base .ds-footer__newsletter-* rules earlier in
     the file (same lesson as ds-newsletter-card).

     Stack input + button vertically and drop the unified flex
     border.  On mobile the horizontal form was overflowing the
     footer column on narrow screens — the button's intrinsic
     width plus the input's min-width pushed the wrapper past the
     right edge of the column.  Stacking removes that pressure
     entirely AND matches the brutalist treatment of the card
     newsletter form.
     ============================================================ */
  @media (max-width: 500px) {
    .ds-footer__newsletter-inner {
      flex-direction: column;
      border: 0;
      gap: var(--space-2);
      margin-bottom: var(--space-3);
    }
    .ds-footer__newsletter-inner:focus-within {
      border-color: transparent;
    }
    .ds-footer__newsletter-input {
      border: 1px solid var(--color-border-strong);
      padding: 14px 16px;
      width: 100%;
      box-sizing: border-box;
      transition: border-color var(--t-fast) var(--ease);
    }
    .ds-footer__newsletter-input:focus {
      border-color: var(--color-fg);
      outline: none;
    }
    .ds-footer__newsletter-btn {
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.16em;
    }
  }

  /* ============================================================
     FOOTER — Spec-Sheet F (rebuild). Old .ds-footer__* rules above
     are now dead (markup uses .ftF__*). Theme-tokenised. */
  .ftF{container-type:inline-size;background:var(--color-bg);color:var(--color-fg);font-family:var(--font-sans);border-top:1px solid var(--color-border);--cell:rgba(241,231,229,.26);}
  .ftF *{box-sizing:border-box;}
  .ftF__frame{border:2px solid var(--cell);margin:clamp(30px,5vw,54px) clamp(16px,4vw,30px) clamp(20px,4vw,30px);}
  .ftF__grid{display:grid;grid-template-columns:1fr;}
  .ftF__cell{border-bottom:2px solid var(--cell);padding:20px 18px;min-width:0;}
  .ftF__cell:last-child{border-bottom:0;}
  .ftF__tag{display:flex;align-items:baseline;gap:8px;font-family:var(--font-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--color-fg-muted);margin:0 0 16px;white-space:nowrap;}
  .ftF__tag b{color:var(--color-fg);font-weight:700;}
  .ftF__no{margin-left:auto;color:var(--color-fg-muted);letter-spacing:.1em;}
  .ftF__logo-link{display:inline-block;}
  .ftF__logo-img{display:block;height:26px;width:auto;margin:0 0 16px;}
  .ftF__wordmark-txt{display:inline-block;font-family:var(--font-sans);font-weight:700;font-size:20px;letter-spacing:-.01em;text-transform:uppercase;color:var(--color-fg);text-decoration:none;margin:0 0 16px;}
  .ftF__blurb{margin:0;max-width:44ch;font-size:13px;line-height:1.55;color:var(--color-fg);}
  .ftF__blurb b{color:#E0525B;font-weight:700;}
  .ftF__list{list-style:none;margin:0;padding:0;}
  .ftF__list li{border-top:1px solid var(--color-border);}
  .ftF__list li:first-child{border-top:0;}
  .ftF__link{display:flex;align-items:center;gap:10px;padding:9px 0;color:var(--color-fg);text-decoration:none;font-size:13.5px;font-weight:600;letter-spacing:.01em;cursor:pointer;transition:color .12s,padding .12s;}
  .ftF__link::before{content:"";width:6px;height:6px;flex:0 0 auto;background:var(--color-fg-muted);transition:background .12s,transform .12s;}
  .ftF__link:hover{color:#E0525B;padding-left:4px;}
  .ftF__link:hover::before{background:var(--color-accent);transform:rotate(45deg);}
  .ftF__accent{background:var(--color-accent);color:var(--color-accent-fg);}
  .ftF__accent .ftF__tag,.ftF__accent .ftF__tag b,.ftF__accent .ftF__no{color:var(--color-accent-fg);}
  .ftF__accent .ftF__tag{opacity:.9;}
  .ftF__social{display:flex;flex-direction:column;gap:12px;}
  .ftF__soc{display:flex;align-items:center;gap:12px;padding:11px 12px;border:1.5px solid rgba(241,231,229,.55);color:var(--color-accent-fg);text-decoration:none;font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;transition:background .12s,color .12s;}
  .ftF__soc svg{width:20px;height:20px;flex:0 0 auto;display:block;}
  .ftF__soc span{margin-right:auto;}
  .ftF__soc:hover{background:var(--color-accent-fg);color:var(--color-accent);}
  .ftF__b-legal{display:flex;flex-direction:column;gap:12px;}
  .ftF__copy{margin:0;font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;color:var(--color-fg-muted);line-height:1.5;}
  .ftF__chips{display:flex;flex-wrap:wrap;gap:8px;}
  .ftF__chip{border:1.5px solid var(--cell);padding:6px 9px;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.1em;color:var(--color-fg);text-transform:uppercase;white-space:nowrap;}
  @container (min-width:720px){
    .ftF__grid{grid-template-columns:2fr 1fr 1fr 1.3fr;}
    .ftF__cell{border-right:2px solid var(--cell);border-bottom:2px solid var(--cell);padding:26px 24px;}
    .ftF__b-connect{border-right:0;}
    .ftF__b-legal{grid-column:1 / -1;border-bottom:0;border-right:0;flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px 32px;}
    .ftF__logo-img{height:30px;}
  }

{% endstyle %}

<script>
  // Wordmark fit — see markup + CSS comments above for rationale.
  // Mirrors the approach in sections/ds-wordmark.liquid:
  //   1. RAF after load — fast first paint at the right size
  //   2. Double-RAF after fonts.ready — accurate measure once the
  //      web font has been applied AND a layout pass has run
  //      (iOS Safari can leave layout one frame stale after font swap)
  //   3. Debounced resize listener — recompute on viewport change
  //
  // Inset padding uses the LARGER of:
  //   • 6% of bbox.height (handles short text where width is small)
  //   • 1.5% of bbox.width (handles long text where height-based
  //     padding would scale to too few rendered pixels)
  // This ensures enough breathing room to absorb getBBox under-
  // reporting glyph side-bearings under negative letter-spacing,
  // and Mobile Safari rendering glyph outlines a sub-pixel past
  // their reported bbox.
  (function () {
    document.querySelectorAll('[data-ds-footer-wordmark]').forEach(function (svg) {
      var text = svg.querySelector('text');
      if (!text) return;
      function fit() {
        try {
          var bbox = text.getBBox();
          if (bbox.width > 0 && bbox.height > 0) {
            var pad = Math.max(bbox.height * 0.06, bbox.width * 0.015);
            svg.setAttribute(
              'viewBox',
              (bbox.x - pad) + ' ' +
              (bbox.y - pad) + ' ' +
              (bbox.width + pad * 2) + ' ' +
              (bbox.height + pad * 2)
            );
          }
        } catch (e) {
          // getBBox throws if detached/hidden — retry on next event.
        }
      }
      requestAnimationFrame(fit);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () {
          requestAnimationFrame(function () {
            requestAnimationFrame(fit);
          });
        });
      }
      var resizeTimer = null;
      window.addEventListener('resize', function () {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(fit, 100);
      }, { passive: true });
    });
  })();
</script>

{% schema %}
{
  "name": "Disrupted footer",
  "tag": "footer",
  "class": "ds-section ds-section--footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    { "type": "header", "content": "Brand" },
    {
      "type": "checkbox",
      "id": "brand_use_logo",
      "default": true,
      "label": "Use logo instead of name",
      "info": "Shows the logo image. Defaults to your theme's inverse (light) logo. Turn off to show the text brand mark below."
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Footer logo (optional)",
