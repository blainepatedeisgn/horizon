{%- comment -%}
  sections/ds-footer.liquid — Disrupted Studio site-wide footer

  Replaces Horizon's stock footer (Email signup + columns) and footer-
  utilities (copyright + policies + social) sections entirely with a
  single brutalist 4-col composition + legal row + giant wordmark.

  Lives in `sections/footer-group.json` (configured at the theme.liquid
  level). Shows on every page.

  Layout:
    [ Brand+blurb ] [ Link col 1 ] [ Link col 2 ] [ Newsletter+social ]
    --------- Legal row (copyright + payment chips) ---------
    ============ Giant DISRUPTED® wordmark ============

  Section settings:
    color_scheme
    brand_name              text  — big "DISRUPTED STUDIO" mark
    brand_blurb             textarea — short studio bio paragraph
    copyright_text          text  — e.g. "© 2026 Disrupted Studio · All rights reserved"
    show_payment_chips      bool
    payment_chips           text  — comma-separated chip labels (VISA, MC, AMEX, …)
    show_wordmark           bool
    wordmark_text           text
    show_wordmark_reg       bool  — toggle the ® mark
    instagram_url           url
    x_url                   url
    youtube_url             url
    tiktok_url              url
    facebook_url            url
    email_address           text  — email for the "envelope" social link

  Section blocks (merchant-managed):
    link_column         heading + menu (linklist picker)
    newsletter_column   heading + lead + form placeholder/button + tag
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme | default: 'scheme-1'
-%}

<footer class="ds-footer color-{{ cs }}">
  <div class="ds-footer__inner">

    <div class="ds-footer__grid">
      {%- comment -%} ----- BRAND ----- {%- endcomment -%}
      <div class="ds-footer__brand">
        {%- if section.settings.brand_name != blank -%}
          <div class="ds-footer__brand-mark">{{ section.settings.brand_name }}</div>
        {%- endif -%}
        {%- if section.settings.brand_blurb != blank -%}
          <p class="ds-footer__brand-blurb">{{ section.settings.brand_blurb }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ----- BLOCKS (link columns + newsletter) ----- {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'link_column' -%}
            <div class="ds-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="ds-footer__col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                <ul class="ds-footer__links">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}" class="ds-footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'newsletter_column' -%}
            <div class="ds-footer__col ds-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="ds-footer__col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.lead != blank -%}
                <p class="ds-footer__newsletter-lead">{{ block.settings.lead }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'ds-footer__newsletter-form' -%}
                {%- if block.settings.tag != blank -%}
                  <input type="hidden" name="contact[tags]" value="{{ block.settings.tag }}">
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <p class="ds-footer__newsletter-success">{{ block.settings.success_message | default: 'Thanks.' }}</p>
                {%- else -%}
                  <div class="ds-footer__newsletter-inner">
                    <input
                      type="email"
                      name="contact[email]"
                      class="ds-footer__newsletter-input"
                      placeholder="{{ block.settings.placeholder | default: 'your@email.com' }}"
                      aria-label="Email address"
                      required
                    >
                    <button type="submit" class="ds-footer__newsletter-btn">
                      {{ block.settings.button_label | default: 'Subscribe' }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endform -%}

              {%- comment -%} Social icons ----- {%- endcomment -%}
              {%- liquid
                assign has_social = false
                if section.settings.instagram_url != blank or section.settings.x_url != blank or section.settings.youtube_url != blank or section.settings.tiktok_url != blank or section.settings.facebook_url != blank or section.settings.email_address != blank
                  assign has_social = true
                endif
              -%}
              {%- if has_social and block.settings.show_social -%}
                <ul class="ds-footer__social" aria-label="Social links">
                  {%- if section.settings.instagram_url != blank -%}
                    <li><a href="{{ section.settings.instagram_url }}" class="ds-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="0"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
                    </a></li>
                  {%- endif -%}
                  {%- if section.settings.x_url != blank -%}
                    <li><a href="{{ section.settings.x_url }}" class="ds-footer__social-link" aria-label="X" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18.244 2H21l-6.52 7.45L22 22h-6.72l-5.26-6.91L3.94 22H1.18l6.99-7.99L1 2h6.83l4.75 6.31L18.244 2zm-1.18 18h1.83L7.04 4H5.1l11.964 16z"/></svg>
                    </a></li>
                  {%- endif -%}
                  {%- if section.settings.youtube_url != blank -%}
                    <li><a href="{{ section.settings.youtube_url }}" class="ds-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23 12s0-3.6-.46-5.3a2.78 2.78 0 0 0-2-2C18.86 4 12 4 12 4s-6.86 0-8.54.7a2.78 2.78 0 0 0-2 2C1 8.4 1 12 1 12s0 3.6.46 5.3a2.78 2.78 0 0 0 2 2C5.14 20 12 20 12 20s6.86 0 8.54-.7a2.78 2.78 0 0 0 2-2C23 15.6 23 12 23 12zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
                    </a></li>
                  {%- endif -%}
                  {%- if section.settings.tiktok_url != blank -%}
                    <li><a href="{{ section.settings.tiktok_url }}" class="ds-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.32 5.59A5.6 5.6 0 0 1 16.5 2h-3.41v13.34a3.13 3.13 0 0 1-3.12 3.05A3.12 3.12 0 0 1 6.85 15.3a3.12 3.12 0 0 1 3.12-3.05c.32 0 .63.05.92.13V8.9a6.56 6.56 0 0 0-.92-.06A6.42 6.42 0 0 0 3.55 15.3a6.42 6.42 0 0 0 6.42 6.42 6.42 6.42 0 0 0 6.42-6.42V9.16a8.97 8.97 0 0 0 5.16 1.63V7.4a5.62 5.62 0 0 1-2.23-1.81z"/></svg>
                    </a></li>
                  {%- endif -%}
                  {%- if section.settings.facebook_url != blank -%}
                    <li><a href="{{ section.settings.facebook_url }}" class="ds-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.1 5.66 21.27 10.44 22v-7.02H7.9v-2.91h2.54V9.87c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.34V22C18.34 21.27 22 17.1 22 12.07z"/></svg>
                    </a></li>
                  {%- endif -%}
                  {%- if section.settings.email_address != blank -%}
                    <li><a href="mailto:{{ section.settings.email_address }}" class="ds-footer__social-link" aria-label="Email">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="0"/><path d="M2 5l10 8L22 5"/></svg>
                    </a></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ----- LEGAL ROW ----- {%- endcomment -%}
    <div class="ds-footer__legal">
      <span class="ds-footer__copyright">
        {{- section.settings.copyright_text | default: '© Disrupted Studio · All rights reserved' -}}
      </span>
      {%- if section.settings.show_payment_chips and section.settings.payment_chips != blank -%}
        {%- assign chips = section.settings.payment_chips | split: ',' -%}
        <div class="ds-footer__payment">
          {%- for chip in chips -%}
            <span class="ds-footer__chip">{{ chip | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ----- WORDMARK -----

    Renders as an SVG whose viewBox is measured at runtime to match
    the rendered text bbox exactly.  The SVG is `width: 100%` so it
    fills the container; the viewBox + preserveAspectRatio="meet"
    handles the scale.

    Replaces a previous CSS `font-size: clamp(56px, 19vw, 200px)`
    approach which overflowed the viewport on narrow widths — at
    19vw on a 375px phone, "DISRUPTED" at letter-spacing -0.045em
    rendered ~450px wide and overflowed the ~337px container.  Both
    `white-space: nowrap` AND `overflow: hidden` couldn't save it
    because the text simply didn't fit; the bottom-right "D" was
    visibly clipped.  Measuring the text and scaling the SVG to fit
    the container guarantees no overflow on any viewport width.
    Same approach as sections/ds-wordmark.liquid.
  {%- endcomment -%}
  {%- if section.settings.show_wordmark -%}
    {%- assign wm_text = section.settings.wordmark_text | default: 'DISRUPTED' -%}
    <div class="ds-footer__wordmark" aria-hidden="true">
      <svg
        class="ds-footer__wordmark-svg"
        data-ds-footer-wordmark
        aria-hidden="true"
        viewBox="0 0 600 100"
        preserveAspectRatio="xMidYMid meet"
      >
        <text
          class="ds-footer__wordmark-text"
          x="0"
          y="0"
          dominant-baseline="text-before-edge"
        >{{- wm_text | escape -}}{%- if section.settings.show_wordmark_reg -%}<tspan class="ds-footer__wordmark-reg-svg" baseline-shift="super" font-size="0.45em" dx="0.2em">®</tspan>{%- endif -%}</text>
      </svg>
    </div>
  {%- endif -%}
</footer>

{% style %}
  /* ds-footer — brutalist 4-col footer matching mockup lines 3060-3138 */
  .ds-footer {
    background: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid var(--color-border);
  }
  .ds-footer__inner {
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
    padding-top: clamp(48px, 5vw, 72px);
    padding-bottom: var(--space-5);
  }

  /* Grid: brand wider, then equal cols, with newsletter slightly wider */
  .ds-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: clamp(32px, 4vw, 64px);
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  @media (max-width: 900px) {
    .ds-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6) var(--space-5);
    }
    .ds-footer__brand,
    .ds-footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 500px) {
    .ds-footer__grid { grid-template-columns: 1fr; }
    .ds-footer__brand,
    .ds-footer__col--newsletter { grid-column: auto; }
  }

  /* Brand column */
  .ds-footer__brand-mark {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .ds-footer__brand-blurb {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    max-width: 44ch;
    line-height: 1.55;
    margin: 0;
  }

  /* Link columns */
  .ds-footer__col-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-caps);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .ds-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-footer__link {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }
  .ds-footer__link:hover { color: var(--color-fg); }

  /* Newsletter column */
  .ds-footer__newsletter-lead {
    font-size: var(--fs-small);
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
    max-width: 36ch;
    line-height: 1.5;
  }
  .ds-footer__newsletter-form { margin: 0; }
  .ds-footer__newsletter-inner {
    display: flex;
    border: 1px solid var(--color-border-strong);
    transition: border-color var(--t-fast) var(--ease);
    margin-bottom: var(--space-4);
  }
  .ds-footer__newsletter-inner:focus-within { border-color: var(--color-fg); }
  .ds-footer__newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    background: transparent;
    border: 0;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    outline: none;
  }
  .ds-footer__newsletter-input::placeholder { color: var(--color-fg-faint); }
  .ds-footer__newsletter-btn {
    padding: 0 var(--space-4);
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease);
  }
  .ds-footer__newsletter-btn:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .ds-footer__newsletter-success {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  /* Social */
  .ds-footer__social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-3);
  }
  .ds-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    transition:
      color        var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .ds-footer__social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Legal row */
  .ds-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .ds-footer__payment {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .ds-footer__chip {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--color-border-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
  }

  /* Wordmark — SVG with JS-measured viewBox.  See markup comment
     for the migration rationale.  No font-size clamp here; the
     SVG handles scale based on the runtime bbox measurement. */
  .ds-footer__wordmark {
    margin-top: clamp(32px, 5vw, 56px);
    padding: 0 var(--pad-x) clamp(16px, 2vw, 32px);
    user-select: none;
    overflow: hidden;   /* hard clip — the SVG inside is already
                           sized via max-width: 100% but this is
                           belt-and-braces against any sub-pixel
                           SVG content overflow on Mobile Safari. */
  }
  .ds-footer__wordmark-svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    overflow: hidden;
  }
  .ds-footer__wordmark-text {
    fill: var(--color-fg);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 100px;          /* SVG-coord base size for bbox math
                                   only; the viewBox scale handles
                                   actual rendered size. */
    letter-spacing: -0.055em;
  }
  .ds-footer__wordmark-reg-svg {
    fill: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0;
  }

  /* ============================================================
     Phone overrides for the footer newsletter form (≤500px).
     Placed at the END of the stylesheet so they win the cascade
     against the base .ds-footer__newsletter-* rules earlier in
     the file (same lesson as ds-newsletter-card).

     Stack input + button vertically and drop the unified flex
     border.  On mobile the horizontal form was overflowing the
     footer column on narrow screens — the button's intrinsic
     width plus the input's min-width pushed the wrapper past the
     right edge of the column.  Stacking removes that pressure
     entirely AND matches the brutalist treatment of the card
     newsletter form.
     ============================================================ */
  @media (max-width: 500px) {
    .ds-footer__newsletter-inner {
      flex-direction: column;
      border: 0;
      gap: var(--space-2);
      margin-bottom: var(--space-3);
    }
    .ds-footer__newsletter-inner:focus-within {
      border-color: transparent;
    }
    .ds-footer__newsletter-input {
      border: 1px solid var(--color-border-strong);
      padding: 14px 16px;
      width: 100%;
      box-sizing: border-box;
      transition: border-color var(--t-fast) var(--ease);
    }
    .ds-footer__newsletter-input:focus {
      border-color: var(--color-fg);
      outline: none;
    }
    .ds-footer__newsletter-btn {
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.16em;
    }
  }
{% endstyle %}

<script>
  // Wordmark fit — see markup + CSS comments above for rationale.
  // Mirrors the approach in sections/ds-wordmark.liquid:
  //   1. RAF after load — fast first paint at the right size
  //   2. Double-RAF after fonts.ready — accurate measure once the
  //      web font has been applied AND a layout pass has run
  //      (iOS Safari can leave layout one frame stale after font swap)
  //   3. Debounced resize listener — recompute on viewport change
  //
  // Inset padding uses the LARGER of:
  //   • 6% of bbox.height (handles short text where width is small)
  //   • 1.5% of bbox.width (handles long text where height-based
  //     padding would scale to too few rendered pixels)
  // This ensures enough breathing room to absorb getBBox under-
  // reporting glyph side-bearings under negative letter-spacing,
  // and Mobile Safari rendering glyph outlines a sub-pixel past
  // their reported bbox.
  (function () {
    document.querySelectorAll('[data-ds-footer-wordmark]').forEach(function (svg) {
      var text = svg.querySelector('text');
      if (!text) return;
      function fit() {
        try {
          var bbox = text.getBBox();
          if (bbox.width > 0 && bbox.height > 0) {
            var pad = Math.max(bbox.height * 0.06, bbox.width * 0.015);
            svg.setAttribute(
              'viewBox',
              (bbox.x - pad) + ' ' +
              (bbox.y - pad) + ' ' +
              (bbox.width + pad * 2) + ' ' +
              (bbox.height + pad * 2)
            );
          }
        } catch (e) {
          // getBBox throws if detached/hidden — retry on next event.
        }
      }
      requestAnimationFrame(fit);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () {
          requestAnimationFrame(function () {
            requestAnimationFrame(fit);
          });
        });
      }
      var resizeTimer = null;
      window.addEventListener('resize', function () {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(fit, 100);
      }, { passive: true });
    });
  })();
</script>

{% schema %}
{
  "name": "Disrupted footer",
  "tag": "footer",
  "class": "ds-section ds-section--footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    { "type": "header", "content": "Brand" },
    {
      "type": "text",
      "id": "brand_name",
      "default": "DISRUPTED STUDIO",
      "label": "Brand mark"
    },
    {
      "type": "textarea",
      "id": "brand_blurb",
      "default": "A small studio building plugins, type, and graphic assets for designers. Made in Atlanta, GA. One-time purchase, free updates.",
      "label": "Brand blurb"
    },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "x_url",         "label": "X (Twitter) URL" },
    { "type": "url", "id": "youtube_url",   "label": "YouTube URL" },
    { "type": "url", "id": "tiktok_url",    "label": "TikTok URL" },
    { "type": "url", "id": "facebook_url",  "label": "Facebook URL" },
    { "type": "text", "id": "email_address", "label": "Email address", "info": "Renders as a mailto: link." },
    { "type": "header", "content": "Legal" },
    {
      "type": "text",
      "id": "copyright_text",
      "default": "© 2026 Disrupted Studio · All rights reserved",
      "label": "Copyright text"
    },
    {
      "type": "checkbox",
      "id": "show_payment_chips",
      "default": true,
      "label": "Show payment chips"
    },
    {
      "type": "text",
      "id": "payment_chips",
      "default": "Visa, MC, AmEx, PayPal, Apple Pay, Shop",
      "label": "Payment chips (comma-separated)"
    },
    { "type": "header", "content": "Wordmark" },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "default": true,
      "label": "Show giant wordmark below footer"
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "default": "DISRUPTED",
      "label": "Wordmark text"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark_reg",
      "default": true,
      "label": "Show ® mark"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
