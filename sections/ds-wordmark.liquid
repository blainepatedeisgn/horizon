{%- comment -%}
  sections/ds-wordmark.liquid — Giant footer-of-page wordmark

  Renders the brand text as an SVG that fills 100% of its container
  exactly, regardless of viewport width OR text length.  This works
  because the SVG's viewBox is set to match the rendered text's
  bounding box (measured once via JS after fonts load + on resize),
  and the SVG itself is `width: 100%`.  Result: the wordmark scales
  fluidly from phone to wide desktop, edge-to-edge inside the
  `--pad-x` page margins, with no overflow at narrow widths and no
  under-fill at wide widths.

  Replaces the previous CSS `font-size: clamp(48px, 16.5vw, 600px)`
  approach, which was calibrated for "DISRUPTED" specifically and
  broke if the merchant changed the text, AND overflowed on mobile
  when the device width × 17vw exceeded `container width − 2 × pad`.

  Accessibility: the wordmark is decorative (the brand name is
  already in the header logo) so the SVG is `aria-hidden="true"`.
{%- endcomment -%}

{%- liquid
  assign cs = section.settings.color_scheme
  assign text = section.settings.text | default: 'DISRUPTED'
-%}

<div class="ds-wordmark color-{{ cs }}">
  {%- comment -%}
    Default viewBox is a sensible starting ratio so the SVG renders
    at roughly the right size before JS measures.  The JS overrides
    it with the actual text bbox once fonts are ready.
  {%- endcomment -%}
  <svg
    class="ds-wordmark__svg"
    data-ds-wordmark
    aria-hidden="true"
    viewBox="0 0 600 100"
    preserveAspectRatio="xMidYMid meet"
  >
    <text
      class="ds-wordmark__svg-text"
      x="0"
      y="0"
      dominant-baseline="text-before-edge"
    >{{- text | escape -}}{%- if section.settings.show_registration_mark -%}<tspan class="ds-wordmark__svg-reg" baseline-shift="super" font-size="0.45em" dx="0.2em">®</tspan>{%- endif -%}</text>
  </svg>
</div>

{% style %}
  .ds-wordmark {
    background: var(--color-background);
    color: var(--color-foreground);
    padding-top: clamp(16px, 2vw, 32px);
    padding-bottom: clamp(16px, 2vw, 32px);
    padding-left: var(--pad-x);
    padding-right: var(--pad-x);
    overflow: hidden;   /* belt-and-braces — if the JS hasn't fired yet
                           and the default viewBox ratio doesn't match
                           the real text, the parent clips the overflow */
  }
  .ds-wordmark__svg {
    display: block;
    width: 100%;
    max-width: 100%;    /* belt-and-braces: never exceed container width */
    height: auto;
    user-select: none;
    /* No `overflow: visible` here — Mobile Safari has bugs where SVG
       content with overflow:visible ignores the parent's overflow:hidden,
       leading to text bleeding past the right edge of the viewport on
       narrow widths.  The SVG's UA default `overflow: hidden` clips
       content to the viewBox, which is fine because the JS adds a small
       padding inset to the viewBox to absorb glyph-edge sub-pixels. */
  }
  .ds-wordmark__svg-text {
    fill: var(--color-fg);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 100px;          /* base size — only used for bbox math.
                                   The SVG's viewBox/scale handles the
                                   actual rendered size. */
    letter-spacing: -0.055em;
  }
  .ds-wordmark__svg-reg {
    fill: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0;
  }
{% endstyle %}

<script>
  (function () {
    // Measure the wordmark text's bounding box and set the SVG's
    // viewBox to match — this makes the SVG fill its container
    // exactly, regardless of viewport width or text length.
    //
    // Runs three times in sequence:
    //   1. On script load — immediate so something renders fast
    //   2. After fonts are ready — refines the measurement once the
    //      real font replaces the fallback (most accurate)
    //   3. On resize — debounced; recomputes on viewport change
    document.querySelectorAll('[data-ds-wordmark]').forEach(function (svg) {
      var text = svg.querySelector('text');
      if (!text) return;

      function fit() {
        try {
          var bbox = text.getBBox();
          if (bbox.width > 0 && bbox.height > 0) {
            // Small inset around the measured bbox.  getBBox doesn't
            // always include the last glyph's right side-bearing when
            // there's negative letter-spacing — without this padding
            // the rightmost glyph would slip past the viewBox edge,
            // visible as a 1–3px overflow on the right side of the
            // wordmark on mobile.  3% of bbox height is enough to
            // absorb the side-bearing without making the wordmark
            // visibly smaller.
            var pad = bbox.height * 0.03;
            svg.setAttribute(
              'viewBox',
              (bbox.x - pad) + ' ' +
              (bbox.y - pad) + ' ' +
              (bbox.width + pad * 2) + ' ' +
              (bbox.height + pad * 2)
            );
          }
        } catch (e) {
          // getBBox can throw if the element is detached or hidden;
          // ignore — the next call (fonts.ready or resize) will retry.
        }
      }

      // Defer the first measurement to the next animation frame so
      // layout is settled and getBBox returns accurate values.  On
      // mobile Safari, calling getBBox during the parse phase (before
      // first paint) can return stale dimensions based on the default
      // SVG intrinsic size (300×150 px) rather than the styled text.
      requestAnimationFrame(fit);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(fit);
      }

      // Debounce resize so we don't measure on every scroll-bar-induced
      // resize event during a viewport drag.
      var resizeTimer = null;
      window.addEventListener('resize', function () {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(fit, 100);
      }, { passive: true });
    });
  })();
</script>

{% schema %}
{
  "name": "Wordmark",
  "tag": "section",
  "class": "ds-section ds-section--wordmark",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "text",
      "default": "DISRUPTED",
      "label": "Text",
      "info": "Brand wordmark. Renders as an SVG that fills the container exactly at any viewport width — any text length works (short or long), no manual size calibration needed."
    },
    {
      "type": "checkbox",
      "id": "show_registration_mark",
      "default": true,
      "label": "Show ® mark",
      "info": "Small mono superscript registration symbol after the wordmark."
    }
  ],
  "presets": [
    {
      "name": "Wordmark"
    }
  ]
}
{% endschema %}
