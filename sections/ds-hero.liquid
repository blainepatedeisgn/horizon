{%- comment -%}
  sections/ds-hero.liquid — Disrupted Studio homepage hero.

  Two layouts in one section:

    Desktop (>900px):   [ content blocks  |  visual ]
                        Side-by-side grid columns.

    Mobile (≤900px):    eyebrow
                        H1 title
                        VISUAL                  ← inserted between
                        meta strip
                        description
                        CTA buttons

  Implementation
    The visual is rendered TWICE — once as `--desktop` (a direct child
    of .ds-hero, column 2 of the grid) and once as `--mobile` (inside
    .ds-hero__content, after the content blocks).  CSS show/hide based
    on viewport.  CSS `order` on the content's flex children positions
    the mobile visual right after the H1 title block.

    Why duplicate instead of moving via JS: the previous JS-based
    approach worked for the move, but the constrain-on-mobile CSS
    kept losing the cascade battle for reasons that weren't worth
    chasing further (suspected interaction with the .ds-backlit-render
    snippet's own <style> block render order).  Duplicating gives each
    copy its own clean, dedicated CSS context with no contextual
    selectors or !important needed.

    Cost: the visual markup renders twice in HTML.  For the placeholder
    fallback (CSS-only) this is just DOM weight.  For an uploaded image,
    the same URL appears in two <img> tags — the browser image cache
    dedupes the actual network fetch.
{%- endcomment -%}

{%- liquid
  assign visual = section.settings.visual
  assign cs = section.settings.color_scheme
-%}

{%- comment -%}
  Two macros — keep the visual markup DRY across the two copies.
  Liquid doesn't have real macros, so we use a `capture` block.
{%- endcomment -%}
{%- capture visual_markup -%}
  <div class="ds-hero__visual-inner">
    {%- if visual != blank -%}
      {{
        visual
        | image_url: width: 1200
        | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 900px) 50vw, 100vw',
            class: 'ds-hero__visual-img'
      }}
    {%- else -%}
      {%- render 'ds-backlit-render-fallback' -%}
    {%- endif -%}
  </div>
{%- endcapture -%}

<div class="ds-hero color-{{ cs }}">
  <div class="ds-hero__content">
    {%- content_for 'blocks' -%}

    {%- comment -%}
      Mobile-only visual.  CSS hides on desktop, shows on mobile.
      Positioned between H1 and meta-strip via CSS `order` (see
      stylesheet's @media (max-width: 900px) block).
    {%- endcomment -%}
    <div class="ds-hero__visual ds-hero__visual--mobile">
      {{ visual_markup }}
    </div>
  </div>

  {%- comment -%}
    Desktop-only visual.  CSS hides on mobile, shows on desktop as
    grid column 2.
  {%- endcomment -%}
  <div class="ds-hero__visual ds-hero__visual--desktop">
    {{ visual_markup }}
  </div>
</div>

{% style %}
  .ds-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
    position: relative;
    padding: clamp(24px, 3vw, 48px) 0;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .ds-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: var(--pad-x);
    padding-right: clamp(24px, 4vw, 56px);
    z-index: 2;
  }
  .ds-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-right: var(--pad-x);
    min-height: 360px;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.04), transparent 60%);
  }
  .ds-hero__visual-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-hero__visual-img {
    width: min(94%, 480px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    display: block;
  }

  /* Desktop: hide the mobile copy, show the desktop copy.
     The desktop copy is sibling to .ds-hero__content so it falls
     into grid column 2 naturally. */
  .ds-hero__visual--mobile  { display: none; }
  .ds-hero__visual--desktop { display: flex; }

  /* Tighten the in-hero variants of block styles */
  .ds-hero .ds-eyebrow .ds-mono {
    color: var(--color-accent);
    font-size: 11px;
  }
  .ds-hero .ds-rich-text { max-width: 38ch; }

  /* Display title with white glow halo (static) + optional animated
     orange spotlight (.ds-hero-title--spotlight) that orbits behind
     the text. The spotlight is an on-brand demo of BACKLIT itself. */
  .ds-hero-title {
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.04em;
    position: relative;
    display: inline-block;
    margin: 0;
    isolation: isolate;
  }
  .ds-hero-title__glow {
    position: absolute;
    inset: 0;
    filter: blur(48px);
    color: #FFFFFF;
    opacity: 0.15;
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }

  .ds-hero-title--spotlight::before {
    content: "";
    position: absolute;
    inset: -15%;
    background:
      radial-gradient(
        circle at center,
        rgba(255, 77, 31, 0.55) 0%,
        rgba(255, 77, 31, 0.22) 28%,
        rgba(255, 77, 31, 0) 60%
      );
    filter: blur(40px);
    z-index: -2;
    pointer-events: none;
    user-select: none;
    animation: ds-hero-spotlight 9s ease-in-out infinite;
    will-change: transform, opacity;
    mix-blend-mode: screen;
  }
  @keyframes ds-hero-spotlight {
    0%   { transform: translate(-10%,  -8%) scale(0.95); opacity: 0.85; }
    20%  { transform: translate(  6%, -10%) scale(1.05); opacity: 1;    }
    40%  { transform: translate( 12%,   3%) scale(1.0);  opacity: 0.95; }
    60%  { transform: translate(  2%,  10%) scale(1.08); opacity: 1;    }
    80%  { transform: translate(-10%,   6%) scale(0.95); opacity: 0.9;  }
    100% { transform: translate(-10%,  -8%) scale(0.95); opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-hero-title--spotlight::before {
      animation: none;
      transform: translate(0, 0) scale(1);
    }
  }

  /* ============================================================
     MOBILE LAYOUT (≤900px)
     ============================================================
     - Hero collapses to single column
     - Desktop visual hidden, mobile visual shown
     - Mobile visual positioned via CSS `order` to sit RIGHT UNDER
       the H1 title (between title and meta-strip)
     - Mobile visual gets its own clean CSS — no contextual
       selectors, no !important, no cascade gymnastics.  It's a
       different element with its own class hooks. */
  @media (max-width: 900px) {
    .ds-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-5);
      padding-bottom: var(--space-7);
    }
    .ds-hero__content {
      padding-right: var(--pad-x);
    }

    /* Swap which copy shows on mobile */
    .ds-hero__visual--desktop { display: none; }
    .ds-hero__visual--mobile  { display: flex; }

    /* Position the mobile visual right after the H1 title via flex
       order.  Default order is 0 for all flex children; setting
       explicit orders here changes the VISUAL order without touching
       the DOM.  We position by block class so the merchant can
       reorder blocks in the editor and the visual still lands right
       after the title.

       Title gets order 1 (we want it second after eyebrow but
       before the visual).  Eyebrow stays default (0) so it appears
       first.  Mobile visual gets order 2 (between title and rest).
       Everything else stays default — they appear in source order
       after the visual. */
    .ds-hero__content > .ds-eyebrow      { order: 0; }
    .ds-hero__content > .ds-hero-title   { order: 1; }
    .ds-hero__content > .ds-hero__visual--mobile { order: 2; }
    .ds-hero__content > .ds-meta-strip   { order: 3; }
    .ds-hero__content > .ds-sale-tag     { order: 4; }
    .ds-hero__content > .ds-rich-text    { order: 5; }
    .ds-hero__content > .ds-button-row   { order: 6; }

    /* Mobile visual's own styling — completely independent of the
       desktop one, so no inheritance fights. */
    .ds-hero__visual--mobile {
      padding: 0;
      min-height: 0;
      background: none;
      width: 100%;
      max-width: 280px;
      margin: var(--space-3) auto var(--space-2);
      align-self: center;
    }
    .ds-hero__visual--mobile .ds-hero__visual-img,
    .ds-hero__visual--mobile .ds-backlit-render {
      width: 100%;
      max-width: 280px;
    }
  }
  @media (max-width: 480px) {
    .ds-hero__visual--mobile {
      max-width: 240px;
      margin-top: var(--space-4);
    }
    .ds-hero__visual--mobile .ds-hero__visual-img,
    .ds-hero__visual--mobile .ds-backlit-render {
      max-width: 240px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "ds-section ds-section--hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "image_picker",
      "id": "visual",
      "label": "Hero visual",
      "info": "Recommend a 1200×1200 square render. Falls back to the BACKLIT CSS-art placeholder if empty."
    }
  ],
  "blocks": [
    { "type": "ds-eyebrow"    },
    { "type": "ds-hero-title" },
    { "type": "ds-meta-strip" },
    { "type": "ds-rich-text"  },
    { "type": "ds-button-row" }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "ds-eyebrow",    "settings": { "text": "Introducing", "accent": "BACKLIT v1.0" } },
        { "type": "ds-hero-title", "settings": { "text": "Real light.\nOne click." } },
        { "type": "ds-meta-strip", "settings": { "item_1": "PS 2022+", "item_2": "UXP plugin", "item_3": "Live now", "last_has_dot": true } },
        { "type": "ds-rich-text"  },
        { "type": "ds-button-row" }
      ]
    }
  ]
}
{% endschema %}
