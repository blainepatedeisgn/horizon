{%- comment -%}
  sections/ds-hero.liquid — Disrupted Studio homepage hero.

  Two-column grid on desktop:
    [ content blocks  | visual (image or CSS-art fallback) ]
  Stacks on <=900px: content above, visual below.

  Content area is `{% content_for 'blocks' %}` — merchant adds/orders any of
  the allowed theme blocks (eyebrow, title, meta strip, rich text, button row)
  via the theme editor. Preset auto-populates with the BACKLIT defaults.

  Visual is a section image_picker; if blank, renders the BACKLIT CSS-art
  snippet (placeholder until a real product render is shot for launch).
{%- endcomment -%}

{%- liquid
  assign hero_video = section.settings.hero_video
  assign visual = section.settings.visual
  assign cs = section.settings.color_scheme
-%}

<div class="ds-hero color-{{ cs }}">
  <div class="ds-hero__content">
    {%- content_for 'blocks' -%}
  </div>

  <div class="ds-hero__visual">
    <div class="ds-hero__visual-inner">
      {%- if hero_video != blank -%}
        {%- comment -%}
          Manual <video> (not the video_tag filter) so we get playsinline
          (iOS Safari refuses to autoplay without it) and preload=auto
          for the hero. Poster pulls from the video's auto-generated
          first frame so there's no blank box while sources fetch.
        {%- endcomment -%}
        <video
          class="ds-hero__visual-img ds-hero__visual-video"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          poster="{{ hero_video.preview_image | image_url: width: 1200 }}"
        >
          {%- for source in hero_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif visual != blank -%}
        {{
          visual
          | image_url: width: 1200
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw',
              class: 'ds-hero__visual-img'
        }}
      {%- else -%}
        {%- render 'ds-backlit-render-fallback' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .ds-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
    position: relative;
    padding: clamp(24px, 3vw, 48px) 0;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .ds-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: var(--pad-x);
    padding-right: clamp(24px, 4vw, 56px);
    z-index: 2;
  }
  .ds-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-right: var(--pad-x);
    min-height: 360px;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.04), transparent 60%);
  }
  .ds-hero__visual-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-hero__visual-img,
  .ds-hero__visual-video {
    width: min(94%, 480px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    display: block;
  }

  /* Tighten the in-hero variants of block styles */
  .ds-hero .ds-eyebrow .ds-mono {
    color: var(--color-accent);
    font-size: 11px;
  }
  .ds-hero .ds-rich-text { max-width: 38ch; }

  /* Display title with white glow halo (static) + optional animated
     orange spotlight (.ds-hero-title--spotlight) that orbits behind
     the text. The spotlight is an on-brand demo of BACKLIT itself. */
  .ds-hero-title {
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.04em;
    position: relative;
    display: inline-block;
    margin: 0;
    /* Tame overflow so the spotlight pseudo can extend beyond the
       glyph bounds without pushing siblings around. */
    isolation: isolate;
  }
  /* Static white halo — slightly diffused duplicate of the text */
  .ds-hero-title__glow {
    position: absolute;
    inset: 0;
    filter: blur(48px);
    color: #FFFFFF;
    opacity: 0.15;
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }

  /* ----- Animated spotlight ----- */
  .ds-hero-title--spotlight::before {
    content: "";
    position: absolute;
    /* Modest overhang — keeps the spotlight close to the text rather
       than letting it roam over surrounding space. */
    inset: -15%;
    background:
      radial-gradient(
        circle at center,
        rgba(255, 77, 31, 0.55) 0%,
        rgba(255, 77, 31, 0.22) 28%,
        rgba(255, 77, 31, 0) 60%
      );
    filter: blur(40px);
    z-index: -2;
    pointer-events: none;
    user-select: none;
    /* Slow figure-eight orbit — tightened range so the light traces
       just behind the glyphs, not across the whole hero. */
    animation: ds-hero-spotlight 9s ease-in-out infinite;
    will-change: transform, opacity;
    /* Mix the warm spotlight in additively over the (dark) bg */
    mix-blend-mode: screen;
  }
  @keyframes ds-hero-spotlight {
    0%   { transform: translate(-10%,  -8%) scale(0.95); opacity: 0.85; }
    20%  { transform: translate(  6%, -10%) scale(1.05); opacity: 1;    }
    40%  { transform: translate( 12%,   3%) scale(1.0);  opacity: 0.95; }
    60%  { transform: translate(  2%,  10%) scale(1.08); opacity: 1;    }
    80%  { transform: translate(-10%,   6%) scale(0.95); opacity: 0.9;  }
    100% { transform: translate(-10%,  -8%) scale(0.95); opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-hero-title--spotlight::before {
      animation: none;
      /* Park the spotlight roughly centered so users with reduced
         motion still see the glow effect, just stationary. */
      transform: translate(0, 0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .ds-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-5);
      padding-bottom: var(--space-7);
    }
    .ds-hero__content {
      padding-right: var(--pad-x);
    }
    .ds-hero__visual {
      min-height: 0;
      padding: 0 var(--pad-x);
    }
  }
  @media (max-width: 480px) {
    .ds-hero__visual { padding: 0 var(--space-3); }
  }
{% endstyle %}

<script>
  /* Reduced-motion: pause hero videos for users who've asked the OS to
     limit motion. Muted, looped hero video is mild (closer to a GIF
     than to true animation), but pausing is the safer default — users
     still see the poster frame as a still image. */
  (function () {
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.ds-hero__visual-video').forEach(function (v) {
      v.removeAttribute('autoplay');
      v.pause();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "ds-section ds-section--hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video",
      "info": "Optional. If set, plays in place of the image — muted, looping, 1:1 square. Encode at 1200×1200 so the layout matches the image. The first frame is used as the poster while loading; reduced-motion users see it as a still."
    },
    {
      "type": "image_picker",
      "id": "visual",
      "label": "Hero visual",
      "info": "Recommend a 1200×1200 square render. Used when no video is set, and as the fallback for the CSS-art placeholder if both are empty."
    }
  ],
  "blocks": [
    { "type": "ds-eyebrow"    },
    { "type": "ds-hero-title" },
    { "type": "ds-meta-strip" },
    { "type": "ds-rich-text"  },
    { "type": "ds-button-row" }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "ds-eyebrow",    "settings": { "text": "Introducing", "accent": "BACKLIT v1.0" } },
        { "type": "ds-hero-title", "settings": { "text": "Real light.\nOne click." } },
        { "type": "ds-meta-strip", "settings": { "item_1": "PS 2022+", "item_2": "UXP plugin", "item_3": "Live now", "last_has_dot": true } },
        { "type": "ds-rich-text"  },
        { "type": "ds-button-row" }
      ]
    }
  ]
}
{% endschema %}
