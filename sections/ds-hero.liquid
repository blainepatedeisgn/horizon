{%- comment -%}
  sections/ds-hero.liquid — Disrupted Studio homepage hero.

  Two-column grid on desktop:
    [ content blocks  | visual (image or CSS-art fallback) ]
  Stacks on <=900px: content above, visual below.

  Content area is `{% content_for 'blocks' %}` — merchant adds/orders any of
  the allowed theme blocks (eyebrow, title, meta strip, rich text, button row)
  via the theme editor. Preset auto-populates with the BACKLIT defaults.

  Visual is a section image_picker; if blank, renders the BACKLIT CSS-art
  snippet (placeholder until a real product render is shot for launch).
{%- endcomment -%}

{%- liquid
  assign visual = section.settings.visual
  assign cs = section.settings.color_scheme
-%}

<div class="ds-hero color-{{ cs }}">
  <div class="ds-hero__content">
    {%- content_for 'blocks' -%}
  </div>

  <div class="ds-hero__visual">
    <div class="ds-hero__visual-inner">
      {%- if visual != blank -%}
        {{
          visual
          | image_url: width: 1200
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw',
              class: 'ds-hero__visual-img'
        }}
      {%- else -%}
        {%- render 'ds-backlit-render-fallback' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .ds-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
    position: relative;
    padding: clamp(24px, 3vw, 48px) 0;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .ds-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: var(--pad-x);
    padding-right: clamp(24px, 4vw, 56px);
    z-index: 2;
  }
  .ds-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-right: var(--pad-x);
    min-height: 360px;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.04), transparent 60%);
  }
  .ds-hero__visual-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-hero__visual-img {
    width: min(94%, 480px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Tighten the in-hero variants of block styles */
  .ds-hero .ds-eyebrow .ds-mono {
    color: var(--color-accent);
    font-size: 11px;
  }
  .ds-hero .ds-rich-text { max-width: 38ch; }

  /* Display title with white glow halo */
  .ds-hero-title {
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.04em;
    position: relative;
    display: inline-block;
    margin: 0;
  }
  .ds-hero-title__glow {
    position: absolute;
    inset: 0;
    filter: blur(48px);
    color: #FFFFFF;
    opacity: 0.15;
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .ds-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-5);
      padding-bottom: var(--space-7);
    }
    .ds-hero__content {
      padding-right: var(--pad-x);
    }
    .ds-hero__visual {
      min-height: 0;
      padding: 0 var(--pad-x);
    }
  }
  @media (max-width: 480px) {
    .ds-hero__visual { padding: 0 var(--space-3); }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "ds-section ds-section--hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "image_picker",
      "id": "visual",
      "label": "Hero visual",
      "info": "Recommend a 1200×1200 square render. Falls back to the BACKLIT CSS-art placeholder if empty."
    }
  ],
  "blocks": [
    { "type": "ds-eyebrow"    },
    { "type": "ds-hero-title" },
    { "type": "ds-meta-strip" },
    { "type": "ds-rich-text"  },
    { "type": "ds-button-row" }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "ds-eyebrow",    "settings": { "text": "Introducing", "accent": "BACKLIT v1.0" } },
        { "type": "ds-hero-title", "settings": { "text": "Real light.\nOne click." } },
        { "type": "ds-meta-strip", "settings": { "item_1": "PS 2022+", "item_2": "UXP plugin", "item_3": "Live now", "last_has_dot": true } },
        { "type": "ds-rich-text"  },
        { "type": "ds-button-row" }
      ]
    }
  ]
}
{% endschema %}
