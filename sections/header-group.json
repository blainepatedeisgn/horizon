/*
 * ------------------------------------------------------------
 * Disrupted Studio header group (Phase 4 Batches 3 + 6)
 *
 * Replaces Horizon's stock header-announcements + header sections
 * with our custom equivalents:
 *   ds-announce-bar  — rotating tagline strip (orange by default)
 *   ds-header        — brutalist logo + nav + search + cart + mobile drawer
 * ------------------------------------------------------------
 */
{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "ds_announce": {
      "type": "ds-announce-bar",
      "blocks": {
        "tagline_1": {
          "type": "tagline",
          "settings": { "text": "Tools for designers who hate generic tools" }
        },
        "tagline_2": {
          "type": "tagline",
          "settings": { "text": "Real assets. No AI. Hand-built." }
        },
        "tagline_3": {
          "type": "tagline",
          "settings": { "text": "Bought once, owned forever." }
        },
        "tagline_4": {
          "type": "tagline",
          "settings": { "text": "30-day money-back guarantee" }
        }
      },
      "block_order": [
        "tagline_1",
        "tagline_2",
        "tagline_3",
        "tagline_4"
      ],
      "settings": {
        "fill_style": "orange",
        "interval": 5,
        "show_arrows": true,
        "pause_on_hover": true
      }
    },
    "ds_header": {
      "type": "ds-header",
      "settings": {
        "color_scheme": "scheme-1",
        "logo_text": "DISRUPTED STUDIO",
        "main_menu": "main-menu",
        "show_search": true,
        "show_cart": true,
        "sticky": true
      }
    }
  },
  "order": [
    "ds_announce",
    "ds_header"
  ]
}
