{%- comment -%}
  sections/ds-announce-bar.liquid — Disrupted Studio rotating announcement bar

  Replaces Horizon's stock `header-announcements`. Lives in
  sections/header-group.json as the FIRST section above ds-header.

  Behaviour
    • Cycles through N tagline blocks (cross-fade between items)
    • Auto-rotates every N seconds (configurable 3–15, default 5)
    • Manual prev/next arrows let the visitor step through
    • Pauses on hover/focus for readability
    • Respects prefers-reduced-motion (no auto-rotate)
    • If only one tagline, behaves as a static bar (no arrows, no timer)

  Fills
    orange (default) | dark (off-white text) | light (off-white bg, dark text)

  Each tagline block:
    text          — the message (mono caps in render)
    url           — optional link target; renders a → arrow + clickable item

  No external deps. JS is inline + scoped via [data-ds-announce].
{%- endcomment -%}

{%- liquid
  assign blocks         = section.blocks
  assign interval_s     = section.settings.interval | default: 5
  assign show_arrows    = section.settings.show_arrows
  assign pause_on_hover = section.settings.pause_on_hover
  assign fill           = section.settings.fill_style | default: 'orange'
-%}

{%- if blocks.size > 0 -%}
<div
  class="ds-announce ds-announce--{{ fill }}"
  data-ds-announce
  data-interval="{{ interval_s | times: 1000 }}"
  {% if pause_on_hover %}data-pause-on-hover="true"{% endif %}
  role="region"
  aria-label="Announcement"
  aria-live="polite"
>
  <div class="ds-announce__inner">
    {%- if show_arrows and blocks.size > 1 -%}
      <button
        type="button"
        class="ds-announce__nav ds-announce__nav--prev"
        aria-label="Previous announcement"
        data-ds-announce-prev
      >←</button>
    {%- endif -%}

    <div class="ds-announce__viewport" data-ds-announce-viewport>
      {%- for block in blocks -%}
        {%- liquid
          assign text = block.settings.text
          assign url  = block.settings.url
          assign is_first = false
          if forloop.first
            assign is_first = true
          endif
        -%}
        {%- if url != blank -%}
          <a
            href="{{ url }}"
            class="ds-announce__item{% if is_first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {% unless is_first %}aria-hidden="true" tabindex="-1"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <span class="ds-announce__text">{{ text }}</span>
            <span class="ds-announce__link-arrow" aria-hidden="true">→</span>
          </a>
        {%- else -%}
          <span
            class="ds-announce__item{% if is_first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {% unless is_first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <span class="ds-announce__text">{{ text }}</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if show_arrows and blocks.size > 1 -%}
      <button
        type="button"
        class="ds-announce__nav ds-announce__nav--next"
        aria-label="Next announcement"
        data-ds-announce-next
      >→</button>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<script>
  (function () {
    var bar = document.querySelector('[data-ds-announce]');
    if (!bar) return;

    var items = bar.querySelectorAll('.ds-announce__item');
    if (items.length <= 1) return;

    var interval = parseInt(bar.dataset.interval, 10) || 5000;
    var pauseOnHover = bar.dataset.pauseOnHover === 'true';
    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0;
    var timer = null;

    function show(index) {
      // Wrap around either direction
      var len = items.length;
      var next = ((index % len) + len) % len;
      if (next === current) return;

      var oldEl = items[current];
      var newEl = items[next];

      oldEl.classList.remove('is-active');
      oldEl.setAttribute('aria-hidden', 'true');
      if (oldEl.tagName === 'A') oldEl.setAttribute('tabindex', '-1');

      newEl.classList.add('is-active');
      newEl.removeAttribute('aria-hidden');
      if (newEl.tagName === 'A') newEl.removeAttribute('tabindex');

      current = next;
    }

    function next() { show(current + 1); }
    function prev() { show(current - 1); }

    function start() {
      stop();
      if (prefersReduced) return;
      timer = window.setInterval(next, interval);
    }
    function stop() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    start();

    if (pauseOnHover) {
      bar.addEventListener('mouseenter', stop);
      bar.addEventListener('mouseleave', start);
      bar.addEventListener('focusin', stop);
      bar.addEventListener('focusout', start);
    }

    var prevBtn = bar.querySelector('[data-ds-announce-prev]');
    var nextBtn = bar.querySelector('[data-ds-announce-next]');
    if (prevBtn) prevBtn.addEventListener('click', function () { prev(); start(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { next(); start(); });
  })();
</script>

{% style %}
  /* ------------------------------------------------------------
     ds-announce-bar — rotating tagline strip above the header
     Local --bar-h overrides the global --announce-h for a slimmer
     32px strip — keeps tap targets workable while feeling lighter.
     ------------------------------------------------------------ */
  .ds-announce {
    --bar-h: 32px;
    position: relative;
    min-height: var(--bar-h);
    overflow: hidden;
  }
  /* Fills */
  .ds-announce--orange {
    background: var(--color-accent, #FF4D1F);
    color: var(--color-accent-fg, #0A0A0A);
  }
  .ds-announce--dark {
    background: var(--color-bg, #000);
    color: var(--color-fg, #F2F0EC);
    border-bottom: 1px solid var(--color-border);
  }
  .ds-announce--light {
    background: var(--color-fg, #F2F0EC);
    color: var(--color-bg, #000);
  }

  .ds-announce__inner {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--pad-x);
    min-height: var(--bar-h);
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Prev/next arrow buttons */
  .ds-announce__nav {
    background: transparent;
    border: 0;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    padding: 0 var(--space-2);
    opacity: 0.6;
    transition: opacity var(--t-fast) var(--ease);
    /* Touch target — full bar height so tap area stays workable */
    min-width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-announce__nav:hover,
  .ds-announce__nav:focus-visible { opacity: 1; }
  .ds-announce__nav:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: -4px;
  }

  /* Viewport holds all items stacked absolutely; only the active one fades in */
  .ds-announce__viewport {
    position: relative;
    flex: 1 1 auto;
    min-height: var(--bar-h);
    /* Constrain inner content width so long taglines don't push the bar wide */
    min-width: 0;
  }

  .ds-announce__item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    padding: 0 var(--space-2);
    /* Cross-fade */
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }
  .ds-announce__item.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  /* Long messages on narrow screens: shrink type, allow wrap if needed */
  @media (max-width: 600px) {
    .ds-announce { --bar-h: 30px; }
    .ds-announce__item {
      white-space: normal;
      text-align: center;
      font-size: 10px;
      letter-spacing: 0.1em;
      line-height: 1.2;
    }
  }

  /* Link arrow nudge on hover (for tagline items that have a URL) */
  .ds-announce__link-arrow {
    display: inline-block;
    transition: transform var(--t-fast) var(--ease);
  }
  a.ds-announce__item:hover .ds-announce__link-arrow {
    transform: translateX(3px);
  }

  /* Mobile: tighten gutters, smaller arrows */
  @media (max-width: 600px) {
    .ds-announce__inner { padding: 0 var(--space-2); }
    .ds-announce__nav { font-size: 11px; min-width: 24px; }
  }

  /* Respect reduced motion — JS already skips auto-rotate; also kill fade */
  @media (prefers-reduced-motion: reduce) {
    .ds-announce__item { transition: none; }
    .ds-announce__link-arrow { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Disrupted announce",
  "tag": "section",
  "class": "ds-section ds-section--announce",
  "settings": [
    {
      "type": "select",
      "id": "fill_style",
      "label": "Fill",
      "options": [
        { "value": "orange", "label": "Orange (accent)" },
        { "value": "dark",   "label": "Dark (off-white text)" },
        { "value": "light",  "label": "Light (off-white bg)" }
      ],
      "default": "orange"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Auto-rotate every (seconds)",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev/next arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause auto-rotate on hover",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Add taglines below. The bar will cycle through them automatically. Each tagline can optionally link to a collection, page or product."
    }
  ],
  "blocks": [
    {
      "type": "tagline",
      "name": "Tagline",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Text",          "default": "New tagline" },
        { "type": "url",  "id": "url",  "label": "Optional link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Disrupted announce",
      "settings": { "fill_style": "orange", "interval": 5 },
      "blocks": [
        { "type": "tagline", "settings": { "text": "Tools for designers who hate generic tools" } },
        { "type": "tagline", "settings": { "text": "Real assets. No AI. Hand-built." } },
        { "type": "tagline", "settings": { "text": "Bought once, owned forever." } },
        { "type": "tagline", "settings": { "text": "30-day money-back guarantee" } }
      ]
    }
  ]
}
{% endschema %}
