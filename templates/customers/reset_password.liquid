{%- comment -%}
  templates/customers/reset_password.liquid

  Rendered when a customer clicks the reset link in the password-recovery
  email. The form POSTs to {% form 'reset_customer_password' %} which
  validates the token (Shopify handles via the URL itself) and updates
  the password on success.
{%- endcomment -%}

{%- render 'ds-customer-styles' -%}

<section class="ds-account">
  <div class="ds-account__container ds-account__container--narrow">

    <header class="ds-account__header">
      <p class="ds-account__eyebrow">[ ACCOUNT ]</p>
      <h1 class="ds-account__title">Set new password</h1>
      <p class="ds-account__intro">
        Enter a new password for your account. You'll be signed in automatically once it's saved.
      </p>
    </header>

    {%- form 'reset_customer_password', class: 'ds-form' -%}
      {%- if form.errors -%}
        <ul class="ds-form__errors">
          {%- for error in form.errors -%}
            <li>{{ form.errors.messages[error] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="ds-form__row">
        <label class="ds-form__label" for="reset-password">New password</label>
        <input
          type="password"
          id="reset-password"
          name="customer[password]"
          class="ds-form__input"
          autocomplete="new-password"
          minlength="5"
          required
        >
        <p class="ds-form__hint">5 characters minimum.</p>
      </div>

      <div class="ds-form__row">
        <label class="ds-form__label" for="reset-password-confirm">Confirm new password</label>
        <input
          type="password"
          id="reset-password-confirm"
          name="customer[password_confirmation]"
          class="ds-form__input"
          autocomplete="new-password"
          minlength="5"
          required
        >
      </div>

      <div class="ds-form__submit-row">
        <button type="submit" class="ds-btn ds-btn--lg ds-btn--accent">
          Update password
        </button>
      </div>

      <p class="ds-form__alt">
        <a href="/account/login">← Back to sign in</a>
      </p>
    {%- endform -%}

  </div>
</section>
