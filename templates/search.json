/*
 * ------------------------------------------------------------
 * Disrupted Studio — SEARCH results template
 *
 * Renders at /search?q=… (when the shopper clicks "View all results →"
 * in the header search dropdown, presses Enter, or visits directly).
 *
 * Replaces Horizon's block-based search-header + search-results sections
 * with our single ds-search-results section, which reuses the collection
 * page's layout primitives so search + collection share one visual
 * system (filter sidebar, sort, grid, pagination).
 *
 * Content is product-scoped because the header search form passes
 * type=product; products that match the query render as ds-product-card
 * with quick-add enabled.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "ds-search-results",
      "settings": {
        "color_scheme": "scheme-1",
        "products_per_page": 24
      }
    }
  },
  "order": ["main"]
}
