/*
 * ------------------------------------------------------------
 * Disrupted Studio default product page template (graphics, misc)
 *
 * Uses our custom ds-product-main section (replaces Horizon's
 * product-information). Phase 3 Batches 2-3 will append features
 * strip + FAQ + related sections.
 *
 * Per-product editable via standard product fields + metafields
 * (namespace: "disrupted"). See docs/changes.md for the metafield
 * definition setup steps.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "ds-product-main",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "features": {
      "type": "ds-pdp-features",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "faq": {
      "type": "ds-pdp-faq",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "Questions"
      }
    },
    "related": {
      "type": "ds-pdp-related",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "You might also like",
        "num_label": "03",
        "products_to_show": 3
      }
    }
  },
  "order": ["main", "features", "faq", "related"]
}
