/*
 * ------------------------------------------------------------
 * Disrupted Studio homepage
 *
 * Wires the three custom sections built in Phase 2 Batches 1-2.
 * Phase 2 Batches 3-4 will append category teasers, newsletter card,
 * and the giant footer wordmark.
 *
 * NB: This file is auto-managed by the Shopify admin theme editor —
 * direct edits there get saved here and may overwrite manual local
 * changes on the next CLI pull.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "hero": {
      "type": "ds-hero",
      "blocks": {
        "eyebrow": {
          "type": "ds-eyebrow",
          "settings": {
            "text": "Introducing",
            "accent": "BACKLIT v1.0"
          }
        },
        "title": {
          "type": "ds-hero-title",
          "settings": {
            "text": "Real light.\nOne click."
          }
        },
        "meta": {
          "type": "ds-meta-strip",
          "settings": {
            "item_1": "PS 2022+",
            "item_2": "UXP plugin",
            "item_3": "Live now",
            "last_has_dot": true
          }
        },
        "rich": {
          "type": "ds-rich-text"
        },
        "buttons": {
          "type": "ds-button-row"
        }
      },
      "block_order": ["eyebrow", "title", "meta", "rich", "buttons"]
    },
    "trust_marquee": {
      "type": "ds-trust-marquee",
      "blocks": {
        "logo_1":  { "type": "ds-trust-logo", "settings": { "text": "Adobe" } },
        "logo_2":  { "type": "ds-trust-logo", "settings": { "text": "Nike.",       "style": "bold"   } },
        "logo_3":  { "type": "ds-trust-logo", "settings": { "text": "Pentagram",   "style": "serif"  } },
        "logo_4":  { "type": "ds-trust-logo", "settings": { "text": "WARNER",      "style": "blocky" } },
        "logo_5":  { "type": "ds-trust-logo", "settings": { "text": "Vans",        "style": "script" } },
        "logo_6":  { "type": "ds-trust-logo", "settings": { "text": "ESPN",        "style": "mono"   } },
        "logo_7":  { "type": "ds-trust-logo", "settings": { "text": "Condé Nast",  "style": "thin"   } },
        "logo_8":  { "type": "ds-trust-logo", "settings": { "text": "Atlantic"  } },
        "logo_9":  { "type": "ds-trust-logo", "settings": { "text": "VICE",        "style": "bold"   } },
        "logo_10": { "type": "ds-trust-logo", "settings": { "text": "Ogilvy",      "style": "serif"  } },
        "logo_11": { "type": "ds-trust-logo", "settings": { "text": "Sony",        "style": "script" } },
        "logo_12": { "type": "ds-trust-logo", "settings": { "text": "COMPLEX",     "style": "mono"   } }
      },
      "block_order": [
        "logo_1", "logo_2", "logo_3",  "logo_4",  "logo_5",  "logo_6",
        "logo_7", "logo_8", "logo_9",  "logo_10", "logo_11", "logo_12"
      ]
    },
    "product_grid": {
      "type": "ds-product-grid"
    }
  },
  "order": ["hero", "trust_marquee", "product_grid"]
}
