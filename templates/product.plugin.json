/*
 * ------------------------------------------------------------
 * Disrupted Studio — PLUGIN product template (BACKLIT, FLUX, etc.)
 *
 * Used for products like BACKLIT, FLUX, etc. Assigned per-product
 * in admin via the "Theme template" dropdown.
 *
 * Section order:
 *   main → features → cta → video → faq → related
 *
 * Per-product content sources (all optional, hide sections gracefully):
 *   features  → product.metafields.disrupted.features (list of Feature)
 *   cta       → product.metafields.disrupted.ctas (list of CTA inset)
 *   video     → product.metafields.disrupted.video (single Video)
 *   faq       → product.metafields.disrupted.faq (list of FAQ item)
 *   related   → product.collections.first (auto)
 *
 * See docs/changes.md for metaobject + metafield definition setup.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "ds-product-main",
      "settings": {
        "color_scheme": "scheme-1",
        "sub_cta_label": "Watch the demo",
        "sub_cta_url": "#video"
      }
    },
    "features": {
      "type": "ds-pdp-features",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "cta": {
      "type": "ds-pdp-cta-inset",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "video": {
      "type": "ds-pdp-video",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "faq": {
      "type": "ds-pdp-faq",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "Common questions",
        "num_label": "06"
      }
    },
    "related": {
      "type": "ds-pdp-related",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "More tools",
        "num_label": "03",
        "products_to_show": 3
      }
    }
  },
  "order": ["main", "features", "cta", "video", "faq", "related"]
}
