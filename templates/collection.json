/*
 * ------------------------------------------------------------
 * Disrupted Studio — COLLECTION template
 *
 * Used for every collection page (/collections/X). Replaces Horizon's
 * default block-based collection template with our single custom
 * ds-collection-main section which renders:
 *   breadcrumb · title + count + sort · filter sidebar · product grid · pagination
 *
 * Filters and sort come from Shopify's native storefront filtering API
 * (collection.filters + collection.sort_options). Merchant enables them
 * in admin → Online Store → Navigation → Collection filters.
 *
 * If you ever need a different layout per collection (e.g. a hero banner
 * above the grid for a featured collection), duplicate this file as
 * collection.<handle>.json and edit there — Shopify picks the most
 * specific match per collection.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "ds-collection-main",
      "settings": {
        "color_scheme": "scheme-1",
        "products_per_page": 24
      }
    }
  },
  "order": ["main"]
}
