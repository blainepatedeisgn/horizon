{%- comment -%}
  snippets/ds-cart-products.liquid — Disrupted Studio cart line items

  Renders the cart drawer's items list (or empty state). Designed to be
  rendered inside Horizon's `<cart-items-component>` so we inherit all the
  AJAX wiring (remove, quantity update, section morphing) for free.

  Critical Horizon contract — DO NOT REMOVE these refs/attrs or AJAX breaks:
    ref="cartItemCount"                         — hidden total, kept in sync
    ref="cartItemRows[]"                        — array of <li> rows
    data-key="{{ item.key }}"                   — line-item identifier
    data-parent-key="..."                       — bundle nesting
    on:click="/onLineItemRemove/{N}"            — declarative remove handler
    ref="cartItemErrorContainer-{N}"            — per-row error box
    ref="cartItemError-{N}"                     — per-row error text
    <text-component>                            — animated price text update

  Params
    force_empty  — bool, render empty state regardless of cart contents

  Notes
    Quantity selector is rendered visually-hidden because Disrupted Studio
    sells digital downloads (quantity always 1). The component still needs
    it present to satisfy ref lookups during AJAX updates.
{%- endcomment -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="cart-items__wrapper ds-cart__items-wrap">
  {%- if cart.empty? or force_empty -%}
    {%- comment -%}
      Brutalist empty state — three category pills hand-routed to
      the merchant's main collections. The brand-voice copy
      ("Nothing loaded yet") nods to the digital-download context
      without being too clever. If collection handles on the live
      store differ from the defaults below, swap them inline —
      they're not configurable via section settings because this
      snippet renders inside both the cart drawer and the cart
      page and the schema lives on different files.
    {%- endcomment -%}
    <div class="ds-cart__empty">
      <p class="ds-cart__empty-text">Nothing loaded yet.</p>
      <div class="ds-cart__empty-cats">
        <a href="/collections/plugins" class="ds-cart__empty-cat">Plugins</a>
        <a href="/collections/fonts" class="ds-cart__empty-cat">Fonts</a>
        <a href="/collections/graphics" class="ds-cart__empty-cat">Graphics</a>
      </div>
    </div>
  {%- else -%}
    <span class="visually-hidden" ref="cartItemCount" aria-hidden="true">{{- cart.item_count -}}</span>

    <form
      action="{{ routes.cart_url }}"
      class="cart-form ds-cart__form"
      id="cart-form"
      method="post"
    >
      <ul class="ds-cart__items list-unstyled">
        {%- for item in cart.items -%}
          <li
            class="ds-cart__item"
            ref="cartItemRows[]"
            data-key="{{ item.key }}"
            data-parent-key="{{ item.parent_relationship.parent.key }}"
          >
            {%- comment -%} ----- IMAGE ----- {%- endcomment -%}
            <a href="{{ item.url }}" class="ds-cart__item-media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag:
                      class: 'ds-cart__item-img',
                      alt: item.product.title,
                      widths: '72,144,216',
                      loading: 'lazy'
                }}
              {%- else -%}
                <span class="ds-cart__item-img-placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </a>

            {%- comment -%} ----- INFO ----- {%- endcomment -%}
            <div class="ds-cart__item-info">
              <a href="{{ item.url }}" class="ds-cart__item-title">
                {{- item.product.title -}}
              </a>

              {%- if item.product.type != blank -%}
                <div class="ds-cart__item-cat">{{ item.product.type }}</div>
              {%- endif -%}

              {%- if item.product.has_only_default_variant == false -%}
                <div class="ds-cart__item-variant">
                  {%- for option in item.options_with_values -%}
                    {{ option.value }}{%- unless forloop.last -%} · {%- endunless -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if item.selling_plan_allocation -%}
                <div class="ds-cart__item-variant">{{ item.selling_plan_allocation.selling_plan.name }}</div>
              {%- endif -%}

              <div class="ds-cart__item-actions">
                <button
                  type="button"
                  class="ds-cart__item-remove"
                  on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                  aria-label="Remove {{ item.product.title | escape }}"
                >
                  Remove
                </button>
              </div>

              {%- comment -%}
                Hidden quantity selector — required for cart-items-component
                AJAX hooks. For digital products quantity is always 1.
              {%- endcomment -%}
              <div class="visually-hidden">
                {%- render 'quantity-selector',
                  product: item.product,
                  variant: item.variant,
                  in_cart_quantity: item.quantity,
                  line_index: item.index,
                  can_update_quantity: false
                -%}
              </div>
            </div>

            {%- comment -%} ----- PRICE ----- {%- endcomment -%}
            <div class="ds-cart__item-price">
              {%- assign price = item.final_line_price | money -%}
              <text-component value="{{ price | strip_html }}">{{ price }}</text-component>
              {%- if item.original_line_price != item.final_line_price -%}
                <s class="ds-cart__item-price-strike">{{ item.original_line_price | money }}</s>
              {%- endif -%}
            </div>

            {%- comment -%} ----- ERROR (hidden until JS shows it) ----- {%- endcomment -%}
            <div
              class="ds-cart__item-error hidden"
              ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
              role="alert"
            >
              <small
                class="ds-cart__item-error-text"
                ref="cartItemError-{{ item.index | plus: 1 }}"
              ></small>
            </div>

            {%- comment -%}
              ----- TIER UPSELL -----
              Find the cheapest next-higher-priced available variant of
              the same product. If one exists, render an upgrade nudge
              spanning full width below the line item. Click via the JS
              at the bottom of this snippet: remove this line, add the
              upgraded variant, reload to refresh cart UI.

              Skips itself silently for:
                • single-variant products (no upgrade target)
                • the highest-priced variant already in cart
                • products where no higher tier is available
            {%- endcomment -%}
            {%- assign sorted_variants = item.product.variants | sort: 'price' -%}
            {%- assign found_upsell = false -%}
            {%- assign upsell_v_id = 0 -%}
            {%- assign upsell_v_price = 0 -%}
            {%- assign upsell_v_title = '' -%}
            {%- for v in sorted_variants -%}
              {%- if found_upsell == false and v.id != item.variant_id and v.available and v.price > item.variant.price -%}
                {%- assign upsell_v_id = v.id -%}
                {%- assign upsell_v_price = v.price -%}
                {%- assign upsell_v_title = v.metafields.disrupted.tier_name | default: v.title -%}
                {%- assign found_upsell = true -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if found_upsell -%}
              {%- assign price_diff = upsell_v_price | minus: item.variant.price -%}
              <button
                type="button"
                class="ds-cart__upsell"
                data-ds-cart-upsell
                data-line-key="{{ item.key }}"
                data-upgrade-to="{{ upsell_v_id }}"
                aria-label="Upgrade {{ item.product.title | escape }} to {{ upsell_v_title | escape }} for {{ price_diff | money }} more"
              >
                <span class="ds-cart__upsell-text">Upgrade to {{ upsell_v_title }}</span>
                <span class="ds-cart__upsell-diff" aria-hidden="true">+{{ price_diff | money }}</span>
              </button>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </form>
  {%- endif -%}
</div>

{%- comment -%}
  The click handler + re-open-drawer logic for [data-ds-cart-upsell]
  live in sections/ds-header.liquid — they MUST be in the initial
  document parse so the listener attaches even when the cart starts
  empty. Inline scripts that arrive later via cart morphing don't
  re-execute in browsers, so keeping the script here would mean
  clicks on upsell buttons silently no-op for anyone whose cart was
  empty on page load (i.e., the exact case the user reported).
{%- endcomment -%}
