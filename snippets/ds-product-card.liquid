{%- comment -%}
  snippets/ds-product-card.liquid — Disrupted Studio product card (.pcard)

  The single card used everywhere: homepage shop-by tabs, collection pages,
  search results, and PDP "you may also like". Matches the homepage design —
  a square image tile with the badge top-left and the name + "$price · TYPE"
  overlaid on a bottom scrim. The whole tile is one link.

  Required parameters
    product     — a Shopify product object

  Optional parameters
    label       — category text after the price (e.g. "Font"). Defaults to
                  product.type, then the first collection's title.
    ratio       — 'square' (default) or 'wide'. 'wide' renders the same card
                  at 3/2 instead of 1/1 — used by search results, where a
                  landscape tile reads better in a dropdown than a square.
    quick_add   — bool, default false. Renders a hover-revealed corner button
                  over the image: single-variant products AJAX-add (opens the
                  cart drawer), variant products link to the PDP.
    index       — 1-based position. The first 3 load eager/high priority so a
                  card image can be the LCP element without a lazy delay.

  Structure note
    Outer wrapper is <article>, NOT <a>: the quick-add <button> must be a
    sibling of the link, since a <button> inside an <a> is invalid HTML.

  Badge priority: FREE > BUNDLE > SALE > NEW.
    Bundles inherently have compare_at_price > price, so type == "Bundle" is
    checked before SALE to label the saving as BUNDLE rather than generic SALE.

  CSS lives in assets/ds-tokens.css (global) so every template gets it.
{%- endcomment -%}

{%- liquid
  if quick_add == nil
    assign quick_add = false
  endif

  assign card_class = 'pcard'
  if ratio == 'wide'
    assign card_class = 'pcard pcard--wide'
  endif

  assign category = label
  if category == blank
    assign category = product.type
  endif
  if category == blank
    assign category = product.collections.first.title
  endif

  assign badge_text = ''
  if product.price == 0
    assign badge_text = 'FREE'
  elsif product.type == 'Bundle'
    assign badge_text = 'BUNDLE'
  elsif product.compare_at_price > product.price
    assign badge_text = 'SALE'
  elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW'
    assign badge_text = 'NEW'
  endif

  assign current_variant = product.selected_or_first_available_variant

  assign img_loading = 'lazy'
  assign img_priority = 'auto'
  if index and index <= 3
    assign img_loading = 'eager'
    assign img_priority = 'high'
  endif
-%}

{%- if quick_add -%}
  {%- comment -%} Load the AJAX form component once per page when any card uses quick-add. {%- endcomment -%}
  <script src="{{ 'product-form.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

<article class="{{ card_class }}">
  <a href="{{ product.url }}" class="pcard__link">
    <div class="pcard__img">
      {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag:
              widths: '300,600,900',
              sizes: '(min-width: 900px) 25vw, 50vw',
              loading: img_loading,
              fetchpriority: img_priority,
              alt: product.title,
              class: 'pcard__photo'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pcard__photo' }}
      {%- endif -%}

      {%- if badge_text != blank -%}
        <span class="pcard__badge">[ {{ badge_text }} ]</span>
      {%- endif -%}

      <div class="pcard__scrim"></div>

      <div class="pcard__meta">
        <p class="pcard__name">{{ product.title }}</p>
        <div class="pcard__sub tnum">
          {%- if product.price == 0 -%}Free{%- else -%}{{ product.price | money_without_trailing_zeros }}{%- endif -%}
          {%- if category != blank %} &nbsp;&middot;&nbsp; {{ category | upcase }}{% endif -%}
        </div>
      </div>
    </div>
  </a>

  {%- comment -%} Quick add — sibling of the link, absolutely placed top-right (badge is top-left). {%- endcomment -%}
  {%- if quick_add and product.available -%}
    {%- if product.has_only_default_variant -%}
      <product-form-component
        class="pcard__quick-form"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
        data-skeleton-title="{{ product.title | escape }}"
        data-skeleton-image="{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 192 }}{%- endif -%}"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', product, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="pcard__quick pcard__quick--add"
            aria-label="Add {{ product.title | escape }} to cart"
          >
            <span aria-hidden="true">+</span>
          </button>
        {%- endform -%}
      </product-form-component>
    {%- else -%}
      <a
        href="{{ product.url }}"
        class="pcard__quick pcard__quick--options"
        aria-label="Choose options for {{ product.title | escape }}"
      >
        <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  {%- endif -%}
</article>
